    "product_faq": {
      "type": "cleo-faq",
      "blocks": {
        "faq_1": {
          "type": "question",
          "settings": {
            "question": "How does it work?",
            "answer": "<p>Copper naturally has antimicrobial properties that help keep water fresh. When water is stored in the bottle for a few hours, it absorbs trace benefits of copper.</p>",
            "open": false
          }
        },
        "faq_2": {
          "type": "question",
