      "settings": {
        "breadcrumb": ">  Wellness  >  Drinkware  |  Advertorial",
        "heading": "We Cut Open 9 “Amazon” Copper Bottles. What’s Actually Inside a $29 “Copper” Bottle.",
        "subhead": "Seven of the nine had something other than copper inside them. The other two lied about how they were made. Not one listing was accurate.",
        "byline": "By Ayan Decker ·  Lab analysis by CALIMP  ·  September 2026  ·  7 min read",
        "photo_fallback": "copper-bottles-cut-open-hero-photo.jpg",
        "caption": "All nine, bought online for $19–$39 from nine different sellers and sectioned on the same saw."
      }
