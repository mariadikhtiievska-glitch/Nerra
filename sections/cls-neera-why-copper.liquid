<div id="ClsNeeraWhyCopper-{{ section.id }}" class="cls-neera-why-copper">
  <div class="cls-neera-why-copper__inner">
    <div class="cls-neera-why-copper__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="cls-neera-why-copper__heading cls-neera-type-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.paragraph != blank -%}
        <div class="cls-neera-why-copper__paragraph cls-neera-type-body">{{ section.settings.paragraph }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="cls-neera-why-copper__features">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="cls-neera-why-copper__feature" {{ block.shopify_attributes }}>
                <span class="cls-neera-why-copper__feature-bar" aria-hidden="true"></span>
                <span class="cls-neera-why-copper__feature-text cls-neera-type-body">{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="cls-neera-why-copper__photo">
      {%- if section.settings.photo_image != blank -%}
        <img
          src="{{ section.settings.photo_image | image_url: width: 900 }}"
          srcset="{{ section.settings.photo_image | image_url: width: 450 }} 450w, {{ section.settings.photo_image | image_url: width: 900 }} 900w, {{ section.settings.photo_image | image_url: width: 1050 }} 1050w"
          sizes="(min-width: 768px) 560px, 100vw"
          alt="{{ section.settings.photo_image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <img
          src="{{ section.settings.photo_image_fallback | asset_url }}"
          srcset="{{ section.settings.photo_image_fallback | replace: '.jpg', '-450.jpg' | asset_url }} 450w, {{ section.settings.photo_image_fallback | replace: '.jpg', '-900.jpg' | asset_url }} 900w, {{ section.settings.photo_image_fallback | asset_url }} 1280w"
          sizes="(min-width: 768px) 560px, 100vw"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Neera why copper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why copper is a different kind of vessel"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Copper is one of the few metals with <strong>natural antimicrobial properties</strong> — a phenomenon known as the <strong>oligodynamic effect.</strong> When water rests in a pure copper vessel for several hours, it interacts with the surface. In <strong>Ayurveda</strong> this practice is called <strong>Tamra Jal.</strong> Modern research has confirmed copper’s ability to reduce certain bacteria in stored water. We do not claim miracles. We offer a thoughtfully made vessel that turns ordinary hydration into an intentional ritual free of plastic.</p>"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "photo_image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "photo_image_fallback",
      "label": "Photo fallback asset",
      "default": "neera-why-copper-photo.jpg"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature text"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Neera why copper",
      "blocks": [
        { "type": "feature", "settings": { "text": "99.9% pure copper, lab-tested after every manufacturing batch" } },
        { "type": "feature", "settings": { "text": "Hand-hammered exterior that increases contact area with water" } },
        { "type": "feature", "settings": { "text": "Naturally antimicrobial surface" } },
        { "type": "feature", "settings": { "text": "Zero plastic and zero microplastic risk" } }
      ]
    }
  ]
}
{% endschema %}
