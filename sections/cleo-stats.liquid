<section
  id="CleoStats-{{ section.id }}"
  class="cleo-stats-section"
  style="
    --stats-bg: {{ section.settings.background_color }};
    --stats-heading: {{ section.settings.heading_color }};
    --stats-text: {{ section.settings.text_color }};
    --stats-separator: {{ section.settings.separator_color }};
    --stats-width: {{ section.settings.max_width }}px;
    --stats-padding-top: {{ section.settings.padding_top }}px;
    --stats-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cleo-stats-section__container">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="cleo-stats-section__grid">
      {%- for block in section.blocks -%}
        <div class="cleo-stats-section__item" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.value }}</strong>
          <div>{{ block.settings.label | newline_to_br }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #CleoStats-{{ section.id }} {
    padding-block: var(--stats-padding-top) var(--stats-padding-bottom);
    background: var(--stats-bg);
    color: var(--stats-text);
  }

  #CleoStats-{{ section.id }} .cleo-stats-section__container {
    width: min(var(--stats-width), calc(100% - 40px));
    margin-inline: auto;
  }

  #CleoStats-{{ section.id }} h2 {
    margin: 0 0 34px;
    color: var(--stats-heading);
    font-size: 50px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  #CleoStats-{{ section.id }} .cleo-stats-section__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, minmax(0, 1fr));
    gap: 40px;
    text-align: center;
  }

  #CleoStats-{{ section.id }} .cleo-stats-section__item {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
  }

  #CleoStats-{{ section.id }} .cleo-stats-section__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -20px;
    width: 1px;
    height: 120px;
    background: var(--stats-separator);
    transform: translateY(-50%);
  }

  #CleoStats-{{ section.id }} strong {
    margin: 0 0 8px;
    color: var(--stats-heading);
    font-size: 40px;
    font-weight: 600;
    line-height: 1.2;
  }

  #CleoStats-{{ section.id }} .cleo-stats-section__item div {
    color: var(--stats-text);
    font-size: 20px;
    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    #CleoStats-{{ section.id }} {
      padding-block: 36px;
    }

    #CleoStats-{{ section.id }} .cleo-stats-section__container {
      width: calc(100% - 32px);
    }

    #CleoStats-{{ section.id }} h2 {
      margin-bottom: 24px;
      font-size: 32px;
    }

    #CleoStats-{{ section.id }} .cleo-stats-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    #CleoStats-{{ section.id }} .cleo-stats-section__item::after {
      display: none;
    }

    #CleoStats-{{ section.id }} .cleo-stats-section__item:nth-child(odd)::after {
      display: block;
      right: -10px;
      height: 80px;
    }

    #CleoStats-{{ section.id }} strong {
      font-size: 26px;
    }

    #CleoStats-{{ section.id }} .cleo-stats-section__item div {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Cleo stats",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted Globally" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3e9dc" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#895737" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2a2520" },
    { "type": "color", "id": "separator_color", "label": "Separator color", "default": "#e3d3c2" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 760, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "100,000 +" },
        { "type": "textarea", "id": "label", "label": "Label", "default": "Customers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cleo stats",
      "blocks": [
        { "type": "stat", "settings": { "value": "100,000 +", "label": "Customers" } },
        { "type": "stat", "settings": { "value": "10 +", "label": "Countries Reached" } },
        { "type": "stat", "settings": { "value": "400,000 +", "label": "Products Sold" } },
        { "type": "stat", "settings": { "value": "4.8/5", "label": "Rating across Website and other Marketplaces" } }
      ]
    }
  ]
}
{% endschema %}
