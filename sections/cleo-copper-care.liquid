{% comment %}
  Cleo Copper Care
  Separate responsive heading + care infographic image section.
{% endcomment %}

{% assign care_loading = 'lazy' %}
{% if section.settings.eager_load %}
  {% assign care_loading = 'eager' %}
{% endif %}

<section
  class="cleo-copper-care"
  style="
    --cleo-care-bg: {{ section.settings.background_color }};
    --cleo-care-heading: {{ section.settings.heading_color }};
    --cleo-care-max-width: {{ section.settings.max_width }}px;
    --cleo-care-heading-size: {{ section.settings.heading_size }}px;
    --cleo-care-heading-weight: {{ section.settings.heading_weight }};
    --cleo-care-gap: {{ section.settings.heading_gap }}px;
    --cleo-care-top: {{ section.settings.padding_top }}px;
    --cleo-care-bottom: {{ section.settings.padding_bottom }}px;
    --cleo-care-side: {{ section.settings.side_padding }}px;
  "
>
  <div class="cleo-copper-care__container">
    {% if section.settings.heading != blank %}
      <h2 class="cleo-copper-care__heading {{ section.settings.heading_alignment }}">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="cleo-copper-care__media">
      {% if section.settings.desktop_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.mobile_image | image_url: width: 375 }} 375w,
                {{ section.settings.mobile_image | image_url: width: 550 }} 550w,
                {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
                {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w,
                {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
            >
          {% endif %}

          {{
            section.settings.desktop_image
            | image_url: width: 2400
            | image_tag:
              class: 'cleo-copper-care__image',
              widths: '750, 1000, 1200, 1500, 1800, 2100, 2400',
              sizes: '(min-width: 1440px) 1348px, calc(100vw - 48px)',
              loading: care_loading,
              alt: section.settings.image_alt
          }}
        </picture>
      {% else %}
        <div class="cleo-copper-care__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .cleo-copper-care {
    width: 100%;
    background: var(--cleo-care-bg);
    padding: var(--cleo-care-top) var(--cleo-care-side) var(--cleo-care-bottom);
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__container {
    width: 100%;
    max-width: var(--cleo-care-max-width);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__heading {
    margin: 0 0 var(--cleo-care-gap);
    color: var(--cleo-care-heading);
    font-size: var(--cleo-care-heading-size);
    font-weight: var(--cleo-care-heading-weight);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__heading.left {
    text-align: left;
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__heading.center {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__heading.right {
    text-align: right;
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__media,
  #shopify-section-{{ section.id }} .cleo-copper-care__media picture {
    display: block;
    width: 100%;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__image {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__placeholder {
    width: 100%;
    aspect-ratio: 2400 / 999;
    background: #fffaf4;
  }

  #shopify-section-{{ section.id }} .cleo-copper-care__placeholder svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cleo-copper-care {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_side_padding }}px;
    }

    #shopify-section-{{ section.id }} .cleo-copper-care__heading {
      margin-bottom: {{ section.settings.mobile_heading_gap }}px;
      font-size: {{ section.settings.mobile_heading_size }}px;
      letter-spacing: -0.02em;
    }
  }
</style>

{% schema %}
{
  "name": "Cleo copper care",
  "tag": "section",
  "class": "section-cleo-copper-care",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Steps To Clean Your Cleo Copper Drinkware"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop infographic"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile infographic",
      "info": "Optional. Desktop image is used when this is empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Copper drinkware cleaning instructions"
    },
    {
      "type": "checkbox",
      "id": "eager_load",
      "label": "Load image immediately",
      "default": false,
      "info": "Enable only when the section is near the top of the page."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3E9DC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#895737"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 1200,
      "max": 1500,
      "step": 4,
      "unit": "px",
      "default": 1348
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "800",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ]
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_heading_gap",
      "label": "Mobile space below heading",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Mobile side spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Cleo copper care"
    }
  ]
}
{% endschema %}
