                    </details>
                  </accordion-disclosure>
                </div>
              {%- endif -%}

              {%- if accordion_block_count > 0 -%}
                <div class="accordion-list cleo-product-description">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'accordion' -%}
                      <accordion-disclosure class="accordion custom-faq-accordion" {{ block.shopify_attributes }}>
                        <details class="accordion__disclosure group"{% if block.settings.open %} open{% endif %}>
                          <summary>
                            <span class="accordion__toggle h6 custom-accordion-css">
                              <span class="text-with-icon gap-4">{{ block.settings.heading }}</span>
                              <svg aria-hidden="true" focusable="false" fill="none" width="10" class="group-expanded:rotate icon icon-chevron-down" viewBox="0 0 10 10">
                                <path d="m1 3 4 4 4-4" stroke="currentColor" stroke-linecap="square"/>
                              </svg>
                            </span>
                          </summary>
                          <div class="accordion__content custom-accordion-css rte">{{ block.settings.content }}</div>
                        </details>
                      </accordion-disclosure>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%} {% endcomment %}
            </div>
          </safe-sticky>
        </div>
      </product-rerender>
    </div>
  </div>

  {%- if section.settings.show_sticky_add_to_cart -%}
    <product-rerender
      id="{{ product_form_id }}-sticky-bar"
      observe-form="{{ product_form_id }}"
      data-cleo-sticky-wrapper
    >
      <product-sticky-bar
        form="{{ product_form_id }}"
        class="product-sticky-bar"
        data-cleo-sticky-bar
        aria-hidden="true"
      >
        <div class="product-sticky-bar__info sm-max:hidden">
          <div class="h-stack gap-6">
            {%- if product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  widths: '60, 120, 180',
                  sizes: '60px',
                  alt: product.title
              }}
            {%- endif -%}

            <div class="v-stack">
              <span class="h6 product-sticky-bar-title" data-cleo-sticky-title>{{ product.title }}</span>
              <price-list class="price-list">
                <div class="product-page-custom-price-container">
                  <div>
                    <sale-price class="h6 text-subdued product-page-custom-price" data-cleo-sticky-price>
                      <span class="sr-only">Sale price</span>{{ current_variant.price | money }}
                    </sale-price>
                  </div>
                </div>
              </price-list>
            </div>
          </div>
        </div>

        <buy-buttons class="buy-buttons" template="layout-b" form="{{ product_form_id }}">
          <button
            type="submit"
            class="button"
            form="{{ product_form_id }}"
            data-cleo-sticky-submit
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-cleo-sticky-submit-text>{%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}</span>
          </button>
        </buy-buttons>
      </product-sticky-bar>
    </product-rerender>
  {%- endif -%}
</section>


<template data-cleo-mobile-gallery-template="{{ section.id }}">
  <div class="cleo-mobile-product-gallery" data-cleo-mobile-product-gallery>
    <div class="cleo-mobile-product-gallery__viewport" data-cleo-mobile-gallery-viewport>
      {%- for image in product.images -%}
        <div
          class="cleo-mobile-product-gallery__slide"
          data-cleo-mobile-gallery-slide
          data-image-id="{{ image.id }}"
        >
          <img
            src="{{ image | image_url: width: 1200 }}"
            srcset="
              {{ image | image_url: width: 360 }} 360w,
              {{ image | image_url: width: 540 }} 540w,
              {{ image | image_url: width: 720 }} 720w,
              {{ image | image_url: width: 900 }} 900w,
              {{ image | image_url: width: 1200 }} 1200w
            "
            sizes="calc(100vw - 24px)"
            width="{{ image.width }}"
            height="{{ image.height }}"
            alt="{{ image.alt | default: product.title | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            {% if forloop.first %}fetchpriority="high"{% endif %}
          >
        </div>
      {%- endfor -%}
    </div>

    {%- if product.images.size > 1 -%}
      <div class="cleo-mobile-product-gallery__thumbs" data-cleo-mobile-gallery-thumbs>
        {%- for image in product.images -%}
          <button
            type="button"
            class="cleo-mobile-product-gallery__thumb"
            data-cleo-mobile-gallery-thumb="{{ forloop.index0 }}"
            aria-label="Show product image {{ forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <img
              src="{{ image | image_url: width: 180 }}"
              width="90"
              height="90"
              alt="{{ image.alt | default: product.title | escape }}"
              loading="lazy"
            >
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</template>

<script type="application/json" data-cleo-product-variants="{{ section.id }}">
[
  {%- for variant in product.variants -%}
    {
      "id": {{ variant.id | json }},
      "available": {{ variant.available | json }},
      "price": {{ variant.price | json }},
      "price_formatted": {{ variant.price | money | json }},
      "inventory_quantity": {{ variant.inventory_quantity | default: 0 | json }},
      "inventory_management": {{ variant.inventory_management | json }},
      "inventory_policy": {{ variant.inventory_policy | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

<script>
  (() => {
    'use strict';

    const sectionId = {{ section.id | json }};
    const productFormId = {{ product_form_id | json }};
    const productTitle = {{ product.title | json }};
    const featuredImageUrl = {% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %};
    const root = document.getElementById(`shopify-section-${sectionId}`);

    if (!root || root.dataset.cleoProductEnhanced === 'true') return;
    root.dataset.cleoProductEnhanced = 'true';

    const config = {
      showStockUrgency: {{ section.settings.show_stock_urgency | json }},
      lowStockThreshold: {{ section.settings.stock_low_threshold | json }},
      lowStockText: {{ section.settings.stock_low_text | json }},
      inStockText: {{ section.settings.stock_in_stock_text | json }},
      preorderText: {{ section.settings.stock_preorder_text | json }},
      outOfStockText: {{ section.settings.stock_out_text | json }},
      autoOpenCartDrawer: {{ section.settings.auto_open_cart_drawer | json }},
      loadingText: {{ section.settings.atc_loading_text | json }},
      addedText: {{ section.settings.atc_added_text | json }}
    };

    const variantDataElement = root.querySelector(`[data-cleo-product-variants="${sectionId}"]`);
    let variants = [];

    try {
      variants = JSON.parse(variantDataElement?.textContent || '[]');
    } catch (error) {
      console.warn('[Cleo product] Variant inventory JSON could not be parsed.', error);
    }

    const variantsById = new Map(variants.map((variant) => [String(variant.id), variant]));
    const productFormsSelector = 'form[action*="/cart/add"]';
    const getAjaxForms = () => Array.from(root.querySelectorAll(productFormsSelector));
    let variantUpdateTimer = null;
    let stickyVisibilityFrame = null;

    const getStickyBar = () => root.querySelector('[data-cleo-sticky-bar]');
    const getStickySubmitButton = () => root.querySelector('[data-cleo-sticky-submit]');
    const getMainAddToCartButton = () => {
      const productForm = document.getElementById(productFormId);
      return productForm?.querySelector('.cleo-product-atc, [type="submit"]:not([name="checkout"])') || null;
    };

    const setStickyBarVisibility = (shouldShow) => {
      const stickyBar = getStickyBar();
      if (!stickyBar) return;

      const visible = Boolean(shouldShow);
      stickyBar.classList.toggle('is-visible', visible);
      stickyBar.classList.toggle('cleo-is-visible', visible);
      stickyBar.setAttribute('aria-hidden', visible ? 'false' : 'true');
    };

    const updateStickyBarVisibility = () => {
      stickyVisibilityFrame = null;

      const stickyBar = getStickyBar();
      const mainButton = getMainAddToCartButton();

      if (!stickyBar || !mainButton) {
        setStickyBarVisibility(false);
        return;
      }

      const buttonStyle = window.getComputedStyle(mainButton);
      const buttonRect = mainButton.getBoundingClientRect();
      const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      const viewportWidth = window.innerWidth || document.documentElement.clientWidth;
      const hasSize = buttonRect.width > 0 && buttonRect.height > 0;
      const isRendered = buttonStyle.display !== 'none'
        && buttonStyle.visibility !== 'hidden'
        && buttonStyle.opacity !== '0';
      const isInsideViewport = buttonRect.bottom > 0
        && buttonRect.top < viewportHeight
        && buttonRect.right > 0
        && buttonRect.left < viewportWidth;

      setStickyBarVisibility(!(hasSize && isRendered && isInsideViewport));
    };

    const scheduleStickyBarVisibilityUpdate = () => {
      if (stickyVisibilityFrame) return;
      stickyVisibilityFrame = window.requestAnimationFrame(updateStickyBarVisibility);
    };

    const getVariantIdFromForm = (form) => {
      const idInput = form?.querySelector('[name="id"]');
      return idInput?.value ? String(idInput.value) : null;
    };

    const getCurrentVariantId = (preferredForm = null, eventVariant = null) => {
      const eventVariantId = eventVariant?.id || eventVariant?.variant?.id || eventVariant?.detail?.variant?.id;
      if (eventVariantId) return String(eventVariantId);

      const preferredId = getVariantIdFromForm(preferredForm);
      if (preferredId) return preferredId;

      for (const form of getAjaxForms()) {
        const formId = getVariantIdFromForm(form);
        if (formId) return formId;
      }

      const urlVariantId = new URL(window.location.href).searchParams.get('variant');
      if (urlVariantId) return String(urlVariantId);

      const firstAvailable = variants.find((variant) => variant.available);
      return firstAvailable ? String(firstAvailable.id) : (variants[0] ? String(variants[0].id) : null);
    };

    const findOrCreateStockBlock = () => {
      let block = root.querySelector('[data-cleo-stock-urgency], .stock-urgency-block');

      if (!block) {
        block = document.createElement('div');
        block.className = 'stock-urgency-block';
        block.dataset.cleoStockUrgency = '';
        block.setAttribute('role', 'status');
        block.setAttribute('aria-live', 'polite');
        block.innerHTML = '<span class="stock-urgency-dot" aria-hidden="true"></span><span class="stock-urgency-text"></span>';

        const insertionTarget = root.querySelector('.cleo-product-actions')
          || root.querySelector(`${productFormsSelector} [type="submit"]`)
          || root.querySelector(productFormsSelector);

        if (insertionTarget) {
          insertionTarget.insertAdjacentElement('beforebegin', block);
        }
      }

      if (block) {
        block.dataset.cleoStockUrgency = '';
        block.setAttribute('role', 'status');
        block.setAttribute('aria-live', 'polite');

        if (!block.querySelector('.stock-urgency-dot')) {
          const dot = document.createElement('span');
          dot.className = 'stock-urgency-dot';
          dot.setAttribute('aria-hidden', 'true');
          block.prepend(dot);
        }

        if (!block.querySelector('.stock-urgency-text')) {
          const text = document.createElement('span');
          text.className = 'stock-urgency-text';
          block.append(text);
        }
      }

      return block;
    };

    const formatStockText = (template, quantity) => String(template || '')
      .replace(/\[quantity\]/gi, String(Math.max(0, Number(quantity) || 0)))
      .replace(/\{quantity\}/gi, String(Math.max(0, Number(quantity) || 0)));

    const getStockState = (variant) => {
      if (!variant) {
        return { state: 'unknown', text: '', buttonDisabled: false };
      }

      const tracked = Boolean(variant.inventory_management);
      const quantity = Number(variant.inventory_quantity) || 0;
      const allowsOverselling = variant.inventory_policy === 'continue';

      if (!variant.available && !allowsOverselling) {
        return {
          state: 'out-of-stock',
          text: config.outOfStockText,
          buttonDisabled: true
        };
      }

      if (tracked && quantity <= 0 && allowsOverselling) {
        return {
          state: 'preorder',
          text: config.preorderText,
          buttonDisabled: false
        };
      }

      if (tracked && quantity > 0 && quantity <= Number(config.lowStockThreshold || 0)) {
        return {
          state: 'low-stock',
          text: formatStockText(config.lowStockText, quantity),
          buttonDisabled: false
        };
      }

      return {
        state: 'in-stock',
        text: config.inStockText,
        buttonDisabled: false
      };
    };

    const syncStickyBarState = (variant, state) => {
      const stickyButton = getStickySubmitButton();
      const stickyPrice = root.querySelector('[data-cleo-sticky-price]');

      if (
        stickyPrice
        && variant?.price_formatted
        && stickyPrice.dataset.cleoCurrentPrice !== variant.price_formatted
      ) {
        const screenReaderLabel = stickyPrice.querySelector('.sr-only');
        const prefix = screenReaderLabel ? screenReaderLabel.outerHTML : '';
        stickyPrice.innerHTML = `${prefix}${variant.price_formatted}`;
        stickyPrice.dataset.cleoCurrentPrice = variant.price_formatted;
      }

      if (!stickyButton || stickyButton.getAttribute('aria-busy') === 'true') return;

      const shouldDisable = Boolean(state?.buttonDisabled);
      const stickyLabel = stickyButton.querySelector('[data-cleo-sticky-submit-text]');

      if (stickyButton.disabled !== shouldDisable) stickyButton.disabled = shouldDisable;
      stickyButton.setAttribute('aria-disabled', shouldDisable ? 'true' : 'false');
      stickyButton.dataset.cleoSoldOut = shouldDisable ? 'true' : 'false';

      if (stickyLabel) {
        stickyLabel.textContent = shouldDisable ? 'Sold out' : 'Add to cart';
      }
    };

    const setFormAvailability = (variant, state) => {
      getAjaxForms().forEach((form) => {
        const formVariantId = getVariantIdFromForm(form);
        if (formVariantId && String(formVariantId) !== String(variant?.id || '')) return;

        form.querySelectorAll('[type="submit"]:not([name="checkout"])').forEach((button) => {
          if (button.getAttribute('aria-busy') === 'true') return;

          const shouldDisable = Boolean(state.buttonDisabled);
          if (button.disabled !== shouldDisable) button.disabled = shouldDisable;
          button.setAttribute('aria-disabled', shouldDisable ? 'true' : 'false');
          button.dataset.cleoSoldOut = shouldDisable ? 'true' : 'false';
        });
      });

      syncStickyBarState(variant, state);
    };

    const updateStockUrgency = (preferredForm = null, eventVariant = null) => {
      const variantId = getCurrentVariantId(preferredForm, eventVariant);
      if (!variantId) return;

      const variant = variantsById.get(String(variantId));
      const stockState = getStockState(variant);
      const existingBlock = root.querySelector('[data-cleo-stock-urgency], .stock-urgency-block');

      if (!config.showStockUrgency) {
        if (existingBlock) existingBlock.hidden = true;
      } else {
        const block = existingBlock || findOrCreateStockBlock();

        if (block) {
          const textElement = block.querySelector('.stock-urgency-text');
          block.hidden = !stockState.text;
          block.dataset.stockState = stockState.state;

          if (textElement && textElement.textContent !== stockState.text) {
            textElement.textContent = stockState.text;
          }
        }
      }

      setFormAvailability(variant, stockState);
      scheduleStickyBarVisibilityUpdate();
    };

    const scheduleStockUpdate = (preferredForm = null, eventVariant = null) => {
      window.clearTimeout(variantUpdateTimer);
      variantUpdateTimer = window.setTimeout(() => {
        updateStockUrgency(preferredForm, eventVariant);
      }, 30);
    };

    const getCartSectionHandles = () => {
      const candidates = [
        ['cart-drawer', 'cart-drawer, #CartDrawer, .cart-drawer'],
        ['cart-icon-bubble', '#cart-icon-bubble, [data-cart-icon-bubble], .header__icon--cart'],
        ['cart-live-region-text', '#cart-live-region-text, [data-cart-live-region]'],
        ['cart-notification-product', '#cart-notification-product, cart-notification'],
        ['cart-notification-button', '#cart-notification-button, [data-cart-notification-button]']
      ];

      const presentHandles = candidates
        .filter(([, selector]) => document.querySelector(selector))
        .map(([handle]) => handle);

      const handles = ['cart-drawer', 'cart-icon-bubble', ...presentHandles];
      return [...new Set(handles)].slice(0, 5);
    };

    const getSectionSelectorCandidates = (sectionHandle) => {
      const selectors = {
        'cart-drawer': ['#CartDrawer', 'cart-drawer', '.cart-drawer'],
        'cart-icon-bubble': ['#cart-icon-bubble', '[data-cart-icon-bubble]', '.header__icon--cart'],
        'cart-live-region-text': ['#cart-live-region-text', '[data-cart-live-region]'],
        'cart-notification-product': ['#cart-notification-product', 'cart-notification'],
        'cart-notification-button': ['#cart-notification-button', '[data-cart-notification-button]']
      };

      return [
        `#shopify-section-${sectionHandle}`,
        `[id^="shopify-section-"][id$="__${sectionHandle}"]`,
        ...(selectors[sectionHandle] || [])
      ];
    };

    const replaceRenderedSection = (sectionHandle, html) => {
      if (!html) return false;

      const parsedDocument = new DOMParser().parseFromString(html, 'text/html');
      const selectorCandidates = getSectionSelectorCandidates(sectionHandle);

      for (const selector of selectorCandidates) {
        const currentElement = document.querySelector(selector);
        const incomingElement = parsedDocument.querySelector(selector);

        if (!currentElement || !incomingElement) continue;

        const isDrawerElement = currentElement.matches('cart-drawer, #CartDrawer, .cart-drawer');
        const isShopifySection = currentElement.id?.startsWith('shopify-section-');

        if (isDrawerElement || isShopifySection) {
          currentElement.innerHTML = incomingElement.innerHTML;
        } else {
          currentElement.replaceWith(incomingElement.cloneNode(true));
        }

        return true;
      }

      return false;
    };

    const renderCartSectionsFallback = (response) => {
      let renderedAnySection = false;

      Object.entries(response?.sections || {}).forEach(([sectionHandle, html]) => {
        renderedAnySection = replaceRenderedSection(sectionHandle, html) || renderedAnySection;
      });

      return renderedAnySection;
    };

    const renderCartWithThemeApi = (response) => {
      const renderers = [
        document.querySelector('cart-drawer'),
        document.querySelector('cart-notification'),
        document.querySelector('[data-cart-drawer]')
      ].filter(Boolean);

      for (const renderer of renderers) {
        if (typeof renderer.renderContents !== 'function') continue;

        try {
          renderer.renderContents(response);
          return true;
        } catch (error) {
          console.warn('[Cleo product] Theme cart renderer failed, using generic fallback.', error);
        }
      }

      return false;
    };

    const openCartDrawer = () => {
      if (config.autoOpenCartDrawer === false) return;

      if (window.CleoCart && typeof window.CleoCart.open === 'function') {
        window.CleoCart.open();
        return;
      }

      const drawer = document.querySelector('cart-drawer, #CartDrawer, [data-cart-drawer], .cart-drawer');
      const notification = document.querySelector('cart-notification');

      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
        return;
      }

      if (notification && typeof notification.open === 'function') {
        notification.open();
        return;
      }

      const dialog = drawer?.matches('dialog') ? drawer : drawer?.querySelector('dialog');
      if (dialog && typeof dialog.showModal === 'function' && !dialog.open) {
        dialog.showModal();
        return;
      }

      if (drawer) {
        drawer.hidden = false;
        drawer.removeAttribute('aria-hidden');
        drawer.setAttribute('aria-hidden', 'false');
        drawer.setAttribute('open', '');
        drawer.classList.add('active', 'is-open', 'open');
        document.documentElement.classList.add('overflow-hidden', 'cleo-cart-drawer-open');
      }
    };

    const refreshCartDrawer = async () => {
      if (window.CleoCart && typeof window.CleoCart.refresh === 'function') {
        return window.CleoCart.refresh();
      }

      document.dispatchEvent(new CustomEvent('cart:refresh', {
        bubbles: true,
        detail: { source: 'cleo-product-form' }
      }));
      return null;
    };

    const dispatchCartEvents = (response, formData, cart = null) => {
      const detail = {
        source: 'cleo-product-form',
        productVariantId: String(formData.get('id') || ''),
        cart,
        cartData: cart || response,
        addResponse: response,
        sections: response?.sections || {}
      };

      ['cart:updated', 'cart:change', 'cart:refresh', 'product:added'].forEach((eventName) => {
        document.dispatchEvent(new CustomEvent(eventName, { bubbles: true, detail }));
      });
    };

    const getAtcMessageElement = (form) => {
      let message = form.querySelector('[data-cleo-atc-message]');

      if (!message) {
        message = document.createElement('div');
        message.className = 'cleo-atc-message';
        message.dataset.cleoAtcMessage = '';
        message.setAttribute('role', 'alert');
        message.hidden = true;
        form.appendChild(message);
      }

      return message;
    };

    const setAtcMessage = (form, messageText, type = 'error') => {
      const message = getAtcMessageElement(form);
      message.textContent = messageText || '';
      message.dataset.messageType = type;
      message.hidden = !messageText;
    };

    const getButtonLabelElement = (button) => button?.querySelector(
      '[data-add-to-cart-text], .atc-btn-content, .button__text, span'
    ) || button;

    const setButtonLoading = (button, isLoading) => {
      if (!button) return;

      const label = getButtonLabelElement(button);

      if (isLoading) {
        if (!button.dataset.cleoOriginalDisabled) {
          button.dataset.cleoOriginalDisabled = button.disabled ? 'true' : 'false';
        }
        if (label && !label.dataset.cleoOriginalHtml) {
          label.dataset.cleoOriginalHtml = label.innerHTML;
        }

        button.disabled = true;
        button.setAttribute('aria-disabled', 'true');
        button.setAttribute('aria-busy', 'true');
        button.classList.add('is-loading');
        if (label) label.textContent = config.loadingText || 'Adding...';
        return;
      }

      button.removeAttribute('aria-busy');
      button.classList.remove('is-loading');
    };

    const restoreButton = (button, showSuccess = false) => {
      if (!button) return;

      const label = getButtonLabelElement(button);
      const originalHtml = label?.dataset.cleoOriginalHtml;

      if (showSuccess && label) {
        label.textContent = config.addedText || 'Added to cart';
      }

      window.setTimeout(() => {
        if (label && originalHtml !== undefined) {
          label.innerHTML = originalHtml;
          delete label.dataset.cleoOriginalHtml;
        }

        const wasOriginallyDisabled = button.dataset.cleoOriginalDisabled === 'true';
        button.disabled = wasOriginallyDisabled;
        button.setAttribute('aria-disabled', wasOriginallyDisabled ? 'true' : 'false');
        delete button.dataset.cleoOriginalDisabled;
        updateStockUrgency();
      }, showSuccess ? 900 : 0);
    };

    const parseJsonResponse = async (response) => {
      const contentType = response.headers.get('content-type') || '';
      if (contentType.includes('application/json')) return response.json();

      const text = await response.text();
      try {
        return JSON.parse(text);
      } catch (_) {
        return { description: text || 'Unable to add this item to the cart.' };
      }
    };

    const submitProductForm = async (form, submitter) => {
      const formData = new FormData(form);
      const variantId = formData.get('id');
      const variant = variantsById.get(String(variantId || ''));

      if (!variantId) {
        setAtcMessage(form, 'Please select a product option before adding to cart.');
        return;
      }

      if (variant && !variant.available && variant.inventory_policy !== 'continue') {
        setAtcMessage(form, config.outOfStockText);
        updateStockUrgency(form);
        return;
      }

      const cartSectionHandles = getCartSectionHandles();
      formData.set('sections', cartSectionHandles.join(','));
      formData.set('sections_url', `${window.location.pathname}${window.location.search}`);

      setAtcMessage(form, '');
      setButtonLoading(submitter, true);

      try {
        const shopifyRoot = window.Shopify?.routes?.root || '/';
        const response = await fetch(`${shopifyRoot}cart/add.js`, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: formData,
          credentials: 'same-origin'
        });

        const responseData = await parseJsonResponse(response);

        if (!response.ok || responseData?.status) {
          throw new Error(
            responseData?.description
            || responseData?.message
            || 'This item could not be added to the cart.'
          );
        }

        const usesCleoCartDrawer = Boolean(document.querySelector('cart-drawer#cart-drawer [data-cleo-cart-drawer-content]'));
        if (!usesCleoCartDrawer) {
          const renderedByTheme = renderCartWithThemeApi(responseData);
          if (!renderedByTheme) renderCartSectionsFallback(responseData);
        }

        openCartDrawer();
        const cart = await refreshCartDrawer();
        dispatchCartEvents(responseData, formData, cart);
        setAtcMessage(form, '');
        setButtonLoading(submitter, false);
        restoreButton(submitter, true);

        window.requestAnimationFrame(() => {
          updateStockUrgency(form);
        });
      } catch (error) {
        console.error('[Cleo product] Add to cart failed.', error);
        setAtcMessage(form, error.message || 'Unable to add this item to the cart.');
        setButtonLoading(submitter, false);
        restoreButton(submitter, false);
      }
    };

    root.addEventListener('submit', (event) => {
      const form = event.target.closest(productFormsSelector);
      if (!form || !root.contains(form) || form.hasAttribute('data-cleo-native-cart')) return;

      const submitter = event.submitter || form.querySelector('[type="submit"]:not([name="checkout"])');
      const isCheckoutButton = submitter?.name === 'checkout'
        || submitter?.closest('.shopify-payment-button, shopify-accelerated-checkout');

      if (isCheckoutButton) return;

      event.preventDefault();
      event.stopImmediatePropagation();
      submitProductForm(form, submitter);
    }, true);

    root.addEventListener('change', (event) => {
      const form = event.target.closest(productFormsSelector);
      if (
        event.target.matches('select, input[type="radio"], input[name="id"], input[name^="options"]')
        || event.target.closest('.cleo-option, variant-selects, variant-radios')
      ) {
        scheduleStockUpdate(form);
        window.setTimeout(() => scheduleStockUpdate(form), 100);
      }
    });

    root.addEventListener('input', (event) => {
      if (event.target.matches('select, input[type="radio"], input[name="id"]')) {
        scheduleStockUpdate(event.target.closest(productFormsSelector));
      }
    });

    ['variant:change', 'variant-changed', 'product:variant-change', 'product:variant-changed'].forEach((eventName) => {
      document.addEventListener(eventName, (event) => {
        const variant = event.detail?.variant || event.detail;
        scheduleStockUpdate(null, variant);
      });
    });

    const productMutationObserver = new MutationObserver((mutations) => {
      const relevantMutation = mutations.some((mutation) =>
        mutation.type === 'childList'
        || (mutation.type === 'attributes' && ['value', 'checked', 'disabled'].includes(mutation.attributeName))
      );

      if (relevantMutation) {
        scheduleStockUpdate();
        scheduleStickyBarVisibilityUpdate();
      }
    });

    productMutationObserver.observe(root, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['value', 'checked', 'disabled']
    });

    const getLazyAttribute = (element, names) => {
      for (const name of names) {
        const value = element?.getAttribute(name);
        if (value) return value;
      }
      return '';
    };

    const hydrateMobileImage = (image, isFirstImage = false) => {
      if (!image) return;

      const lazySrc = getLazyAttribute(image, [
        'data-src',
        'data-lazy-src',
        'data-original',
        'data-image-src'
      ]);
      const lazySrcset = getLazyAttribute(image, [
        'data-srcset',
        'data-lazy-srcset'
      ]);
      const lazySizes = getLazyAttribute(image, ['data-sizes']);
      const currentSrc = image.getAttribute('src') || '';
      const hasPlaceholderSource = !currentSrc
        || currentSrc === '#'
        || currentSrc.startsWith('data:image/gif')
        || currentSrc.startsWith('data:image/svg+xml');

      if (hasPlaceholderSource && lazySrc) image.setAttribute('src', lazySrc);
      if (!image.getAttribute('srcset') && lazySrcset) image.setAttribute('srcset', lazySrcset);
      if (!image.getAttribute('sizes') && lazySizes) image.setAttribute('sizes', lazySizes);

      image.hidden = false;
      image.removeAttribute('hidden');
      image.removeAttribute('aria-hidden');
      image.classList.remove('lazyload', 'lazyloading');
      image.classList.add('lazyloaded', 'loaded');
      image.loading = isFirstImage ? 'eager' : 'lazy';

      if (isFirstImage) {
        image.setAttribute('fetchpriority', 'high');
      }

      if (featuredImageUrl && isFirstImage) {
        image.addEventListener('error', () => {
          if (image.dataset.cleoFallbackApplied === 'true') return;
          image.dataset.cleoFallbackApplied = 'true';
          image.removeAttribute('srcset');
          image.src = featuredImageUrl;
        }, { once: true });
      }
    };

    const ensureMobileGalleryVisible = () => {
      if (!window.matchMedia('(max-width: 699px)').matches) return;

      const gallery = root.querySelector('.cleo-product-gallery');
      const frame = gallery?.querySelector('.cleo-product-gallery__frame');
      const carousel = gallery?.querySelector('.product-gallery__carousel');

      if (!gallery || !frame) return;

      let mediaItems = Array.from(
        (carousel || frame).querySelectorAll('.product-gallery__media')
      );

      if (!mediaItems.length && featuredImageUrl) {
        const fallbackCarousel = carousel || document.createElement('div');
        const fallbackMedia = document.createElement('div');
        const fallbackImage = document.createElement('img');

        if (!carousel) {
          fallbackCarousel.className = 'product-gallery__carousel';
          frame.appendChild(fallbackCarousel);
        }

        fallbackMedia.className = 'product-gallery__media';
        fallbackMedia.dataset.cleoMobileGeneratedMedia = 'true';
        fallbackImage.className = 'cleo-mobile-gallery-fallback';
        fallbackImage.src = featuredImageUrl;
        fallbackImage.alt = productTitle || '';
        fallbackImage.loading = 'eager';
        fallbackImage.setAttribute('fetchpriority', 'high');
        fallbackMedia.appendChild(fallbackImage);
        fallbackCarousel.appendChild(fallbackMedia);
        mediaItems = [fallbackMedia];
      }

      mediaItems.forEach((media, mediaIndex) => {
        media.hidden = false;
        media.removeAttribute('hidden');
        media.removeAttribute('inert');
        media.setAttribute('aria-hidden', 'false');

        media.querySelectorAll('[hidden]').forEach((element) => {
          if (element.matches('script, template')) return;
          element.hidden = false;
          element.removeAttribute('hidden');
        });

        media.querySelectorAll('source').forEach((source) => {
          const lazySrcset = getLazyAttribute(source, ['data-srcset', 'data-lazy-srcset']);
          if (!source.getAttribute('srcset') && lazySrcset) {
            source.setAttribute('srcset', lazySrcset);
          }
        });

        media.querySelectorAll('img').forEach((image, imageIndex) => {
          hydrateMobileImage(image, mediaIndex === 0 && imageIndex === 0);
        });
      });

      const firstMedia = mediaItems[0];
      let firstImage = firstMedia?.querySelector('img');

      if (firstMedia && !firstImage && featuredImageUrl) {
        firstImage = document.createElement('img');
        firstImage.className = 'cleo-mobile-gallery-fallback';
        firstImage.src = featuredImageUrl;
        firstImage.alt = productTitle || '';
        firstMedia.appendChild(firstImage);
        hydrateMobileImage(firstImage, true);
      }

      if (firstImage && featuredImageUrl) {
        const currentSrc = firstImage.currentSrc || firstImage.getAttribute('src') || '';
        if (!currentSrc || currentSrc === '#') {
          firstImage.src = featuredImageUrl;
        }

        window.setTimeout(() => {
          if (firstImage.complete && firstImage.naturalWidth === 0 && firstImage.dataset.cleoFallbackApplied !== 'true') {
            firstImage.dataset.cleoFallbackApplied = 'true';
            firstImage.removeAttribute('srcset');
            firstImage.src = featuredImageUrl;
          }
        }, 350);
      }

      const thumbnails = Array.from(gallery.querySelectorAll('.product-gallery__thumbnail'));
      if (thumbnails.length && !thumbnails.some((thumbnail) => thumbnail.getAttribute('aria-current') === 'true')) {
        thumbnails[0].setAttribute('aria-current', 'true');
      }

      if (carousel && !carousel.dataset.cleoMobilePositioned) {
        carousel.scrollLeft = 0;
        carousel.dataset.cleoMobilePositioned = 'true';
      }
    };

    const mobileGalleryTemplate = root.querySelector(
      `[data-cleo-mobile-gallery-template="${sectionId}"]`
    );
    let mobileGalleryScrollTimer = null;

    const updateMobileGalleryState = (mobileGallery, index, shouldScroll = false) => {
      if (!mobileGallery) return;

      const viewport = mobileGallery.querySelector('[data-cleo-mobile-gallery-viewport]');
      const slides = Array.from(mobileGallery.querySelectorAll('[data-cleo-mobile-gallery-slide]'));
      const thumbs = Array.from(mobileGallery.querySelectorAll('[data-cleo-mobile-gallery-thumb]'));

      if (!viewport || !slides.length) return;

      const safeIndex = Math.max(0, Math.min(Number(index) || 0, slides.length - 1));

      thumbs.forEach((thumb, thumbIndex) => {
        thumb.setAttribute('aria-current', thumbIndex === safeIndex ? 'true' : 'false');
      });

      if (shouldScroll) {
        const targetLeft = slides[safeIndex].offsetLeft;
        viewport.scrollTo({ left: targetLeft, behavior: 'smooth' });
      }

      const activeThumb = thumbs[safeIndex];
      const thumbsViewport = mobileGallery.querySelector('[data-cleo-mobile-gallery-thumbs]');

      /*
       * Do not use scrollIntoView() here. On iOS Safari, the browser toolbar
       * changes the viewport height while the customer scrolls vertically.
       * That resize used to run this function and scroll the whole page back
       * to the gallery. This calculation only moves the horizontal thumb row.
       */
      if (activeThumb && thumbsViewport) {
        const visibleLeft = thumbsViewport.scrollLeft;
        const visibleRight = visibleLeft + thumbsViewport.clientWidth;
        const thumbLeft = activeThumb.offsetLeft;
        const thumbRight = thumbLeft + activeThumb.offsetWidth;
        const thumbIsVisible = thumbLeft >= visibleLeft && thumbRight <= visibleRight;

        if (!thumbIsVisible) {
          const maxScrollLeft = Math.max(0, thumbsViewport.scrollWidth - thumbsViewport.clientWidth);
          const centeredLeft = thumbLeft - ((thumbsViewport.clientWidth - activeThumb.offsetWidth) / 2);
          const targetLeft = Math.max(0, Math.min(maxScrollLeft, centeredLeft));

          thumbsViewport.scrollTo({
            left: targetLeft,
            behavior: shouldScroll ? 'smooth' : 'auto'
          });
        }
      }
    };

    const bindMobileGallery = (mobileGallery) => {
      if (!mobileGallery || mobileGallery.dataset.cleoBound === 'true') return;
      mobileGallery.dataset.cleoBound = 'true';

      const viewport = mobileGallery.querySelector('[data-cleo-mobile-gallery-viewport]');
      const slides = Array.from(mobileGallery.querySelectorAll('[data-cleo-mobile-gallery-slide]'));
      const thumbs = Array.from(mobileGallery.querySelectorAll('[data-cleo-mobile-gallery-thumb]'));

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          updateMobileGalleryState(
            mobileGallery,
            Number(thumb.dataset.cleoMobileGalleryThumb || 0),
            true
          );
        });
      });

      viewport?.addEventListener('scroll', () => {
        window.clearTimeout(mobileGalleryScrollTimer);
        mobileGalleryScrollTimer = window.setTimeout(() => {
          const viewportWidth = viewport.clientWidth || 1;
          const activeIndex = Math.round(viewport.scrollLeft / viewportWidth);
          updateMobileGalleryState(mobileGallery, activeIndex, false);
        }, 70);
      }, { passive: true });

      slides.forEach((slide, index) => {
        const image = slide.querySelector('img');
        if (!image) return;

        image.hidden = false;
        image.removeAttribute('hidden');
        image.removeAttribute('aria-hidden');

        if (index === 0) {
          image.loading = 'eager';
          image.setAttribute('fetchpriority', 'high');
        }

        image.addEventListener('error', () => {
          if (!featuredImageUrl || image.dataset.cleoFallbackApplied === 'true') return;
          image.dataset.cleoFallbackApplied = 'true';
          image.removeAttribute('srcset');
          image.src = featuredImageUrl;
        }, { once: true });
      });

      updateMobileGalleryState(mobileGallery, 0, false);
    };

    const mountReliableMobileGallery = () => {
      const gallery = root.querySelector('.cleo-product-gallery');
      if (!gallery) return;

      const isMobile = window.matchMedia('(max-width: 699px)').matches;
      let mobileGallery = gallery.querySelector('[data-cleo-mobile-product-gallery]');
      const wasAlreadyMounted = Boolean(
        mobileGallery && gallery.classList.contains('is-mobile-gallery-mounted')
      );

      if (!isMobile) {
        mobileGallery?.remove();
        gallery.classList.remove('is-mobile-gallery-mounted');
        return;
      }

      if (!mobileGallery && mobileGalleryTemplate?.content) {
        const fragment = mobileGalleryTemplate.content.cloneNode(true);
        gallery.insertBefore(fragment, gallery.firstChild);
        mobileGallery = gallery.querySelector('[data-cleo-mobile-product-gallery]');
      }

      const mobileSlides = mobileGallery
        ? mobileGallery.querySelectorAll('[data-cleo-mobile-gallery-slide]')
        : [];

      if (!mobileGallery || !mobileSlides.length) {
        mobileGallery?.remove();
        gallery.classList.remove('is-mobile-gallery-mounted');
        ensureMobileGalleryVisible();
        return;
      }

      gallery.classList.add('is-mobile-gallery-mounted');
      bindMobileGallery(mobileGallery);

      /* Preserve the active slide after harmless viewport-height changes. */
      if (!wasAlreadyMounted) {
        window.requestAnimationFrame(() => {
          const viewport = mobileGallery.querySelector('[data-cleo-mobile-gallery-viewport]');
          if (viewport) viewport.scrollLeft = 0;
          updateMobileGalleryState(mobileGallery, 0, false);
        });
      }
    };

    let mobileGalleryAnimationFrame = null;
    let mobileGalleryFixTimers = [];
    let responsiveResizeTimer = null;
    let lastResponsiveWidth = window.innerWidth;

    const scheduleMobileGalleryFix = () => {
      if (mobileGalleryAnimationFrame) {
        window.cancelAnimationFrame(mobileGalleryAnimationFrame);
      }

      mobileGalleryFixTimers.forEach((timer) => window.clearTimeout(timer));
      mobileGalleryFixTimers = [];

      mobileGalleryAnimationFrame = window.requestAnimationFrame(() => {
        mobileGalleryAnimationFrame = null;
        mountReliableMobileGallery();
      });

      mobileGalleryFixTimers.push(window.setTimeout(mountReliableMobileGallery, 180));
      mobileGalleryFixTimers.push(window.setTimeout(mountReliableMobileGallery, 700));
    };

    const handleResponsiveResize = () => {
      const currentWidth = window.innerWidth;

      /* iOS changes viewport height while scrolling; ignore height-only resizes. */
      if (Math.abs(currentWidth - lastResponsiveWidth) < 2) return;

      lastResponsiveWidth = currentWidth;
      window.clearTimeout(responsiveResizeTimer);
      responsiveResizeTimer = window.setTimeout(scheduleMobileGalleryFix, 120);
      scheduleStickyBarVisibilityUpdate();
    };

    const mobileBreakpoint = window.matchMedia('(max-width: 699px)');

    window.addEventListener('popstate', () => {
      scheduleStockUpdate();
      scheduleStickyBarVisibilityUpdate();
    });
    window.addEventListener('load', () => {
      scheduleMobileGalleryFix();
      scheduleStickyBarVisibilityUpdate();
    }, { once: true });
    window.addEventListener('pageshow', () => {
      scheduleMobileGalleryFix();
      scheduleStickyBarVisibilityUpdate();
    });
    window.addEventListener('scroll', scheduleStickyBarVisibilityUpdate, { passive: true });
    window.addEventListener('resize', handleResponsiveResize, { passive: true });

    if (typeof mobileBreakpoint.addEventListener === 'function') {
      mobileBreakpoint.addEventListener('change', scheduleMobileGalleryFix);
    } else if (typeof mobileBreakpoint.addListener === 'function') {
      mobileBreakpoint.addListener(scheduleMobileGalleryFix);
    }

    document.addEventListener('shopify:section:load', scheduleMobileGalleryFix);
    document.addEventListener('shopify:block:select', scheduleMobileGalleryFix);

    scheduleMobileGalleryFix();
    updateStockUrgency();
    scheduleStickyBarVisibilityUpdate();
  })();
</script>


