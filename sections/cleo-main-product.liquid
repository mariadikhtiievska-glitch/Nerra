{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-main-' | append: product.id | append: '-template--21732445290636__main'
  assign gallery_id = 'product-gallery-carousel-' | append: product.id | append: '-template--21732445290636__main'
  assign badge_text = product.metafields.custom.badge.value | default: product.metafields.custom.product_badge.value
  assign subtitle = product.metafields.custom.subtitle.value | default: product.metafields.custom.short_description.value | default: 'With Copper Care Brush and Travel Sleeve'
  assign sold_message = product.metafields.custom.sold_message.value | default: '9k plus sold last month'
  assign review_text = section.settings.review_text | default: '4.8 (380 reviews)'
  assign pill_block_count = 0
  assign usp_block_count = 0
  assign accordion_block_count = 0
  assign feature_block_count = 0

  for block in section.blocks
    if block.type == 'benefit_pill' and block.settings.text != blank
      assign pill_block_count = pill_block_count | plus: 1
    elsif block.type == 'product_usp'
      assign usp_block_count = usp_block_count | plus: 1
    elsif block.type == 'accordion'
      assign accordion_block_count = accordion_block_count | plus: 1
    elsif block.type == 'product_feature'
      assign feature_block_count = feature_block_count | plus: 1
    endif
  endfor

  if badge_text == blank
    if product.tags contains 'Signature Ritual Set'
      assign badge_text = 'Signature Ritual Set'
    elsif product.tags contains 'Limited Edition'
      assign badge_text = 'Limited Edition'
    elsif product.tags contains 'New Arrival'
      assign badge_text = 'New Arrival'
    elsif product.tags contains 'Bestseller'
      assign badge_text = 'Bestseller'
    elsif product.tags contains 'Sale'
      assign badge_text = 'Sale'
    elsif product.compare_at_price > product.price
      assign badge_text = 'Sale'
    else
      assign badge_text = blank
    endif
  endif
-%}

