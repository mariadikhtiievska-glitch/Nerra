<div id="ClsCoppercutopenFaq-{{ section.id }}" class="cls-coppercutopen-faq">
  <div class="cls-coppercutopen-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cls-coppercutopen-faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="cls-coppercutopen-faq__list" data-cls-coppercutopen-faq>
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank -%}
          <details class="cls-coppercutopen-faq__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="cls-coppercutopen-faq__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="cls-coppercutopen-faq__icon" aria-hidden="true"></span>
            </summary>
            {%- if block.settings.answer != blank -%}
              <div class="cls-coppercutopen-faq__answer">{{ block.settings.answer }}</div>
            {%- endif -%}
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions we expect after reading this"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Which bottles did you test?", "answer": "<p>Nine bought anonymously from public marketplace listings between $19 and $39, from nine different sellers, all listed as copper, plus one $59 control. Price paid and lab result are published for each.</p>" } },
        { "type": "faq", "settings": { "question": "Why won’t you name the sellers?", "answer": "<p>Because I tested one unit from each. One bottle tells you what arrived in that box. It does not prove what a seller ships every time, and I am not prepared to make a claim about a business on a sample of one. The bottles are numbered and the reports are published. Draw your own conclusions.</p>" } },
        { "type": "faq", "settings": { "question": "Is a plated or lined bottle dangerous?", "answer": "<p>I am not going to tell you that, because I do not have evidence for it. The realistic outcomes are more ordinary: it is not what was advertised, the plating wears through at the cap, and a lined bottle gives you no copper contact at all. That is a value and honesty problem, not a safety scare. If you want to know what is in yours specifically, the only real answer is a composition report.</p>" } },
        { "type": "faq", "settings": { "question": "My bottle passed the magnet test. Am I fine?", "answer": "<p>Not necessarily — that is the whole reason I cut mine open. Brass, bronze and aluminium are all non-magnetic. Check the interior colour and whether it has darkened after a month of use, then ask the seller for a report.</p>" } },
        { "type": "faq", "settings": { "question": "Does a lacquered interior at least keep the bottle clean?", "answer": "<p>It keeps it shiny, which is not the same thing. It also removes the antimicrobial contact that is the entire reason to store water in copper. If you like the look and do not care about the mechanism, a lined bottle is a nice object. Just know that is what you bought.</p>" } },
        { "type": "faq", "settings": { "question": "What if something is wrong with the bottle I order?", "answer": "<p>Free shipping on every order, shipped in one to two business days from the US. If something is not right when it arrives, contact them. They will make it right — no run-around, no script.</p>" } }
      ]
    }
  ]
}
{% endschema %}
