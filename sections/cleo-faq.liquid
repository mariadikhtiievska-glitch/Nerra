{%- liquid
  assign faq_heading_id = 'CleoFaqHeading-' | append: section.id
  assign valid_faq_count = 0

  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign valid_faq_count = valid_faq_count | plus: 1
    endif
  endfor
-%}

<section
  id="CleoFaq-{{ section.id }}"
  class="cleo-faq"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ faq_heading_id }}"
  {% endif %}
  style="
    --faq-background: {{ section.settings.background_color }};
    --faq-eyebrow-color: {{ section.settings.eyebrow_color }};
    --faq-heading-color: {{ section.settings.heading_color }};
    --faq-question-color: {{ section.settings.question_color }};
    --faq-answer-color: {{ section.settings.answer_color }};
    --faq-card-background: {{ section.settings.card_color }};
    --faq-card-border: {{ section.settings.border_color }};
    --faq-link-color: {{ section.settings.link_color }};

    --faq-content-width: {{ section.settings.content_width }}px;
    --faq-padding-top: {{ section.settings.padding_top }}px;
    --faq-padding-bottom: {{ section.settings.padding_bottom }}px;
    --faq-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --faq-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;

    --faq-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --faq-heading-size: {{ section.settings.heading_size }}px;
    --faq-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --faq-question-size: {{ section.settings.question_size }}px;
    --faq-mobile-question-size: {{ section.settings.mobile_question_size }}px;
    --faq-answer-size: {{ section.settings.answer_size }}px;
    --faq-mobile-answer-size: {{ section.settings.mobile_answer_size }}px;

    --faq-question-weight: {{ section.settings.question_weight }};
    --faq-row-height: {{ section.settings.row_height }}px;
    --faq-card-radius: {{ section.settings.card_radius }}px;
    --faq-card-gap: {{ section.settings.card_gap }}px;
    --faq-card-padding-x: {{ section.settings.card_padding_x }}px;
    --faq-mobile-card-padding-x: {{ section.settings.mobile_card_padding_x }}px;
  "
>
  <div class="cleo-faq__container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="cleo-faq__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cleo-faq__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2
            id="{{ faq_heading_id }}"
            class="cleo-faq__heading"
          >
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="cleo-faq__list"
        data-faq-list
        data-single-open="{{ section.settings.single_open }}"
      >
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            <details
              class="cleo-faq__item"
              data-faq-item
              {{ block.shopify_attributes }}
              {% if block.settings.open %}
                open
              {% endif %}
            >
              <summary class="cleo-faq__summary">
                <span class="cleo-faq__question">
                  {{ block.settings.question | escape }}
                </span>

                <span class="cleo-faq__icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 10 10"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M1 3L5 7L9 3"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linecap="square"
                      stroke-linejoin="miter"
                    />
                  </svg>
                </span>
              </summary>

              {%- if block.settings.answer != blank -%}
                <div class="cleo-faq__answer-wrapper">
                  <div class="cleo-faq__answer rte">
                    {{ block.settings.answer }}
                  </div>
                </div>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_more
      and section.settings.view_more_label != blank
      and section.settings.view_more_link != blank
    -%}
      <div class="cleo-faq__footer">
        <a
          class="cleo-faq__view-more"
          href="{{ section.settings.view_more_link }}"
        >
          {{ section.settings.view_more_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #CleoFaq-{{ section.id }} {
    width: 100%;
    padding-top: var(--faq-padding-top);
    padding-bottom: var(--faq-padding-bottom);
    background: var(--faq-background);
  }

  #CleoFaq-{{ section.id }} * {
    box-sizing: border-box;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__container {
    width: min(var(--faq-content-width), calc(100% - 40px));
    margin: 0 auto;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__header {
    margin: 0 0 34px;
    text-align: center;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__eyebrow {
    margin: 0 0 14px;
    color: var(--faq-eyebrow-color);
    font-size: var(--faq-eyebrow-size);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 1.35px;
    text-transform: uppercase;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__heading {
    max-width: 100%;
    margin: 0;
    color: var(--faq-heading-color);
    font-size: var(--faq-heading-size);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -1.4px;
    text-align: center;
    text-wrap: balance;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__list {
    display: grid;
    gap: var(--faq-card-gap);
  }

  #CleoFaq-{{ section.id }} .cleo-faq__item {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--faq-card-border);
    border-radius: var(--faq-card-radius);
    background: var(--faq-card-background);
  }

  #CleoFaq-{{ section.id }} .cleo-faq__summary {
    display: flex;
    min-height: var(--faq-row-height);
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    margin: 0;
    padding: 0 var(--faq-card-padding-x);
    color: var(--faq-question-color);
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__summary::-webkit-details-marker {
    display: none;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__summary::marker {
    display: none;
    content: "";
  }

  #CleoFaq-{{ section.id }} .cleo-faq__summary:focus {
    outline: none;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__summary:focus-visible {
    outline: 2px solid var(--faq-heading-color);
    outline-offset: -3px;
    border-radius: calc(var(--faq-card-radius) - 1px);
  }

  #CleoFaq-{{ section.id }} .cleo-faq__question {
    display: block;
    flex: 1 1 auto;
    font-size: var(--faq-question-size);
    font-weight: var(--faq-question-weight);
    line-height: 1.45;
    text-align: left;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__icon {
    display: inline-flex;
    width: 10px;
    height: 10px;
    flex: 0 0 10px;
    align-items: center;
    justify-content: center;
    color: var(--faq-question-color);
    transition: transform 180ms ease;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__icon svg {
    display: block;
    width: 10px;
    height: 10px;
  }

  #CleoFaq-{{ section.id }}
    .cleo-faq__item[open]
    .cleo-faq__icon {
    transform: rotate(180deg);
  }

  #CleoFaq-{{ section.id }} .cleo-faq__answer-wrapper {
    padding: 0 var(--faq-card-padding-x) 19px;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__answer {
    max-width: 920px;
    color: var(--faq-answer-color);
    font-size: var(--faq-answer-size);
    font-weight: 400;
    line-height: 1.65;
    animation: cleo-faq-answer-{{ section.id }} 180ms ease both;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__answer > *:first-child {
    margin-top: 0;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__answer > *:last-child {
    margin-bottom: 0;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__answer p {
    margin-top: 0;
    margin-bottom: 10px;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__answer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__footer {
    margin-top: 18px;
    text-align: center;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__view-more {
    display: inline-block;
    padding: 0;
    color: var(--faq-link-color);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    text-decoration: none;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  #CleoFaq-{{ section.id }} .cleo-faq__view-more:hover {
    opacity: 0.72;
    transform: translateY(-1px);
  }

  #CleoFaq-{{ section.id }} .cleo-faq__view-more:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @keyframes cleo-faq-answer-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 989px) {
    #CleoFaq-{{ section.id }} .cleo-faq__heading {
      font-size: clamp(
        var(--faq-mobile-heading-size),
        5.4vw,
        var(--faq-heading-size)
      );
    }
  }

  @media screen and (max-width: 749px) {
    #CleoFaq-{{ section.id }} {
      padding-top: var(--faq-mobile-padding-top);
      padding-bottom: var(--faq-mobile-padding-bottom);
    }

    #CleoFaq-{{ section.id }} .cleo-faq__container {
      width: calc(100% - 32px);
    }

    #CleoFaq-{{ section.id }} .cleo-faq__header {
      margin-bottom: 24px;
    }

    #CleoFaq-{{ section.id }} .cleo-faq__eyebrow {
      margin-bottom: 10px;
      font-size: 14px;
      line-height: 1.25;
      letter-spacing: 1px;
    }

    #CleoFaq-{{ section.id }} .cleo-faq__heading {
      font-size: var(--faq-mobile-heading-size);
      line-height: 1.12;
      letter-spacing: -0.6px;
    }

    #CleoFaq-{{ section.id }} .cleo-faq__list {
      gap: 8px;
    }

    #CleoFaq-{{ section.id }} .cleo-faq__summary {
      min-height: 56px;
      gap: 16px;
      padding-right: var(--faq-mobile-card-padding-x);
      padding-left: var(--faq-mobile-card-padding-x);
    }

    #CleoFaq-{{ section.id }} .cleo-faq__question {
      font-size: var(--faq-mobile-question-size);
      line-height: 1.4;
    }

    #CleoFaq-{{ section.id }} .cleo-faq__answer-wrapper {
      padding-right: var(--faq-mobile-card-padding-x);
      padding-bottom: 17px;
      padding-left: var(--faq-mobile-card-padding-x);
    }

    #CleoFaq-{{ section.id }} .cleo-faq__answer {
      font-size: var(--faq-mobile-answer-size);
      line-height: 1.6;
    }

    #CleoFaq-{{ section.id }} .cleo-faq__footer {
      margin-top: 17px;
    }

    #CleoFaq-{{ section.id }} .cleo-faq__view-more {
      font-size: 14px;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    #CleoFaq-{{ section.id }} .cleo-faq__icon,
    #CleoFaq-{{ section.id }} .cleo-faq__view-more,
    #CleoFaq-{{ section.id }} .cleo-faq__answer {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('CleoFaq-{{ section.id }}');

    if (!section || section.dataset.faqInitialized === 'true') {
      return;
    }

    section.dataset.faqInitialized = 'true';

    const list = section.querySelector('[data-faq-list]');
    const items = Array.from(section.querySelectorAll('[data-faq-item]'));

    if (!list || items.length === 0) {
      return;
    }

    const singleOpen = list.dataset.singleOpen === 'true';

    if (singleOpen) {
      const initiallyOpenItems = items.filter((item) => item.open);

      initiallyOpenItems.slice(1).forEach((item) => {
        item.open = false;
      });
    }

    items.forEach((item) => {
      const summary = item.querySelector('.cleo-faq__summary');

      if (!summary) {
        return;
      }

      const updateExpandedState = () => {
        summary.setAttribute(
          'aria-expanded',
          item.open ? 'true' : 'false'
        );
      };

      updateExpandedState();

      item.addEventListener('toggle', () => {
        updateExpandedState();

        if (!singleOpen || !item.open) {
          return;
        }

        items.forEach((otherItem) => {
          if (otherItem !== item && otherItem.open) {
            otherItem.open = false;
          }
        });
      });
    });
  })();
</script>

{%- if valid_faq_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign current_faq_index = 0 -%}

        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- assign current_faq_index = current_faq_index | plus: 1 -%}

            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | strip_newlines | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
              }
            }

            {%- if current_faq_index < valid_faq_count -%}
              ,
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

