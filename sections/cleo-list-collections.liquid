<section
  id="CleoCollectionList-{{ section.id }}"
  class="cleo-list-collections"
  style="
    --collection-list-bg: {{ section.settings.background_color }};
    --collection-list-columns: {{ section.settings.columns }};
    --collection-list-mobile-columns: {{ section.settings.mobile_columns }};
    --collection-list-gap: {{ section.settings.gap }}px;
    --collection-list-padding-top: {{ section.settings.padding_top }}px;
    --collection-list-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cleo-list-collections__container">
    <h1>{{ section.settings.heading }}</h1>

    {%- paginate collections by section.settings.collections_per_page -%}
      <div class="cleo-list-collections__grid">
        {%- for collection in collections -%}
          {%- liquid
            assign collection_image = collection.featured_image
            if collection_image == blank and collection.products.first != blank
              assign collection_image = collection.products.first.featured_image
            endif
          -%}
          <a class="cleo-list-collections__card" href="{{ collection.url }}">
            <div class="cleo-list-collections__media">
              {%- if collection_image != blank -%}
                {{
                  collection_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 699px) 50vw, (max-width: 999px) 33vw, 25vw',
                    alt: collection.title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="cleo-list-collections__content">
              <h2>{{ collection.title }}</h2>
              {%- if section.settings.show_product_count -%}
                <span>{{ collection.products_count }} products</span>
              {%- endif -%}
            </div>
          </a>
        {%- else -%}
          <p>No collections found.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="cleo-pagination" aria-label="Collections pagination">
          {%- if paginate.previous -%}<a class="cleo-button cleo-button--small" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="cleo-button cleo-button--small" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<style>
  #CleoCollectionList-{{ section.id }} {
    padding-block: var(--collection-list-padding-top) var(--collection-list-padding-bottom);
    background: var(--collection-list-bg);
  }

  #CleoCollectionList-{{ section.id }} .cleo-list-collections__container {
    width: min(1480px, calc(100% - 96px));
    margin-inline: auto;
  }

  #CleoCollectionList-{{ section.id }} h1 {
    margin: 0 0 42px;
    color: #895737;
    font-size: clamp(36px, 4vw, 58px);
    line-height: 1.05;
    text-align: center;
  }

  #CleoCollectionList-{{ section.id }} .cleo-list-collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--collection-list-columns), minmax(0, 1fr));
    gap: var(--collection-list-gap);
  }

  #CleoCollectionList-{{ section.id }} .cleo-list-collections__card {
    color: #401c28;
    text-decoration: none;
  }

  #CleoCollectionList-{{ section.id }} .cleo-list-collections__media {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 14px 30px rgba(74, 43, 29, 0.13);
  }

  #CleoCollectionList-{{ section.id }} .cleo-list-collections__media img,
  #CleoCollectionList-{{ section.id }} .cleo-list-collections__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  #CleoCollectionList-{{ section.id }} .cleo-list-collections__card:hover img {
    transform: scale(1.025);
  }

  #CleoCollectionList-{{ section.id }} .cleo-list-collections__content {
    padding-top: 18px;
  }

  #CleoCollectionList-{{ section.id }} h2 {
    margin: 0 0 5px;
    font-size: 21px;
    line-height: 1.3;
  }

  #CleoCollectionList-{{ section.id }} .cleo-list-collections__content span {
    color: #895737;
    font-size: 14px;
  }

  @media screen and (max-width: 999px) {
    #CleoCollectionList-{{ section.id }} .cleo-list-collections__container {
      width: calc(100% - 48px);
    }

    #CleoCollectionList-{{ section.id }} .cleo-list-collections__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 699px) {
    #CleoCollectionList-{{ section.id }} {
      padding-block: 36px;
    }

    #CleoCollectionList-{{ section.id }} .cleo-list-collections__container {
      width: calc(100% - 24px);
    }

    #CleoCollectionList-{{ section.id }} h1 {
      margin-bottom: 26px;
      font-size: 34px;
    }

    #CleoCollectionList-{{ section.id }} .cleo-list-collections__grid {
      grid-template-columns: repeat(var(--collection-list-mobile-columns), minmax(0, 1fr));
      gap: 22px 14px;
    }

    #CleoCollectionList-{{ section.id }} .cleo-list-collections__content {
      padding-top: 12px;
    }

    #CleoCollectionList-{{ section.id }} h2 {
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Cleo collection list",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "range", "id": "collections_per_page", "label": "Collections per page", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "select", "id": "mobile_columns", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "gap", "label": "Grid gap", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3e9dc" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Cleo collection list" }
  ]
}
{% endschema %}
