{%- capture check_icon -%}<span class="cleo-comparison__icon cleo-comparison__icon--check" aria-label="Yes">&#10003;</span>{%- endcapture -%}
{%- capture cross_icon -%}<span class="cleo-comparison__icon cleo-comparison__icon--cross" aria-label="No">&times;</span>{%- endcapture -%}

<section
  id="CleoComparison-{{ section.id }}"
  class="cleo-comparison-section"
  style="
    --comparison-bg: {{ section.settings.background_color }};
    --comparison-accent: {{ section.settings.accent_color }};
    --comparison-second: {{ section.settings.cleo_background }};
    --comparison-other: {{ section.settings.other_background }};
    --comparison-width: {{ section.settings.max_width }}px;
    --comparison-padding-top: {{ section.settings.padding_top }}px;
    --comparison-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cleo-comparison-section__container">
    <div class="cleo-comparison-section__content">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="cleo-comparison-section__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="cleo-comparison-section__table-wrap">
      <table>
        <thead>
          <tr>
            <th class="cleo-comparison__feature">{{ section.settings.feature_heading }}</th>
            <th class="cleo-comparison__cleo">{{ section.settings.cleo_heading }}</th>
            <th class="cleo-comparison__other">{{ section.settings.steel_heading }}</th>
            <th class="cleo-comparison__other">{{ section.settings.plastic_heading }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td class="cleo-comparison__feature cleo-comparison__row-title">{{ block.settings.feature }}</td>
              <td class="cleo-comparison__cleo">
                {%- if block.settings.cleo_value == 'check' -%}{{ check_icon }}{%- else -%}{{ cross_icon }}{%- endif -%}
              </td>
              <td class="cleo-comparison__other">
                {%- if block.settings.steel_value == 'check' -%}{{ check_icon }}{%- else -%}{{ cross_icon }}{%- endif -%}
              </td>
              <td class="cleo-comparison__other">
                {%- if block.settings.plastic_value == 'check' -%}{{ check_icon }}{%- else -%}{{ cross_icon }}{%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  #CleoComparison-{{ section.id }} {
    padding-block: var(--comparison-padding-top) var(--comparison-padding-bottom);
    background: var(--comparison-bg);
  }

  #CleoComparison-{{ section.id }} .cleo-comparison-section__container {
    display: flex;
    width: min(var(--comparison-width), calc(100% - 192px));
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: border-box;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison-section__content {
    width: 38%;
  }

  #CleoComparison-{{ section.id }} h2 {
    margin: 0 0 28px;
    color: var(--comparison-accent);
    font-size: 40px;
    font-weight: 700;
    line-height: 0.95;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison-section__description {
    color: #111111;
    font-size: 22px;
    line-height: 1.3;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison-section__description p {
    margin: 0;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison-section__table-wrap {
    width: 54%;
    overflow: hidden;
    border-radius: 16px;
  }

  #CleoComparison-{{ section.id }} table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
  }

  #CleoComparison-{{ section.id }} th,
  #CleoComparison-{{ section.id }} td {
    border: 0;
    border-right: 2px solid var(--comparison-bg);
    padding: 13px 14px;
    background-image: none;
    box-shadow: none;
    text-align: center;
    vertical-align: middle;
  }

  #CleoComparison-{{ section.id }} tr > *:last-child {
    border-right: 0;
  }

  #CleoComparison-{{ section.id }} thead th {
    border-bottom: 2px solid var(--comparison-bg);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
  }

  #CleoComparison-{{ section.id }} tbody td {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
  }

  #CleoComparison-{{ section.id }} thead tr {
    height: 93px;
  }

  #CleoComparison-{{ section.id }} tbody tr {
    height: 49px;
  }

  #CleoComparison-{{ section.id }} tbody tr:nth-child(2),
  #CleoComparison-{{ section.id }} tbody tr:nth-child(4) {
    height: 69px;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison__feature {
    width: 38%;
    background: var(--comparison-accent);
    color: #ffffff;
    text-align: left;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison__cleo {
    background: var(--comparison-second);
    color: #111111;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison__other {
    background: var(--comparison-other);
    color: #111111;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison__row-title {
    font-weight: 700;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison__icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  #CleoComparison-{{ section.id }} .cleo-comparison__icon--check {
    background: var(--comparison-accent);
  }

  #CleoComparison-{{ section.id }} .cleo-comparison__icon--cross {
    background: #c08552;
  }

  @media screen and (max-width: 749px) {
    #CleoComparison-{{ section.id }} {
      padding-block: 40px;
    }

    #CleoComparison-{{ section.id }} .cleo-comparison-section__container {
      width: calc(100% - 32px);
      flex-direction: column;
      gap: 24px;
      padding-inline: 4px;
    }

    #CleoComparison-{{ section.id }} .cleo-comparison-section__content,
    #CleoComparison-{{ section.id }} .cleo-comparison-section__table-wrap {
      width: 100%;
    }

    #CleoComparison-{{ section.id }} h2 {
      max-width: 85%;
      margin: 0 0 18px 10px;
      font-size: 28px;
    }

    #CleoComparison-{{ section.id }} .cleo-comparison-section__description {
      max-width: 90%;
      margin-left: 10px;
      font-size: 20px;
    }

    #CleoComparison-{{ section.id }} .cleo-comparison-section__table-wrap {
      overflow-x: auto;
      overflow-y: hidden;
      border-radius: 8px;
      scrollbar-width: none;
    }

    #CleoComparison-{{ section.id }} .cleo-comparison-section__table-wrap::-webkit-scrollbar {
      display: none;
    }

    #CleoComparison-{{ section.id }} table {
      display: block;
      width: max-content;
      table-layout: auto;
    }

    #CleoComparison-{{ section.id }} thead,
    #CleoComparison-{{ section.id }} tbody {
      display: block;
    }

    #CleoComparison-{{ section.id }} tr {
      display: flex;
      height: auto !important;
    }

    #CleoComparison-{{ section.id }} tbody tr:nth-child(2),
    #CleoComparison-{{ section.id }} tbody tr:nth-child(4) {
      height: auto !important;
    }

    #CleoComparison-{{ section.id }} thead th,
    #CleoComparison-{{ section.id }} tbody td {
      display: flex;
      width: 140px;
      min-width: 140px;
      align-items: center;
      justify-content: center;
      padding: 10px 4px;
      font-size: 13px;
      line-height: 1.2;
      white-space: normal;
    }

    #CleoComparison-{{ section.id }} th:first-child,
    #CleoComparison-{{ section.id }} td:first-child {
      position: sticky;
      left: 0;
      z-index: 3;
      width: 140px;
      min-width: 140px;
      text-align: center;
    }

    #CleoComparison-{{ section.id }} .cleo-comparison__icon {
      width: 14px;
      height: 14px;
      font-size: 8px;
    }
  }
</style>

{% schema %}
{
  "name": "Cleo comparison table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Copper Over Regular Bottles?" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Embrace the ancient practice of Tamra Jal and create a Hydration Ritual</p>" },
    { "type": "text", "id": "feature_heading", "label": "Feature heading", "default": "Feature/ Benefit" },
    { "type": "text", "id": "cleo_heading", "label": "Cleo heading", "default": "CLEO Copper Drinkware" },
    { "type": "text", "id": "steel_heading", "label": "Steel heading", "default": "Stainless Steel Bottle" },
    { "type": "text", "id": "plastic_heading", "label": "Plastic heading", "default": "Plastic Bottles" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3e9dc" },
    { "type": "color", "id": "accent_color", "label": "Feature color", "default": "#895737" },
    { "type": "color", "id": "cleo_background", "label": "Cleo column background", "default": "#ffffff" },
    { "type": "color", "id": "other_background", "label": "Other columns background", "default": "#f2dac4" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 1000, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Naturally Antimicrobial" },
        { "type": "select", "id": "cleo_value", "label": "Cleo value", "options": [{ "value": "check", "label": "Check" }, { "value": "cross", "label": "Cross" }], "default": "check" },
        { "type": "select", "id": "steel_value", "label": "Steel value", "options": [{ "value": "check", "label": "Check" }, { "value": "cross", "label": "Cross" }], "default": "cross" },
        { "type": "select", "id": "plastic_value", "label": "Plastic value", "options": [{ "value": "check", "label": "Check" }, { "value": "cross", "label": "Cross" }], "default": "cross" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cleo comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Naturally Antimicrobial", "cleo_value": "check", "steel_value": "cross", "plastic_value": "cross" } },
        { "type": "row", "settings": { "feature": "Naturally Alkalizes Water", "cleo_value": "check", "steel_value": "cross", "plastic_value": "cross" } },
        { "type": "row", "settings": { "feature": "100% Plastic & BPA Free", "cleo_value": "check", "steel_value": "check", "plastic_value": "cross" } },
        { "type": "row", "settings": { "feature": "Supports Ayurvedic Rituals", "cleo_value": "check", "steel_value": "cross", "plastic_value": "cross" } },
        { "type": "row", "settings": { "feature": "Zero Microplastic Risk", "cleo_value": "check", "steel_value": "check", "plastic_value": "cross" } }
      ]
    }
  ]
}
{% endschema %}
