<div id="ClsCoppercutopenOpeningTest-{{ section.id }}" class="cls-coppercutopen-opening-test">
  <div class="cls-coppercutopen-opening-test__inner">
    {%- if section.settings.body != blank -%}
      <div class="cls-coppercutopen-opening-test__body cls-coppercutopen-rte">{{ section.settings.body }}</div>
    {%- endif -%}

    <div class="cls-coppercutopen-opening-test__photo">
      {%- if section.settings.photo != blank -%}
        <img
          src="{{ section.settings.photo | image_url: width: 1280 }}"
          srcset="
            {{ section.settings.photo | image_url: width: 450 }} 450w,
            {{ section.settings.photo | image_url: width: 900 }} 900w,
            {{ section.settings.photo | image_url: width: 1280 }} 1280w
          "
          sizes="100vw"
          alt="{{ section.settings.photo.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.photo.width }}"
          height="{{ section.settings.photo.height }}"
        >
      {%- elsif section.settings.photo_fallback != blank -%}
        <img
          src="{{ section.settings.photo_fallback | replace: '.jpg', '-900.jpg' | asset_url }}"
          srcset="
            {{ section.settings.photo_fallback | replace: '.jpg', '-450.jpg' | asset_url }} 450w,
            {{ section.settings.photo_fallback | replace: '.jpg', '-900.jpg' | asset_url }} 900w,
            {{ section.settings.photo_fallback | asset_url }} 1280w
          "
          sizes="100vw"
          alt="Magnet test — holds on one bottle, slides off another"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Opening test",
  "settings": [
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Go and get your copper bottle. I’ll wait.</p><p>Now find a magnet. The one holding a photo to your fridge will do.</p><p>Hold it against the side of the bottle. Then against the cap, separately — the cap is where corners get cut first.</p><p><strong>Copper is not magnetic. Not weakly. Not at all.</strong></p><p>If the magnet grips, or drags, or hangs on for half a second before it slides, there is steel underneath whatever you are looking at.</p><p>Now the part nobody tells you: passing that test proves almost nothing.</p><p>Brass is not magnetic. Bronze is not magnetic. <strong>Aluminium is not magnetic.</strong> A steel bottle sprayed with copper-coloured paint can be non-magnetic too. The magnet catches one kind of fake and waves the rest through.</p><p>Which is how I ended up with nine bottles and a bandsaw.</p>"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "photo_fallback",
      "label": "Photo fallback filename",
      "info": "Used only if no photo is set above. Must be an asset filename already uploaded to this theme.",
      "default": "copper-bottles-cut-open-magnet-test.jpg"
    }
  ],
  "presets": [
    {
      "name": "Opening test"
    }
  ]
}
{% endschema %}
