<div
  id="ClsNeeraReason-{{ section.id }}"
  class="cls-neera-reason{% if section.settings.image_position == 'left' %} cls-neera-reason--image-left{% endif %}{% if section.settings.background == 'cream-alt' %} cls-neera-reason--cream-alt{% endif %}"
>
  <div class="cls-neera-reason__inner">
    <div class="cls-neera-reason__content">
      <div class="cls-neera-reason__head">
        {%- if section.settings.number != blank -%}
          <p class="cls-neera-reason__number cls-neera-type-numeral-reason">{{ section.settings.number }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h3 class="cls-neera-reason__heading cls-neera-type-heading">{{ section.settings.heading | escape }}</h3>
        {%- endif -%}
      </div>

      {%- if section.settings.body != blank -%}
        <div class="cls-neera-reason__body cls-neera-type-body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    <div class="cls-neera-reason__photo">
      {%- if section.settings.photo_image != blank -%}
        <img
          src="{{ section.settings.photo_image | image_url: width: 900 }}"
          srcset="{{ section.settings.photo_image | image_url: width: 450 }} 450w, {{ section.settings.photo_image | image_url: width: 900 }} 900w, {{ section.settings.photo_image | image_url: width: 1050 }} 1050w"
          sizes="(min-width: 768px) 560px, 100vw"
          alt="{{ section.settings.photo_image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <img
          src="{{ section.settings.photo_image_fallback | asset_url }}"
          srcset="{{ section.settings.photo_image_fallback | replace: '.jpg', '-450.jpg' | asset_url }} 450w, {{ section.settings.photo_image_fallback | replace: '.jpg', '-900.jpg' | asset_url }} 900w, {{ section.settings.photo_image_fallback | asset_url }} 1280w"
          sizes="(min-width: 768px) 560px, 100vw"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Neera reason",
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "10"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "photo_image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "photo_image_fallback",
      "label": "Photo fallback asset"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream (light)" },
        { "value": "cream-alt", "label": "Cream alt (darker)" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "Neera reason"
    }
  ]
}
{% endschema %}
