{%- render 'cleo-hero-styles' -%}

<section class="cleo-hero" style="--cleo-hero-height: 100vh;">
  <img src="{{ 'cleo-hero.jpg' | asset_url }}" alt="{{ shop.name }}" width="3360" height="1225">
  <div class="cleo-hero__content" style="--cleo-hero-align-x: center; --cleo-hero-align-y: center; --cleo-hero-text-align: center;">
    <div class="cleo-hero__box">
      <h1 class="cleo-hero__heading">{{ shop.name }}</h1>
      <div class="cleo-hero__text">{{ shop.password_message }}</div>
      {%- form 'storefront_password', class: 'cleo-form-grid' -%}
        {{ form.errors | default_errors }}
        <input class="cleo-input" type="password" name="password" placeholder="Password">
        <button class="cleo-button" type="submit">Enter</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cleo password",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Cleo password"
    }
  ]
}
{% endschema %}
