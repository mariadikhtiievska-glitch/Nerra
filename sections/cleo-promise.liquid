<section
  id="CleoPromise-{{ section.id }}"
  class="cleo-promise"
  style="
    --promise-bg: {{ section.settings.background_color }};
    --promise-heading: {{ section.settings.heading_color }};
    --promise-text: {{ section.settings.text_color }};
    --promise-border: {{ section.settings.border_color }};
    --promise-width: {{ section.settings.max_width }}px;
    --promise-padding-top: {{ section.settings.padding_top }}px;
    --promise-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cleo-promise__container">
    <div class="cleo-promise__layout">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="cleo-promise__items">
        {%- for block in section.blocks -%}
          <div class="cleo-promise__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank or block.settings.fallback_asset != blank -%}
              <div class="cleo-promise__icon">
                {%- render 'cleo-image',
                  image: block.settings.image,
                  asset: block.settings.fallback_asset,
                  width: 160,
                  height: 160,
                  sizes: '64px',
                  alt: ''
                -%}
              </div>
            {%- endif -%}
            <div class="cleo-promise__text">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  #CleoPromise-{{ section.id }} {
    padding-block: var(--promise-padding-top) var(--promise-padding-bottom);
    border-top: 1px solid var(--promise-border);
    background: var(--promise-bg);
  }

  #CleoPromise-{{ section.id }} .cleo-promise__container {
    width: min(var(--promise-width), calc(100% - 48px));
    margin-inline: auto;
  }

  #CleoPromise-{{ section.id }} .cleo-promise__layout {
    display: grid;
    min-height: 140px;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 50px;
    align-items: center;
  }

  #CleoPromise-{{ section.id }} h2 {
    margin: 0;
    color: var(--promise-heading);
    font-size: 40px;
    font-weight: 600;
    line-height: 1.1;
  }

  #CleoPromise-{{ section.id }} .cleo-promise__items {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  #CleoPromise-{{ section.id }} .cleo-promise__item {
    display: flex;
    flex: 1;
    align-items: flex-start;
    gap: 14px;
  }

  #CleoPromise-{{ section.id }} .cleo-promise__icon {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
  }

  #CleoPromise-{{ section.id }} .cleo-promise__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #CleoPromise-{{ section.id }} .cleo-promise__text {
    color: var(--promise-text);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    #CleoPromise-{{ section.id }} {
      padding-block: 24px;
    }

    #CleoPromise-{{ section.id }} .cleo-promise__container {
      width: calc(100% - 32px);
    }

    #CleoPromise-{{ section.id }} .cleo-promise__layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    #CleoPromise-{{ section.id }} h2 {
      font-size: 40px;
    }

    #CleoPromise-{{ section.id }} .cleo-promise__items {
      flex-direction: column;
      gap: 18px;
    }

    #CleoPromise-{{ section.id }} .cleo-promise__item {
      gap: 10px;
    }

    #CleoPromise-{{ section.id }} .cleo-promise__icon {
      width: 39px;
      height: 39px;
      flex-basis: 39px;
    }

    #CleoPromise-{{ section.id }} .cleo-promise__text {
      font-size: 21px;
    }
  }
</style>

{% schema %}
{
  "name": "Cleo promise",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cleo's Promise" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3e9dc" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#895737" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "border_color", "label": "Top border color", "default": "#d8c7b5" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1300 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Promise item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "default": "cleo-static-865cd75fee7b.png" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "All Cleo Products are Premium Quality and Handcrafted" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cleo promise",
      "blocks": [
        { "type": "item", "settings": { "text": "All Cleo Products are Premium Quality and Handcrafted" } },
        { "type": "item", "settings": { "text": "All Cleo Products are Good for you and Better for the planet." } }
      ]
    }
  ]
}
{% endschema %}
