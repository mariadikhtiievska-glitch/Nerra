<div id="ClsCoppercutopenFinalCta-{{ section.id }}" class="cls-coppercutopen-final-cta">
  <div class="cls-coppercutopen-final-cta__inner">
    <div class="cls-coppercutopen-final-cta__card">
      {%- if section.settings.promo_code != blank -%}
        <p class="cls-coppercutopen-final-cta__promo">
          {{ section.settings.promo_prefix | escape }}
          <span class="cls-coppercutopen-final-cta__promo-code">{{ section.settings.promo_code | escape }}</span>
          <br>
          {{ section.settings.promo_suffix | escape }}
        </p>
      {%- endif -%}

      <div
        class="cls-coppercutopen-final-cta__countdown"
        data-cls-coppercutopen-countdown
        data-duration-hours="{{ section.settings.countdown_duration_hours }}"
      >
        <div class="cls-coppercutopen-final-cta__countdown-unit">
          <p class="cls-coppercutopen-final-cta__countdown-value" data-countdown-days>00</p>
          <p class="cls-coppercutopen-final-cta__countdown-label">day</p>
        </div>
        <div class="cls-coppercutopen-final-cta__countdown-unit">
          <p class="cls-coppercutopen-final-cta__countdown-value" data-countdown-hours>00</p>
          <p class="cls-coppercutopen-final-cta__countdown-label">hrs</p>
        </div>
        <div class="cls-coppercutopen-final-cta__countdown-unit">
          <p class="cls-coppercutopen-final-cta__countdown-value" data-countdown-minutes>00</p>
          <p class="cls-coppercutopen-final-cta__countdown-label">mns</p>
        </div>
        <div class="cls-coppercutopen-final-cta__countdown-unit">
          <p class="cls-coppercutopen-final-cta__countdown-value" data-countdown-seconds>00</p>
          <p class="cls-coppercutopen-final-cta__countdown-label">secs</p>
        </div>
      </div>

      <div class="cls-coppercutopen-final-cta__checkmarks">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <p {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.price_headline != blank -%}
        <p class="cls-coppercutopen-final-cta__price-headline">{{ section.settings.price_headline | escape }}</p>
      {%- endif -%}

      <a class="cls-coppercutopen-final-cta__button" href="{{ section.settings.button_url | default: '#' }}">
        {{ section.settings.button_label | escape }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "promo_prefix",
      "label": "Promo text (before code)",
      "default": "Use code"
    },
    {
      "type": "text",
      "id": "promo_code",
      "label": "Promo code",
      "default": "NEERA10"
    },
    {
      "type": "text",
      "id": "promo_suffix",
      "label": "Promo text (after code)",
      "default": "for an extra 10%"
    },
    {
      "type": "range",
      "id": "countdown_duration_hours",
      "label": "Countdown length (hours)",
      "min": 1,
      "max": 72,
      "step": 1,
      "default": 20,
      "info": "Rolling per-visitor countdown — starts on first visit, persists across reloads, restarts automatically once it expires."
    },
    {
      "type": "text",
      "id": "price_headline",
      "label": "Price headline",
      "default": "59$ - Copper Doesn’t Expire"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CHECK AVAILABILITY 👉"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "checkmark",
      "name": "Checkmark line",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Final CTA",
      "blocks": [
        { "type": "checkmark", "settings": { "text": "✅ Lab-Verified 99.9% Pure Copper" } },
        { "type": "checkmark", "settings": { "text": "✅ No Alloys, No Coatings, No Plastic" } },
        { "type": "checkmark", "settings": { "text": "✅ Over 22,600+ Happy Customers" } },
        { "type": "checkmark", "settings": { "text": "✅ Free Shipping · Ships in 1–2 Days" } }
      ]
    }
  ]
}
{% endschema %}
