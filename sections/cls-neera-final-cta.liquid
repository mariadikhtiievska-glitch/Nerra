<div id="ClsNeeraFinalCta-{{ section.id }}" class="cls-neera-final-cta">
  <div class="cls-neera-final-cta__inner">
    <div class="cls-neera-final-cta__photo">
      {%- if section.settings.photo_image != blank -%}
        <img
          src="{{ section.settings.photo_image | image_url: width: 900 }}"
          srcset="{{ section.settings.photo_image | image_url: width: 450 }} 450w, {{ section.settings.photo_image | image_url: width: 900 }} 900w, {{ section.settings.photo_image | image_url: width: 1050 }} 1050w"
          sizes="(min-width: 768px) 640px, 100vw"
          alt="{{ section.settings.photo_image.alt | default: section.settings.headline | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <img
          src="{{ section.settings.photo_image_fallback | asset_url }}"
          srcset="{{ section.settings.photo_image_fallback | replace: '.jpg', '-450.jpg' | asset_url }} 450w, {{ section.settings.photo_image_fallback | replace: '.jpg', '-900.jpg' | asset_url }} 900w, {{ section.settings.photo_image_fallback | asset_url }} 1280w"
          sizes="(min-width: 768px) 640px, 100vw"
          alt="{{ section.settings.headline | escape }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="cls-neera-final-cta__card">
      {%- if section.settings.headline != blank -%}
        <p class="cls-neera-final-cta__headline">{{ section.settings.headline | escape }}</p>
      {%- endif -%}

      <div class="cls-neera-final-cta__badges">
        {%- if section.settings.badge_1 != blank -%}
          <p class="cls-neera-final-cta__badge">{{ section.settings.badge_1 | escape }}</p>
        {%- endif -%}
        {%- if section.settings.badge_2 != blank -%}
          <div class="cls-neera-final-cta__badge cls-neera-final-cta__badge--rte">{{ section.settings.badge_2 }}</div>
        {%- endif -%}
      </div>

      <div class="cls-neera-final-cta__price">
        {%- if section.settings.price != blank -%}
          <p class="cls-neera-final-cta__price-value cls-neera-type-numeral-stat">{{ section.settings.price | escape }}</p>
        {%- endif -%}
        {%- if section.settings.price_note != blank -%}
          <p class="cls-neera-final-cta__price-note">{{ section.settings.price_note | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a
          class="cls-neera-final-cta__button cls-neera-type-button"
          href="{{ section.settings.cta_link | default: '#' }}"
        >
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}

      {%- if section.settings.show_countdown -%}
        <div
          class="cls-neera-final-cta__countdown"
          data-cls-neera-countdown
          data-duration-hours="{{ section.settings.countdown_hours }}"
        >
          <div class="cls-neera-final-cta__countdown-segment">
            <span class="cls-neera-final-cta__countdown-value" data-countdown-days>00</span>
            <span class="cls-neera-final-cta__countdown-label">day</span>
          </div>
          <div class="cls-neera-final-cta__countdown-segment">
            <span class="cls-neera-final-cta__countdown-value" data-countdown-hours>00</span>
            <span class="cls-neera-final-cta__countdown-label">hrs</span>
          </div>
          <div class="cls-neera-final-cta__countdown-segment">
            <span class="cls-neera-final-cta__countdown-value" data-countdown-minutes>00</span>
            <span class="cls-neera-final-cta__countdown-label">mns</span>
          </div>
          <div class="cls-neera-final-cta__countdown-segment">
            <span class="cls-neera-final-cta__countdown-value" data-countdown-seconds>00</span>
            <span class="cls-neera-final-cta__countdown-label">secs</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Neera final CTA",
  "settings": [
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "photo_image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "photo_image_fallback",
      "label": "Photo fallback asset",
      "default": "neera-complete-set.jpg"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Start your hydration ritual today"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Badge 1 text",
      "default": "99.9% pure copper · Hand-hammered · Lab-tested · Includes Care Brush & Travel Sleeve · Leak-proof · Free Shipping"
    },
    {
      "type": "richtext",
      "id": "badge_2",
      "label": "Badge 2 (promo code)",
      "default": "<p>Code <strong>NEERA10</strong> for an extra 10% off</p>"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$59"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "Buy More, Save More — up to 15% off"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Claim your last bottle with autumn offer 50% off"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown timer",
      "default": true
    },
    {
      "type": "range",
      "id": "countdown_hours",
      "label": "Countdown duration (hours)",
      "min": 1,
      "max": 72,
      "step": 1,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Neera final CTA"
    }
  ]
}
{% endschema %}
