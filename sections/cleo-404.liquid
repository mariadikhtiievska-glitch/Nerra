<section class="cleo-page-shell">
  <h1 class="cleo-page-title">{{ section.settings.heading }}</h1>
  <div class="cleo-rich-text">
    {{ section.settings.text }}
    <p><a class="cleo-button" href="{{ routes.root_url }}">{{ section.settings.button_label }}</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Cleo 404",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The page you are looking for does not exist.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Back to home"
    }
  ],
  "presets": [
    {
      "name": "Cleo 404"
    }
  ]
}
{% endschema %}
