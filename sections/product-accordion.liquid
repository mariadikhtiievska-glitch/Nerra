{% comment %}
  Product Accordion Section
  - Responsive accordion layout matching the supplied reference.
  - The "Product specifications" block can automatically display product.description.
  - Other blocks use editable rich text.
{% endcomment %}

<section
  id="ProductAccordion-{{ section.id }}"
  class="pa-section"
  style="
    --pa-background: {{ section.settings.background_color }};
    --pa-card-background: {{ section.settings.card_background }};
    --pa-text-color: {{ section.settings.text_color }};
    --pa-icon-background: {{ section.settings.icon_background }};
    --pa-border-color: {{ section.settings.border_color }};
    --pa-max-width: {{ section.settings.max_width }}px;
    --pa-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="pa-container">
    <div class="pa-list">
      {% for block in section.blocks %}
        {% liquid
          assign item_content = block.settings.content
          if block.settings.use_product_description
            assign item_content = product.description
          endif
        %}

        <details
          class="pa-item"
          {% if block.settings.open_by_default %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="pa-summary">
            <span class="pa-heading">
              <span class="pa-icon-box" aria-hidden="true">
                {% if block.settings.custom_icon != blank %}
                  {{
                    block.settings.custom_icon
                    | image_url: width: 80
                    | image_tag:
                      loading: 'lazy',
                      widths: '20, 40, 60, 80',
                      sizes: '22px',
                      class: 'pa-custom-icon',
                      alt: ''
                  }}
                {% else %}
                  {% case block.settings.icon %}
                    {% when 'award' %}
                      <svg class="pa-icon" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="8" r="4.5"></circle>
                        <path d="M9.2 12.1 8.4 20l3.6-2.2 3.6 2.2-.8-7.9"></path>
                      </svg>

                    {% when 'shield' %}
                      <svg class="pa-icon" viewBox="0 0 24 24" fill="none">
                        <path d="M12 3 19 6v5.2c0 4.6-2.9 7.8-7 9.8-4.1-2-7-5.2-7-9.8V6l7-3Z"></path>
                      </svg>

                    {% when 'sparkles' %}
                      <svg class="pa-icon" viewBox="0 0 24 24" fill="none">
                        <path d="M12 3c.5 4.4 2.1 6 6.5 6.5C14.1 10 12.5 11.6 12 16c-.5-4.4-2.1-6-6.5-6.5C9.9 9 11.5 7.4 12 3Z"></path>
                        <path d="M18.5 15.5c.2 1.9.9 2.6 2.8 2.8-1.9.2-2.6.9-2.8 2.8-.2-1.9-.9-2.6-2.8-2.8 1.9-.2 2.6-.9 2.8-2.8Z"></path>
                        <path d="M5.2 3.8c.15 1.3.65 1.8 1.95 1.95-1.3.15-1.8.65-1.95 1.95-.15-1.3-.65-1.8-1.95-1.95C4.55 5.6 5.05 5.1 5.2 3.8Z"></path>
                      </svg>

                    {% when 'truck' %}
                      <svg class="pa-icon" viewBox="0 0 24 24" fill="none">
                        <path d="M3 6h11v10H3z"></path>
                        <path d="M14 10h3.5l3 3v3H14z"></path>
                        <circle cx="7" cy="18" r="2"></circle>
                        <circle cx="18" cy="18" r="2"></circle>
                      </svg>

                    {% when 'heart' %}
                      <svg class="pa-icon" viewBox="0 0 24 24" fill="none">
                        <path d="M20.8 5.7a5.4 5.4 0 0 0-7.6 0L12 6.9l-1.2-1.2a5.4 5.4 0 1 0-7.6 7.6L12 22l8.8-8.7a5.4 5.4 0 0 0 0-7.6Z"></path>
                      </svg>

                    {% when 'leaf' %}
                      <svg class="pa-icon" viewBox="0 0 24 24" fill="none">
                        <path d="M20.5 3.5C12 3.8 6.5 7.2 5.2 13.2c-.8 3.7 1.5 6.8 5.2 6.3 6.3-.9 9.1-7.4 10.1-16Z"></path>
                        <path d="M5 21c2.5-6 6.4-9.7 12-12.2"></path>
                      </svg>

                    {% else %}
                      <svg class="pa-icon" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v8M8 12h8"></path>
                      </svg>
                  {% endcase %}
                {% endif %}
              </span>

              <span class="pa-title">{{ block.settings.title | escape }}</span>
            </span>

            <svg class="pa-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="m2 4.25 4 4 4-4"></path>
            </svg>
          </summary>

          <div class="pa-content">
            <div class="pa-content-inner rte">
              {% if block.settings.use_product_description %}
                {% if product != blank and product.description != blank %}
                  {{ product.description }}
                {% elsif request.design_mode %}
                  <p>
                    The product description will appear here on a product page.
                    Add content in Shopify Admin → Products → Description.
                  </p>
                {% endif %}
              {% else %}
                {{ block.settings.content }}
              {% endif %}
            </div>
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% if section.settings.enable_faq_schema and section.blocks.size > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for block in section.blocks %}
          {% liquid
            assign schema_answer = block.settings.content
            if block.settings.use_product_description
              assign schema_answer = product.description
            endif
          %}
          {
            "@type": "Question",
            "name": {{ block.settings.title | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ schema_answer | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

<style>
  #ProductAccordion-{{ section.id }} {
    width: 100%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--pa-background);
    border-top: 1px solid var(--pa-border-color);
    color: var(--pa-text-color);
  }

  #ProductAccordion-{{ section.id }} * {
    box-sizing: border-box;
  }

  #ProductAccordion-{{ section.id }} .pa-container {
    width: min(calc(100% - 32px), var(--pa-max-width));
    margin: 0 auto;
  }

  #ProductAccordion-{{ section.id }} .pa-list {
    display: grid;
    gap: {{ section.settings.item_gap }}px;
  }

  #ProductAccordion-{{ section.id }} .pa-item {
    overflow: hidden;
    margin: 0;
    background: var(--pa-card-background);
    border-radius: var(--pa-radius);
  }

  #ProductAccordion-{{ section.id }} .pa-summary {
    min-height: 52px;
    padding: 10px 39px 10px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    list-style: none;
    color: var(--pa-text-color);
    -webkit-tap-highlight-color: transparent;
  }

  #ProductAccordion-{{ section.id }} .pa-summary::-webkit-details-marker {
    display: none;
  }

  #ProductAccordion-{{ section.id }} .pa-heading {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #ProductAccordion-{{ section.id }} .pa-icon-box {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 8px;
    background: var(--pa-icon-background);
  }

  #ProductAccordion-{{ section.id }} .pa-icon,
  #ProductAccordion-{{ section.id }} .pa-custom-icon {
    width: 21px;
    height: 21px;
    display: block;
  }

  #ProductAccordion-{{ section.id }} .pa-icon {
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #ProductAccordion-{{ section.id }} .pa-custom-icon {
    object-fit: contain;
  }

  #ProductAccordion-{{ section.id }} .pa-title {
    min-width: 0;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  #ProductAccordion-{{ section.id }} .pa-chevron {
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }

  #ProductAccordion-{{ section.id }} .pa-item[open] .pa-chevron {
    transform: rotate(180deg);
  }

  #ProductAccordion-{{ section.id }} .pa-content {
    padding: 0 40px 26px 88px;
  }

  #ProductAccordion-{{ section.id }} .pa-content-inner {
    font-size: {{ section.settings.content_size }}px;
    line-height: 1.65;
    color: var(--pa-text-color);
  }

  #ProductAccordion-{{ section.id }} .pa-content-inner > :first-child {
    margin-top: 4px;
  }

  #ProductAccordion-{{ section.id }} .pa-content-inner > :last-child {
    margin-bottom: 0;
  }

  #ProductAccordion-{{ section.id }} .pa-content-inner p,
  #ProductAccordion-{{ section.id }} .pa-content-inner ul,
  #ProductAccordion-{{ section.id }} .pa-content-inner ol {
    margin-top: 0;
    margin-bottom: 12px;
  }

  #ProductAccordion-{{ section.id }} .pa-content-inner a {
    color: inherit;
    text-underline-offset: 3px;
  }

  #ProductAccordion-{{ section.id }} .pa-summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -3px;
    border-radius: var(--pa-radius);
  }

  @media screen and (max-width: 749px) {
    #ProductAccordion-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #ProductAccordion-{{ section.id }} .pa-container {
      width: min(calc(100% - 24px), var(--pa-max-width));
    }

    #ProductAccordion-{{ section.id }} .pa-summary {
      min-height: 58px;
      padding: 10px 16px;
      gap: 14px;
    }

    #ProductAccordion-{{ section.id }} .pa-heading {
      gap: 12px;
    }

    #ProductAccordion-{{ section.id }} .pa-title {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #ProductAccordion-{{ section.id }} .pa-content {
      padding: 0 16px 22px;
    }

    #ProductAccordion-{{ section.id }} .pa-content-inner {
      font-size: {{ section.settings.mobile_content_size }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ProductAccordion-{{ section.id }} .pa-chevron {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Product accordions",
  "tag": "section",
  "class": "section-product-accordions",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 700,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between accordions",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "header",
      "content": "Desktop typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "content_size",
      "label": "Content size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Mobile typography"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 21,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_content_size",
      "label": "Content size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F2E8DA"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Accordion background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and icon color",
      "default": "#96512D"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#F5F3F0"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Top border",
      "default": "#D7C9B8"
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "label": "Enable FAQ structured data",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Accordion heading"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "default": "award",
          "options": [
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "sparkles",
              "label": "Sparkles"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "plus",
              "label": "Plus"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Overrides the built-in icon."
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Show product description",
          "info": "Enable this for Product specifications. It outputs the current product's Description field.",
          "default": false
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add accordion content here.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Product accordions",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "title": "Product specifications",
            "icon": "award",
            "use_product_description": true
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Is it safe?",
            "icon": "shield"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "What Can I Expect?",
            "icon": "sparkles"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Shipping & Returns",
            "icon": "truck"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Our Promise To You",
            "icon": "heart"
          }
        }
      ]
    }
  ]
}
{% endschema %}
