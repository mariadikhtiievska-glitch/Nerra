<div
  id="ClsCoppercutopenStickyBar-{{ section.id }}"
  class="cls-coppercutopen-sticky-bar"
  data-cls-coppercutopen-sticky-bar
>
  <a
    class="cls-coppercutopen-sticky-bar__button"
    href="{{ section.settings.button_url | default: '#' }}"
  >
    {{ section.settings.button_label | escape }}
  </a>
</div>

{% schema %}
{
  "name": "Sticky bar",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CHECK AVAILABILITY 👉"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ]
}
{% endschema %}
