<div id="ClsCopperwater10Hero-{{ section.id }}" class="cls-copperwater10-hero">
  <div class="cls-copperwater10-hero__inner">
    <div class="cls-copperwater10-hero__text">
      {%- if section.settings.heading != blank -%}
        <h1 class="cls-copperwater10-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.subhead != blank -%}
        <p class="cls-copperwater10-hero__subhead">{{ section.settings.subhead | escape }}</p>
      {%- endif -%}
    </div>

    <div class="cls-copperwater10-hero__card cls-copperwater10-card cls-copperwater10-card--dark">
      <div class="cls-copperwater10-card__image">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="{{ section.settings.image | image_url: width: 450 }} 450w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1280 }} 1280w"
            sizes="(min-width: 768px) 500px, calc(100vw - 76px)"
            alt="{{ section.settings.image.alt | default: section.settings.card_headline | escape }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- elsif section.settings.image_fallback != blank -%}
          <img
            src="{{ section.settings.image_fallback | asset_url }}"
            srcset="{{ section.settings.image_fallback | replace: '.jpg', '-450.jpg' | asset_url }} 450w, {{ section.settings.image_fallback | replace: '.jpg', '-900.jpg' | asset_url }} 900w, {{ section.settings.image_fallback | asset_url }} 1280w"
            sizes="(min-width: 768px) 500px, calc(100vw - 76px)"
            alt="{{ section.settings.card_headline | escape }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>

      <div class="cls-copperwater10-card__text">
        {%- if section.settings.card_headline != blank -%}
          <p class="cls-copperwater10-card__headline">{{ section.settings.card_headline | escape }}</p>
        {%- endif -%}
        {%- if section.settings.card_line != blank -%}
          <p class="cls-copperwater10-card__line">{{ section.settings.card_line | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.quote != blank -%}
      <div class="cls-copperwater10-hero__quote">
        <figure class="cls-copperwater10-quote__card">
          {%- if section.settings.stars > 0 -%}
            <p class="cls-copperwater10-quote__stars" aria-label="{{ section.settings.stars }} out of 5 stars">
              {%- for i in (1..section.settings.stars) -%}★{%- endfor -%}
            </p>
          {%- endif -%}

          {%- if section.settings.quote != blank -%}
            <blockquote class="cls-copperwater10-quote__text">
              <p>{{ section.settings.quote | escape }}</p>
            </blockquote>
          {%- endif -%}

          <figcaption class="cls-copperwater10-quote__reviewer">
            <span class="cls-copperwater10-quote__avatar">
              {%- if section.settings.avatar != blank -%}
                <img
                  src="{{ section.settings.avatar | image_url: width: 80, height: 80, crop: 'center' }}"
                  srcset="{{ section.settings.avatar | image_url: width: 80, height: 80, crop: 'center' }} 1x, {{ section.settings.avatar | image_url: width: 160, height: 160, crop: 'center' }} 2x"
                  alt="{{ section.settings.avatar.alt | default: section.settings.reviewer_name | escape }}"
                  width="40"
                  height="40"
                  loading="lazy"
                >
              {%- elsif section.settings.avatar_fallback != blank -%}
                <img
                  src="{{ section.settings.avatar_fallback | replace: '.jpg', '-80.jpg' | asset_url }}"
                  srcset="{{ section.settings.avatar_fallback | replace: '.jpg', '-80.jpg' | asset_url }} 1x, {{ section.settings.avatar_fallback | asset_url }} 2x"
                  alt="{{ section.settings.reviewer_name | escape }}"
                  width="40"
                  height="40"
                  loading="lazy"
                >
              {%- endif -%}
            </span>
            <span class="cls-copperwater10-quote__attribution">
              {%- if section.settings.reviewer_name != blank -%}
                <span class="cls-copperwater10-quote__name">{{ section.settings.reviewer_name | escape }}</span>
              {%- endif -%}
              {%- if section.settings.reviewer_name != blank and section.settings.reviewer_label != blank -%}
                <span class="cls-copperwater10-quote__separator" aria-hidden="true">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
              {%- endif -%}
              {%- if section.settings.reviewer_label != blank -%}
                <span class="cls-copperwater10-quote__label">{{ section.settings.reviewer_label | escape }}</span>
              {%- endif -%}
            </span>
          </figcaption>
        </figure>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead"
    },
    {
      "type": "header",
      "content": "Image card"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_fallback",
      "label": "Image fallback asset",
      "info": "Theme asset used when no image is picked above."
    },
    {
      "type": "text",
      "id": "card_headline",
      "label": "Card headline"
    },
    {
      "type": "text",
      "id": "card_line",
      "label": "Card line"
    },
    {
      "type": "header",
      "content": "Customer quote"
    },
    {
      "type": "paragraph",
      "content": "Shown below the image card on mobile and under the subhead on desktop. Leave the quote blank to hide it."
    },
    {
      "type": "range",
      "id": "stars",
      "label": "Star rating",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Reviewer photo",
      "info": "Square crop, shown as a 40px circle."
    },
    {
      "type": "text",
      "id": "avatar_fallback",
      "label": "Reviewer photo fallback asset",
      "info": "Theme asset used when no photo is picked above."
    },
    {
      "type": "text",
      "id": "reviewer_name",
      "label": "Reviewer name"
    },
    {
      "type": "text",
      "id": "reviewer_label",
      "label": "Reviewer label"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
