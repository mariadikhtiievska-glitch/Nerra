<section
  id="CleoBenefits-{{ section.id }}"
  class="cleo-benefits-section"
  style="
    --benefits-bg: {{ section.settings.background_color }};
    --benefits-color: {{ section.settings.text_color }};
    --benefits-heading: {{ section.settings.heading_color }};
    --benefits-separator: {{ section.settings.separator_color }};
    --benefits-width: {{ section.settings.max_width }}px;
    --benefits-columns: {{ section.settings.columns }};
    --benefits-tablet-columns: {{ section.settings.tablet_columns }};
    --benefits-mobile-columns: {{ section.settings.mobile_columns }};
    --benefits-gap: {{ section.settings.gap }}px;
    --benefits-icon-size: {{ section.settings.icon_size }}px;
    --benefits-mobile-icon-size: {{ section.settings.mobile_icon_size }}px;
    --benefits-heading-size: {{ section.settings.heading_size }}px;
    --benefits-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --benefits-text-size: {{ section.settings.text_size }}px;
    --benefits-mobile-text-size: {{ section.settings.mobile_text_size }}px;
    --benefits-padding-top: {{ section.settings.padding_top }}px;
    --benefits-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cleo-benefits-section__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="cleo-benefits-section__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="cleo-benefits-section__grid">
      {%- for block in section.blocks -%}
        <article class="cleo-benefit-item{% if section.settings.show_separators %} cleo-benefit-item--separated{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.fallback_asset != blank -%}
            <div class="cleo-benefit-item__icon">
              {%- render 'cleo-image',
                image: block.settings.image,
                asset: block.settings.fallback_asset,
                width: 240,
                height: 240,
                sizes: '100px',
                alt: block.settings.heading
              -%}
            </div>
          {%- elsif block.settings.icon_text != blank -%}
            <div class="cleo-benefit-item__icon cleo-benefit-item__icon--text">{{ block.settings.icon_text }}</div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="cleo-benefit-item__description">{{ block.settings.text | newline_to_br }}</div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #CleoBenefits-{{ section.id }} {
    padding-block: var(--benefits-padding-top) var(--benefits-padding-bottom);
    background: var(--benefits-bg);
    color: var(--benefits-color);
  }

  #CleoBenefits-{{ section.id }} .cleo-benefits-section__container {
    width: min(var(--benefits-width), calc(100% - 40px));
    margin-inline: auto;
  }

  #CleoBenefits-{{ section.id }} .cleo-benefits-section__title {
    margin: 0 0 34px;
    color: var(--benefits-heading);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  #CleoBenefits-{{ section.id }} .cleo-benefits-section__grid {
    display: grid;
    grid-template-columns: repeat(var(--benefits-columns), minmax(0, 1fr));
    gap: var(--benefits-gap);
    text-align: center;
  }

  #CleoBenefits-{{ section.id }} .cleo-benefit-item {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
  }

  #CleoBenefits-{{ section.id }} .cleo-benefit-item--separated:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 50%;
    right: calc(var(--benefits-gap) / -2);
    width: 1px;
    height: 70px;
    background: var(--benefits-separator);
    transform: translateY(-50%);
  }

  #CleoBenefits-{{ section.id }} .cleo-benefit-item__icon {
    width: var(--benefits-icon-size);
    height: var(--benefits-icon-size);
    margin-bottom: 8px;
  }

  #CleoBenefits-{{ section.id }} .cleo-benefit-item__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #CleoBenefits-{{ section.id }} .cleo-benefit-item__icon--text {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff7ee;
    color: var(--benefits-heading);
    font-size: 28px;
    font-weight: 800;
  }

  #CleoBenefits-{{ section.id }} .cleo-benefit-item h3 {
    margin: 0 0 4px;
    color: var(--benefits-heading);
    font-size: var(--benefits-heading-size);
    font-weight: 600;
    line-height: 1.2;
  }

  #CleoBenefits-{{ section.id }} .cleo-benefit-item__description {
    color: var(--benefits-color);
    font-size: 20px;
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    #CleoBenefits-{{ section.id }} .cleo-benefits-section__grid {
      grid-template-columns: repeat(var(--benefits-tablet-columns), minmax(0, 1fr));
    }

    #CleoBenefits-{{ section.id }} .cleo-benefit-item--separated::after {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    #CleoBenefits-{{ section.id }} {
      padding-block: 32px;
    }

    #CleoBenefits-{{ section.id }} .cleo-benefits-section__container {
      width: calc(100% - 32px);
    }

    #CleoBenefits-{{ section.id }} .cleo-benefits-section__title {
      margin-bottom: 24px;
      font-size: 24px;
    }

    #CleoBenefits-{{ section.id }} .cleo-benefits-section__grid {
      grid-template-columns: repeat(var(--benefits-mobile-columns), minmax(0, 1fr));
      gap: 20px;
    }

    #CleoBenefits-{{ section.id }} .cleo-benefit-item--separated:nth-child(odd)::after {
      display: block;
      right: -10px;
      height: 60px;
    }

    #CleoBenefits-{{ section.id }} .cleo-benefit-item__icon {
      width: var(--benefits-mobile-icon-size);
      height: var(--benefits-mobile-icon-size);
    }

    #CleoBenefits-{{ section.id }} .cleo-benefit-item h3 {
      font-size: var(--benefits-mobile-heading-size);
    }

    #CleoBenefits-{{ section.id }} .cleo-benefit-item__description {
      font-size: var(--benefits-mobile-text-size);
    }
  }
</style>

{% schema %}
{
  "name": "Cleo benefits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3e9dc" },
    { "type": "color", "id": "text_color", "label": "Description color", "default": "#6b6158" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#4e222d" },
    { "type": "color", "id": "separator_color", "label": "Separator color", "default": "#e3d3c2" },
    { "type": "checkbox", "id": "show_separators", "label": "Show separators", "default": true },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 760, "max": 1600, "step": 20, "unit": "px", "default": 1000 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "tablet_columns", "label": "Tablet columns", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "mobile_columns", "label": "Mobile columns", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "gap", "label": "Desktop gap", "min": 8, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "icon_size", "label": "Desktop icon size", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "mobile_icon_size", "label": "Mobile icon size", "min": 36, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "text_size", "label": "Desktop text size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_text_size", "label": "Mobile text size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" },
        { "type": "text", "id": "icon_text", "label": "Fallback icon text" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Pure Copper" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Lab Tested 99.9% Pure Food Grade Copper" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cleo benefits",
      "blocks": [
        { "type": "benefit", "settings": { "fallback_asset": "cleo-static-bdcccf9367f6.png", "heading": "Pure Copper", "text": "Lab Tested 99.9% Pure Food Grade Copper" } },
        { "type": "benefit", "settings": { "fallback_asset": "cleo-static-529af8e3ffbc.png", "heading": "Better Hydration", "text": "Makes Water Alkaline and Naturally Anti-microbial" } },
        { "type": "benefit", "settings": { "fallback_asset": "cleo-static-b4ad7f07384d.png", "heading": "Handcrafted", "text": "Hand-Hammered to Preserve Contact Area with Water" } },
        { "type": "benefit", "settings": { "fallback_asset": "cleo-static-960b63633c72.png", "heading": "Eco-Friendly", "text": "Reusable and Helps You Reduce Single-Use Plastic" } }
      ]
    }
  ]
}
{% endschema %}
