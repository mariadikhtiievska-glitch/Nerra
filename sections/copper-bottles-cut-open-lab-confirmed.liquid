<div id="ClsCoppercutopenLabConfirmed-{{ section.id }}" class="cls-coppercutopen-lab-confirmed">
  <div class="cls-coppercutopen-lab-confirmed__inner">
    <div class="cls-coppercutopen-lab-confirmed__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="cls-coppercutopen-lab-confirmed__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="cls-coppercutopen-lab-confirmed__body cls-coppercutopen-rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <a class="cls-coppercutopen-lab-confirmed__link" href="{{ section.settings.link_url | default: '#' }}">
          <span>{{ section.settings.link_label | escape }}</span>
          <span aria-hidden="true">↓</span>
        </a>
      {%- endif -%}
    </div>

    <div class="cls-coppercutopen-lab-confirmed__photo">
      {%- if section.settings.photo != blank -%}
        <img
          src="{{ section.settings.photo | image_url: width: 1280 }}"
          srcset="
            {{ section.settings.photo | image_url: width: 450 }} 450w,
            {{ section.settings.photo | image_url: width: 900 }} 900w,
            {{ section.settings.photo | image_url: width: 1280 }} 1280w
          "
          sizes="100vw"
          alt="{{ section.settings.photo.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.photo.width }}"
          height="{{ section.settings.photo.height }}"
        >
      {%- elsif section.settings.photo_fallback != blank -%}
        <img
          src="{{ section.settings.photo_fallback | replace: '.jpg', '-900.jpg' | asset_url }}"
          srcset="
            {{ section.settings.photo_fallback | replace: '.jpg', '-450.jpg' | asset_url }} 450w,
            {{ section.settings.photo_fallback | replace: '.jpg', '-900.jpg' | asset_url }} 900w,
            {{ section.settings.photo_fallback | asset_url }} 1280w
          "
          sizes="100vw"
          alt="Lab reports on the teardown bench"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "What the lab confirmed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "I didn’t want this to be my opinion"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>A photograph of a cut bottle shows you there is a second metal in the wall. It does not tell you which metal, in what proportion, or whether anything else came along with it.</p><p>So one sample from each of the ten bottles went to CALIMP for composition analysis — copper percentage, lead, zinc, cadmium. The same parameters the better sellers in this category publish, so the numbers are comparable.</p><p>For reference, a properly made copper bottle reports around <strong>99.5%</strong> or higher copper, lead roughly ten times under the <strong>FDA</strong> limit, and no detectable cadmium. That is the bar. It is not a hard bar to hit if you are making the bottle out of copper.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Document link label",
      "default": ""
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Document link URL"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "photo_fallback",
      "label": "Photo fallback filename",
      "info": "Used only if no photo is set above. Must be an asset filename already uploaded to this theme.",
      "default": "copper-bottles-cut-open-lab-reports.jpg"
    }
  ],
  "presets": [
    {
      "name": "What the lab confirmed"
    }
  ]
}
{% endschema %}
