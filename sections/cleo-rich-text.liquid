<style data-cleo-component-css="richText">
  .cleo-section-heading {
    margin: 0 0 var(--cleo-heading-gap, 28px);
    color: var(--cleo-heading-color, var(--cleo-copper));
    font-size: var(--cleo-heading-size, 32px);
    line-height: 1.14;
    font-weight: 800;
    text-align: var(--cleo-heading-align, center);
  }
</style>

<section
  class="cleo-section"
  style="
    --cleo-section-bg: {{ section.settings.background_color }};
    --cleo-padding-top: {{ section.settings.padding_top }}px;
    --cleo-padding-bottom: {{ section.settings.padding_bottom }}px;
    --cleo-rich-width: {{ section.settings.content_width }}px;
    --cleo-rich-align: {{ section.settings.text_alignment }};
  "
>
  <div class="cleo-container">
    <div class="cleo-rich-text">
      {%- if section.settings.heading != blank -%}
        <h2 class="cleo-section-heading" style="--cleo-heading-align: {{ section.settings.text_alignment }};">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div>{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a class="cleo-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cleo rich text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Copper?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Inspired by the centuries-old Ayurvedic practice of Tamra Jal, storing water in pure copper vessels is a ritual designed to transform basic hydration into an intentional wellness choice.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 420,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Cleo rich text"
    }
  ]
}
{% endschema %}
