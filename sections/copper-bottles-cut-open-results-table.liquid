<div id="ClsCoppercutopenResultsTable-{{ section.id }}" class="cls-coppercutopen-results-table">
  <div class="cls-coppercutopen-results-table__inner">
    {%- if section.settings.block_label != blank -%}
      <p class="cls-coppercutopen-results-table__eyebrow">{{ section.settings.block_label | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="cls-coppercutopen-results-table__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <p class="cls-coppercutopen-results-table__swipe-hint" aria-hidden="true">Swipe to see more →</p>

    <div class="cls-coppercutopen-results-table__scroll">
      <table class="cls-coppercutopen-results-table__table">
        <thead>
          <tr>
            <th>#</th>
            <th>Paid</th>
            <th>Listing Claimed</th>
            <th>Magnet</th>
            <th>Interior</th>
            <th>Lab Result</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }} {% if block.settings.highlight %}class="cls-coppercutopen-results-table__row--highlight"{% endif %}>
              <td>{{ block.settings.number | escape }}</td>
              <td>{{ block.settings.paid | escape }}</td>
              <td>{{ block.settings.listing_claimed | escape }}</td>
              <td>{{ block.settings.magnet | escape }}</td>
              <td>{{ block.settings.interior | escape }}</td>
              <td>{{ block.settings.lab_result | escape }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.footer_note != blank -%}
      <p class="cls-coppercutopen-results-table__footer-note">{{ section.settings.footer_note | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Results table",
  "settings": [
    {
      "type": "text",
      "id": "block_label",
      "label": "Block label (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All ten results"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footer note (optional)",
      "default": "Bottle 10 is the expensive one I bought as a control. More on that further down. Lab reports for all ten are linked at the bottom of this page."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "#"
        },
        {
          "type": "text",
          "id": "paid",
          "label": "Paid"
        },
        {
          "type": "text",
          "id": "listing_claimed",
          "label": "Listing claimed"
        },
        {
          "type": "text",
          "id": "magnet",
          "label": "Magnet"
        },
        {
          "type": "text",
          "id": "interior",
          "label": "Interior"
        },
        {
          "type": "text",
          "id": "lab_result",
          "label": "Lab result"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this row",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}
