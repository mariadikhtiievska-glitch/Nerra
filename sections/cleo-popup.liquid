<style data-cleo-component-css="popup">
  .cleo-popup {
    z-index: 200;
    padding: 20px;
    background: rgba(32, 24, 20, 0.45);
  }
  
  .cleo-popup__panel {
    width: min(520px, 100%);
    border: 1px solid rgba(137, 87, 55, 0.18);
    border-radius: 14px;
    background:
      radial-gradient(circle at 0 0, rgba(137, 87, 55, 0.16), transparent 34%),
      var(--cleo-popup-bg, var(--cleo-white));
    color: var(--cleo-popup-color, var(--cleo-copper-dark));
    box-shadow: var(--cleo-shadow);
  }
  
  .cleo-popup__close {
    top: 10px;
    right: 10px;
    z-index: 2;
    border: 0;
    width: 34px;
    height: 34px;
    background: rgba(255, 255, 255, 0.78);
    color: currentColor;
    font-size: 22px;
  }
  
  .cleo-popup__body {
    padding: 34px 30px 30px;
  }
  
  .cleo-popup__eyebrow {
    color: var(--cleo-copper);
  }
  
  .cleo-popup__mark {
    background: var(--cleo-copper);
    color: var(--cleo-white);
  }
  
  .cleo-popup__body h2 {
    margin: 0 0 12px;
    color: currentColor;
    font-size: clamp(28px, 5vw, 42px);
    line-height: 1.05;
  }
  
  .cleo-popup__text {
    color: var(--cleo-muted);
  }
  
  .cleo-popup__code {
    display: grid;
    gap: 4px;
    width: 100%;
    margin: 20px 0;
    border: 1px dashed var(--cleo-copper);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.62);
    color: var(--cleo-copper);
    padding: 13px 16px;
    cursor: pointer;
  }
  
  .cleo-popup__code span {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  
  .cleo-popup__code small {
    color: var(--cleo-muted);
    font-weight: 700;
  }
  
  .cleo-popup {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: none;
    place-items: center;
    padding: 24px;
    background: rgba(18, 16, 14, 0.58);
    backdrop-filter: blur(1px);
  }
  
  .cleo-popup.is-open {
    display: grid;
  }
  
  .cleo-popup__panel {
    width: min(960px, calc(100vw - 48px));
    aspect-ratio: 16 / 9;
    min-height: auto;
    max-height: calc(100vh - 72px);
    border: 0;
    border-radius: 0;
    overflow: hidden;
    background: var(--cleo-popup-bg, #ead0be);
    color: var(--cleo-popup-color, #4f392b);
    box-shadow: 0 18px 50px rgba(24, 16, 10, 0.28);
    position: relative;
  }
  
  .cleo-popup__background {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    user-select: none;
    pointer-events: none;
  }
  
  .cleo-popup__close {
    position: absolute;
    top: 22px;
    right: 36px;
    z-index: 7;
    border: 2px solid currentColor;
    border-radius: 50%;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--cleo-popup-color, #4f392b);
    cursor: pointer;
    font-size: 31px;
    font-weight: 400;
    line-height: 1;
    display: grid;
    place-items: center;
    padding: 0;
  }
  
  .cleo-popup__close:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }
  
  .cleo-popup__body {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    text-align: center;
    pointer-events: none;
  }
  
  .cleo-popup__body::before {
    content: none;
  }
  
  .cleo-popup__background,
  .cleo-popup__art,
  .cleo-popup__candle,
  .cleo-popup__logo {
    user-select: none;
    pointer-events: none;
  }
  
  .cleo-popup__art {
    position: absolute;
    z-index: 2;
    display: block;
  }
  
  .cleo-popup__art--left {
    left: 0;
    bottom: 0;
    width: 34%;
    height: 100%;
    object-fit: cover;
    object-position: left bottom;
    clip-path: inset(0 2% 0 0);
  }
  
  .cleo-popup__art--right {
    right: 0;
    bottom: 0;
    width: 28%;
    height: 72%;
    object-fit: contain;
    object-position: right bottom;
  }
  
  .cleo-popup__candle {
    position: absolute;
    top: 64px;
    right: 68px;
    z-index: 3;
    width: 98px;
    height: auto;
    filter: drop-shadow(0 2px 5px rgba(81, 47, 28, 0.18));
    display: block;
  }
  
  .cleo-popup__logo {
    position: absolute;
    top: 7%;
    left: 50%;
    z-index: 6;
    width: 112px;
    height: auto;
    margin: 0;
    opacity: 0.82;
    display: block;
    transform: translateX(-50%);
  }
  
  .cleo-popup__eyebrow {
    margin: 0 0 10px;
    color: #895737;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  
  .cleo-popup__mark {
    display: inline-grid;
    place-items: center;
    width: 82px;
    height: 82px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: #895737;
    color: #ffffff;
    font-size: 25px;
    font-weight: 900;
  }
  
  .cleo-popup__body h2 {
    position: absolute;
    top: 29%;
    left: 50%;
    width: 42%;
    margin: 0;
    color: var(--cleo-popup-color, #4f392b);
    font-size: 52px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.02;
    text-transform: uppercase;
    transform: translateX(-50%);
  }
  
  .cleo-popup__body h2 span {
    display: block;
    font-weight: 400;
  }
  
  .cleo-popup__body h2 strong {
    display: block;
    margin-top: 8px;
    font-size: 58px;
    font-weight: 700;
  }
  
  .cleo-popup__subheading {
    position: absolute;
    top: 53.5%;
    left: 50%;
    width: 38.6%;
    margin: 0;
    color: var(--cleo-popup-color, #4f392b);
    font-size: 23px;
    line-height: 1.1;
    transform: translateX(-50%);
  }
  
  .cleo-popup__text {
    color: #7b675a;
    line-height: 1.55;
  }
  
  .cleo-popup__form {
    position: absolute;
    left: 50%;
    top: 62.4%;
    width: 38.6%;
    min-width: 280px;
    max-width: 370px;
    display: grid;
    gap: 20px;
    margin: 0;
    transform: translateX(-50%);
    pointer-events: auto;
  }
  
  .cleo-popup__email {
    width: 100%;
    height: 54px;
    border: 1px solid var(--cleo-popup-color, #4f392b);
    border-radius: 999px;
    background: transparent;
    color: #4f392b;
    padding: 0 28px;
    text-align: center;
    font-size: 22px;
    line-height: 1;
    outline: none;
  }
  
  .cleo-popup__email::placeholder {
    color: #ffffff;
    opacity: 1;
  }
  
  .cleo-popup__email:focus {
    border-color: var(--cleo-popup-color, #4f392b);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.72);
  }
  
  .cleo-popup__submit {
    width: 100%;
    height: 54px;
    border: 0;
    border-radius: 999px;
    background: var(--cleo-popup-button-bg, #5a4228);
    color: var(--cleo-popup-button-color, #ffffff);
    cursor: pointer;
    font-size: 24px;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  
  .cleo-popup__submit:hover {
    transform: translateY(-1px);
    background: var(--cleo-popup-button-bg, #5a4228);
  }
  
  .cleo-popup__decline {
    position: absolute;
    left: 50%;
    top: 90.2%;
    width: 190px;
    height: 34px;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--cleo-popup-color, #4f392b);
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    transform: translateX(-50%);
    pointer-events: auto;
  }
  
  .cleo-popup-tab {
    position: fixed;
    right: 0;
    top: 50%;
    z-index: 1900;
    display: none;
    transform: translateY(-50%);
  }
  
  .cleo-popup-tab.is-visible {
    display: block;
  }
  
  .cleo-popup-tab__open {
    width: 68px;
    height: 136px;
    border: 0;
    border-radius: 14px 0 0 14px;
    background: #5a4228;
    color: #fff;
    cursor: pointer;
    box-shadow: 0 12px 26px rgba(31, 21, 14, 0.24);
    display: grid;
    place-items: center;
  }
  
  .cleo-popup-tab__open span {
    display: block;
    width: 77px;
    font-size: 19px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    transform: rotate(90deg);
    white-space: nowrap;
  }
  
  .cleo-popup-tab__close {
    position: absolute;
    left: -20px;
    bottom: 4px;
    width: 20px;
    height: 20px;
    border: 0;
    background: transparent;
    color: #4f392b;
    cursor: pointer;
    font-size: 19px;
    line-height: 1;
    padding: 0;
  }
  
  @media (max-width: 820px) {
  
  .cleo-popup {
      padding: 16px;
    }
  
  .cleo-popup__panel {
      width: min(520px, calc(100vw - 32px));
      min-height: auto;
      aspect-ratio: 16 / 9;
    }
  
  .cleo-popup__body {
      width: 100%;
      padding-top: 0;
    }
  
  .cleo-popup__body::before {
      inset: 34px -18px 8px;
      background: rgba(232, 199, 178, 0.74);
      border-radius: 20px;
      filter: blur(18px);
    }
  
  .cleo-popup__art--left {
      width: 54%;
      opacity: 0.72;
    }
  
  .cleo-popup__art--right {
      width: 40%;
      height: 56%;
      opacity: 0.78;
    }
  
  .cleo-popup__candle {
      top: 18px;
      right: 54px;
      width: 72px;
    }
  
  .cleo-popup__close {
      top: 18px;
      right: 16px;
      width: 36px;
      height: 36px;
      font-size: 24px;
    }
  
  .cleo-popup__logo {
      top: 6%;
      width: clamp(58px, 11vw, 98px);
    }
  
  .cleo-popup__body h2 {
      top: 28%;
      font-size: clamp(18px, 5vw, 39px);
    }
  
  .cleo-popup__body h2 strong {
      margin-top: clamp(2px, 0.8vw, 8px);
      font-size: clamp(22px, 6vw, 44px);
    }
  
  .cleo-popup__subheading {
      font-size: clamp(10px, 2.6vw, 21px);
    }
  
  .cleo-popup__email,
  .cleo-popup__submit {
      height: clamp(32px, 5.6vw, 52px);
      font-size: 20px;
    }
  
  .cleo-popup__form {
      width: 38.6%;
      min-width: 0;
      gap: clamp(10px, 2vw, 18px);
    }
  
  .cleo-popup__decline {
      font-size: clamp(9px, 2.1vw, 17px);
    }
  }
  
  @media (max-width: 600px) {
  
  .cleo-popup__panel {
      width: min(358px, calc(100vw - 32px));
      min-height: min(460px, calc(100svh - 32px));
      aspect-ratio: auto;
    }
  
  .cleo-popup__body::before {
      content: "";
      position: absolute;
      inset: 54px 30px 34px;
      z-index: -1;
      border-radius: 12px;
      background: rgba(234, 208, 190, 0.9);
      box-shadow: 0 8px 30px rgba(68, 43, 27, 0.12);
    }
  
  .cleo-popup__art--left {
      width: 58%;
      height: 100%;
      opacity: 0.5;
    }
  
  .cleo-popup__art--right {
      width: 50%;
      height: 56%;
      opacity: 0.62;
    }
  
  .cleo-popup__candle {
      top: 14px;
      right: 42px;
      width: 62px;
    }
  
  .cleo-popup__close {
      top: 12px;
      right: 12px;
      width: 32px;
      height: 32px;
      font-size: 21px;
    }
  
  .cleo-popup__logo {
      top: 11%;
      width: 88px;
    }
  
  .cleo-popup__body h2 {
      top: 25%;
      width: 78%;
      font-size: 31px;
    }
  
  .cleo-popup__body h2 strong {
      margin-top: 5px;
      font-size: 38px;
    }
  
  .cleo-popup__subheading {
      top: 45%;
      width: 70%;
      font-size: 17px;
    }
  
  .cleo-popup__form {
      top: 54%;
      width: 74%;
      max-width: none;
      gap: 12px;
    }
  
  .cleo-popup__email,
  .cleo-popup__submit {
      height: 44px;
      font-size: 16px;
    }
  
  .cleo-popup__decline {
      top: 81%;
      color: var(--cleo-popup-color, #4f392b);
      font-size: 14px;
    }
  }
</style>

{%- if section.settings.enabled -%}
  <div
    class="cleo-popup"
    data-cleo-popup="cleo-popup-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CleoPopupHeading-{{ section.id }}"
  >
    <div
      class="cleo-popup__panel"
      style="
        --cleo-popup-bg: {{ section.settings.background_color }};
        --cleo-popup-color: {{ section.settings.text_color }};
        --cleo-popup-button-bg: {{ section.settings.button_background }};
        --cleo-popup-button-color: {{ section.settings.button_text_color }};
      "
    >
      {%- if section.settings.background_image != blank -%}
        {%- render 'cleo-image',
          image: section.settings.background_image,
          width: 1920,
          height: 1080,
          sizes: '(min-width: 990px) 960px, calc(100vw - 32px)',
          alt: '',
          loading: 'eager',
          class: 'cleo-popup__background'
        -%}
      {%- endif -%}
      {%- render 'cleo-image',
        image: section.settings.left_image,
        asset: 'cleo-popup-woman-bottle.png',
        width: 690,
        height: 1080,
        sizes: '(min-width: 990px) 345px, 44vw',
        alt: '',
        loading: 'eager',
        class: 'cleo-popup__art cleo-popup__art--left'
      -%}
      {%- render 'cleo-image',
        image: section.settings.right_image,
        asset: 'cleo-popup-right-bottle-leaf.png',
        width: 512,
        height: 772,
        sizes: '(min-width: 990px) 256px, 34vw',
        alt: '',
        loading: 'eager',
        class: 'cleo-popup__art cleo-popup__art--right'
      -%}
      {%- render 'cleo-image',
        image: section.settings.candle_image,
        asset: 'cleo-popup-candle.png',
        width: 196,
        height: 192,
        sizes: '98px',
        alt: '',
        loading: 'eager',
        class: 'cleo-popup__candle'
      -%}

      <button class="cleo-popup__close" type="button" data-cleo-popup-close aria-label="Close">&times;</button>

      <div class="cleo-popup__body">
        {%- render 'cleo-image',
          image: section.settings.logo_image,
          asset: 'cleo-static-9f609c6ffb96.png',
          width: 224,
          height: 128,
          sizes: '112px',
          alt: shop.name,
          loading: 'eager',
          class: 'cleo-popup__logo'
        -%}

        <h2 id="CleoPopupHeading-{{ section.id }}">
          <span>{{ section.settings.heading }}</span>
          <strong>{{ section.settings.discount_heading }}</strong>
        </h2>

        {%- if section.settings.subheading != blank -%}
          <p class="cleo-popup__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- assign cleo_popup_form_id = 'CleoPopupNewsletter-' | append: section.id -%}
        {%- form 'customer', class: 'cleo-popup__form', id: cleo_popup_form_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          <label class="sr-only" for="CleoPopupEmail-{{ section.id }}">{{ section.settings.email_placeholder }}</label>
          <input
            id="CleoPopupEmail-{{ section.id }}"
            class="cleo-popup__email"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.email_placeholder | escape }}"
            autocomplete="email"
            required
          >
          <button class="cleo-popup__submit" type="submit">{{ section.settings.button_label }}</button>
        {%- endform -%}

        {%- if section.settings.decline_label != blank -%}
          <button class="cleo-popup__decline" type="button" data-cleo-popup-close>
            {{ section.settings.decline_label }}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="cleo-popup-tab" data-cleo-popup-tab="cleo-popup-{{ section.id }}" aria-hidden="true">
    <button class="cleo-popup-tab__open" type="button" data-cleo-popup-open="cleo-popup-{{ section.id }}" aria-label="Open {{ section.settings.tab_label | escape }} popup">
      <span>{{ section.settings.tab_label }}</span>
    </button>
    <button class="cleo-popup-tab__close" type="button" data-cleo-popup-tab-close aria-label="Hide offer tab">&times;</button>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cleo popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    },
    {
      "type": "image_picker",
      "id": "candle_image",
      "label": "Candle image"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You've got"
    },
    {
      "type": "text",
      "id": "discount_heading",
      "label": "Discount heading",
      "default": "10% off"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "your first order"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Claim 10% off"
    },
    {
      "type": "text",
      "id": "decline_label",
      "label": "Decline label",
      "default": "No thank you"
    },
    {
      "type": "text",
      "id": "tab_label",
      "label": "Side tab label",
      "default": "10% OFF"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ead0be"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4f392b"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#5a4228"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Cleo popup"
    }
  ]
}
{% endschema %}
