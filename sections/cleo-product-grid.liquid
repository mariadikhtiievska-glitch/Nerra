{%- liquid
  assign source_collection = section.settings.collection

  if source_collection == blank
    assign source_collection = collections['bestseller']
  endif

  if source_collection == blank or source_collection.products_count == 0
    assign source_collection = collections.all
  endif

  assign slider_id = 'CleoBestSellersTrack-' | append: section.id
  assign section_dom_id = 'CleoBestSellers-' | append: section.id

  assign desktop_gap_count = section.settings.columns | minus: 1
  assign desktop_gap_total = desktop_gap_count | times: section.settings.desktop_card_gap

  assign tablet_gap_count = section.settings.tablet_columns | minus: 1
  assign tablet_gap_total = tablet_gap_count | times: section.settings.tablet_card_gap

  assign mobile_gap_count = section.settings.mobile_columns | minus: 1
  assign mobile_gap_total = mobile_gap_count | times: section.settings.mobile_grid_gap
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color }};
  }

  #{{ section_dom_id }} {
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #{{ section_dom_id }} * {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .cleo-best-sellers__container {
    width: min(1240px, {{ section.settings.content_width }}px, calc(100% - 150px));
    margin-inline: auto;
  }

  #{{ section_dom_id }} .cleo-best-sellers__heading {
    margin: 0 0 36px;
    color: {{ section.settings.heading_color }};
    font-size: 44px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-align: {{ section.settings.heading_alignment }};
  }

  #{{ section_dom_id }} .cleo-best-sellers__panel {
    position: relative;
    padding: 30px 32px 32px;
    background: {{ section.settings.panel_color }};
  }

  #{{ section_dom_id }} .cleo-best-sellers__slider {
    position: relative;
  }

  #{{ section_dom_id }} .cleo-best-sellers__track {
    display: flex;
    gap: {{ section.settings.desktop_card_gap }}px;
    width: 100%;
    margin: 0;
    padding: 12px 2px 3px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2px;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #{{ section_dom_id }} .cleo-best-sellers__track::-webkit-scrollbar {
    display: none;
  }

  #{{ section_dom_id }} .product-card {
    display: flex;
    flex: 0 0 calc((100% - {{ desktop_gap_total }}px) / {{ section.settings.columns }});
    min-width: 0;
    flex-direction: column;
    gap: 0;
    color: {{ section.settings.text_color }};
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #{{ section_dom_id }} .product-card__figure {
    position: relative;
    width: 100%;
    margin: 0;
  }

  #{{ section_dom_id }} .product-card__media {
    position: relative;
    isolation: isolate;
    display: block;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
    background: #f8f2ea;
    box-shadow: 0 9px 22px rgba(84, 52, 35, 0.16);
  }

  #{{ section_dom_id }} .product-card__media::before,
  #{{ section_dom_id }} .product-card__media::after {
    pointer-events: none;
  }

  #{{ section_dom_id }} .product-card__media img,
  #{{ section_dom_id }} .product-card__media .product-card__image {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    object-fit: cover !important;
    object-position: center !important;
    border: 0 !important;
    opacity: 1;
    filter: none !important;
    mix-blend-mode: normal !important;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /*
    Primary image is visible normally.
    Secondary image replaces it completely on hover.
    This prevents both images from overlapping and looking faded.
  */
  #{{ section_dom_id }} .product-card__image--primary {
    z-index: 1 !important;
    opacity: 1 !important;
    visibility: visible !important;
    filter: none !important;
    mix-blend-mode: normal !important;
    transform: scale(1) !important;
    transition: transform 0.4s ease !important;
  }

  #{{ section_dom_id }} .product-card__image--secondary {
    z-index: 2 !important;
    opacity: 0 !important;
    visibility: visible !important;
    filter: none !important;
    mix-blend-mode: normal !important;
    transform: scale(1.025) !important;
    pointer-events: none !important;
    transition: transform 0.4s ease !important;
  }

  @media (hover: hover) and (pointer: fine) {
    #{{ section_dom_id }} .product-card__media:hover .product-card__image--primary,
    #{{ section_dom_id }} .product-card__media:focus-visible .product-card__image--primary,
    #{{ section_dom_id }} .product-card__media:focus-within .product-card__image--primary {
      opacity: 0 !important;
      visibility: hidden !important;
      transform: scale(1.015) !important;
    }

    #{{ section_dom_id }} .product-card__media:hover .product-card__image--secondary,
    #{{ section_dom_id }} .product-card__media:focus-visible .product-card__image--secondary,
    #{{ section_dom_id }} .product-card__media:focus-within .product-card__image--secondary {
      opacity: 1 !important;
      visibility: visible !important;
      filter: none !important;
      mix-blend-mode: normal !important;
      transform: scale(1) !important;
    }
  }

  #{{ section_dom_id }} .badge-list,
  #{{ section_dom_id }} badge-list {
    position: absolute !important;
    inset: auto !important;
    top: 0 !important;
    left: 0 !important;
    z-index: 3 !important;
    display: flex !important;
    width: auto !important;
    max-width: calc(100% - 8px);
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    transform: translateY(-35%) !important;
    pointer-events: none;
  }

  #{{ section_dom_id }} .badge-list .badge,
  #{{ section_dom_id }} badge-list .badge,
  #{{ section_dom_id }} .badge {
    display: inline-flex !important;
    width: auto !important;
    min-width: 0 !important;
    min-height: 21px;
    align-items: center;
    justify-content: center;
    margin: 0 !important;
    padding: 5px 10px !important;
    overflow: hidden;
    border: 0 !important;
    border-radius: 4px;
    background: {{ section.settings.badge_color }} !important;
    color: {{ section.settings.badge_text_color }} !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    line-height: 1.1 !important;
    letter-spacing: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    box-shadow: none !important;
  }

  #{{ section_dom_id }} .product-card__info {
    display: flex;
    width: 100%;
    min-height: 154px;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 11px;
    padding-top: 16px;
  }

  #{{ section_dom_id }} .product-card__info .v-stack,
  #{{ section_dom_id }} .product-card__info > .v-stack {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 9px;
  }

  #{{ section_dom_id }} .product-title,
  #{{ section_dom_id }} .card-product-title {
    display: -webkit-box;
    width: 100%;
    min-height: 54px;
    margin: 0;
    overflow: hidden;
    color: {{ section.settings.text_color }};
    font-size: 20px;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #{{ section_dom_id }} .product-title:hover,
  #{{ section_dom_id }} .card-product-title:hover {
    color: {{ section.settings.button_color }};
  }

  #{{ section_dom_id }} .price-list {
    display: flex;
    min-height: 28px;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 18px;
    font-weight: 700;
    line-height: 1.45;
  }

  #{{ section_dom_id }} sale-price,
  #{{ section_dom_id }} .sale-price,
  #{{ section_dom_id }} .custom-card-sale-price {
    color: {{ section.settings.text_color }};
    font-size: inherit;
    font-weight: inherit;
  }

  #{{ section_dom_id }} compare-at-price,
  #{{ section_dom_id }} .compare-at-price {
    color: #8b7a70;
    font-size: 13px;
    font-weight: 500;
    text-decoration: line-through;
  }

  #{{ section_dom_id }} .product-card__info product-form,
  #{{ section_dom_id }} .product-card__info .product-card__form {
    display: block;
    width: 100%;
    margin-top: auto;
  }

  #{{ section_dom_id }} .product-card__info form {
    display: block;
    width: 100%;
    margin: 0;
  }

  #{{ section_dom_id }} .product-card__quick-add-button {
    display: grid !important;
    width: 100% !important;
    min-width: 0 !important;
    min-height: 37px;
    place-items: center;
    margin: 0;
    padding: 9px 14px;
    border: 0;
    border-radius: 5px;
    background: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    opacity: 1 !important;
    visibility: visible !important;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transform: none !important;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  #{{ section_dom_id }} .product-card__quick-add-button::after {
    content: none !important;
  }

  #{{ section_dom_id }} .product-card__quick-add-button:hover {
    background: {{ section.settings.button_hover_color }};
    transform: translateY(-1px) !important;
  }

  #{{ section_dom_id }} .product-card__quick-add-button[disabled] {
    cursor: not-allowed;
    opacity: 0.55 !important;
  }

  #{{ section_dom_id }} .cleo-best-sellers__arrow {
    position: absolute;
    top: 31%;
    z-index: 4;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(137, 87, 55, 0.18);
    border-radius: 50%;
    background: #ffffff;
    color: {{ section.settings.heading_color }};
    box-shadow: 0 8px 20px rgba(64, 28, 40, 0.16);
    cursor: pointer;
    opacity: 1;
    transform: translateY(-50%);
    transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
  }

  #{{ section_dom_id }} .cleo-best-sellers__arrow:hover {
    background: #f8f1e9;
    transform: translateY(-50%) scale(1.04);
  }

  #{{ section_dom_id }} .cleo-best-sellers__arrow--prev {
    left: -20px;
  }

  #{{ section_dom_id }} .cleo-best-sellers__arrow--next {
    right: -20px;
  }

  #{{ section_dom_id }} .cleo-best-sellers__arrow[disabled] {
    pointer-events: none;
    opacity: 0;
  }

  #{{ section_dom_id }} .cleo-best-sellers__arrow svg {
    display: block;
    width: 15px;
    height: 18px;
  }

  #{{ section_dom_id }} .cleo-best-sellers__empty {
    width: 100%;
    margin: 0;
    padding: 24px;
    color: {{ section.settings.text_color }};
    text-align: center;
  }

  @media screen and (max-width: 1199px) {
    #{{ section_dom_id }} .cleo-best-sellers__container {
      width: min({{ section.settings.content_width }}px, calc(100% - 64px));
    }

    #{{ section_dom_id }} .cleo-best-sellers__panel {
      padding-inline: 26px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__arrow--prev {
      left: -17px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__arrow--next {
      right: -17px;
    }
  }

  @media screen and (max-width: 989px) {
    #{{ section_dom_id }} .cleo-best-sellers__heading {
      margin-bottom: 28px;
      font-size: 34px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__panel {
      padding: 26px 24px 28px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__track {
      gap: {{ section.settings.tablet_card_gap }}px;
    }

    #{{ section_dom_id }} .product-card {
      flex-basis: calc((100% - {{ tablet_gap_total }}px) / {{ section.settings.tablet_columns }});
    }

    #{{ section_dom_id }} .product-title,
    #{{ section_dom_id }} .card-product-title {
      font-size: 16px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__arrow {
      width: 40px;
      height: 40px;
    }
  }

  @media screen and (max-width: 699px) {
    #{{ section_dom_id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__container {
      width: calc(100% - 32px);
    }

    #{{ section_dom_id }} .cleo-best-sellers__heading {
      margin-bottom: 22px;
      font-size: 28px;
      line-height: 1.2;
    }

    #{{ section_dom_id }} .cleo-best-sellers__panel {
      padding: 20px 14px 22px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__track {
      gap: {{ section.settings.mobile_grid_gap }}px;
      padding-inline: 1px;
      scroll-padding-inline: 1px;
    }

    #{{ section_dom_id }} .product-card {
      flex-basis: calc((100% - {{ mobile_gap_total }}px) / {{ section.settings.mobile_columns }});
    }

    #{{ section_dom_id }} .badge-list,
    #{{ section_dom_id }} badge-list {
      top: 0 !important;
      left: 0 !important;
      max-width: calc(100% - 6px);
      transform: translateY(-30%) !important;
    }

    #{{ section_dom_id }} .badge-list .badge,
    #{{ section_dom_id }} badge-list .badge,
    #{{ section_dom_id }} .badge {
      min-height: 19px;
      max-width: 100%;
      padding: 4px 7px !important;
      font-size: 9px !important;
    }

    #{{ section_dom_id }} .product-card__info {
      min-height: 137px;
      gap: 8px;
      padding-top: 12px;
    }

    #{{ section_dom_id }} .product-title,
    #{{ section_dom_id }} .card-product-title {
      min-height: 44px;
      font-size: 13px;
      line-height: 1.65;
    }

    #{{ section_dom_id }} .price-list {
      min-height: 23px;
      gap: 5px;
      font-size: 15px;
      line-height: 1.4;
    }

    #{{ section_dom_id }} compare-at-price,
    #{{ section_dom_id }} .compare-at-price {
      font-size: 11px;
    }

    #{{ section_dom_id }} .product-card__quick-add-button {
      min-height: 34px;
      padding: 8px 6px;
      font-size: 11px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__arrow {
      top: 29%;
      width: 36px;
      height: 36px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__arrow--prev {
      left: -7px;
    }

    #{{ section_dom_id }} .cleo-best-sellers__arrow--next {
      right: -7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_dom_id }} .cleo-best-sellers__track {
      scroll-behavior: auto;
    }

    #{{ section_dom_id }} .product-card__image--primary,
    #{{ section_dom_id }} .product-card__image--secondary {
      transition: none !important;
    }
  }
{% endstyle %}

<section
  id="{{ section_dom_id }}"
  class="cleo-best-sellers"
  data-cleo-best-sellers
>
  <div class="cleo-best-sellers__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="cleo-best-sellers__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="cleo-best-sellers__panel">
      <div class="cleo-best-sellers__slider">
        {%- if section.settings.enable_slider -%}
          <button
            type="button"
            class="cleo-best-sellers__arrow cleo-best-sellers__arrow--prev"
            data-cleo-prev
            aria-controls="{{ slider_id }}"
            aria-label="Previous products"
          >
            <svg
              aria-hidden="true"
              focusable="false"
              fill="none"
              viewBox="0 0 16 18"
            >
              <path
                d="M11 1 3 9l8 8"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
              />
            </svg>
          </button>
        {%- endif -%}

        <div
          id="{{ slider_id }}"
          class="cleo-best-sellers__track"
          data-cleo-track
          role="region"
          aria-label="{{ section.settings.heading | default: 'Featured products' | escape }}"
          tabindex="0"
        >
          {%- for product in source_collection.products limit: section.settings.products_to_show -%}
            {%- render 'cleo-dynamic-product-card',
              product: product,
              section_id: section.id,
              show_quick_add: section.settings.show_quick_add
            -%}
          {%- else -%}
            <p class="cleo-best-sellers__empty">
              No products found.
            </p>
          {%- endfor -%}
        </div>

        {%- if section.settings.enable_slider -%}
          <button
            type="button"
            class="cleo-best-sellers__arrow cleo-best-sellers__arrow--next"
            data-cleo-next
            aria-controls="{{ slider_id }}"
            aria-label="Next products"
          >
            <svg
              aria-hidden="true"
              focusable="false"
              fill="none"
              viewBox="0 0 16 18"
            >
              <path
                d="m5 17 8-8-8-8"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
              />
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionId = {{ section.id | json }};

    function initCleoBestSellers(root = document) {
      const section =
        root.querySelector(`#CleoBestSellers-${sectionId}`) ||
        document.querySelector(`#CleoBestSellers-${sectionId}`);

      if (!section || section.dataset.sliderReady === 'true') {
        return;
      }

      const track = section.querySelector('[data-cleo-track]');
      const prevButton = section.querySelector('[data-cleo-prev]');
      const nextButton = section.querySelector('[data-cleo-next]');

      if (!track) {
        return;
      }

      section.dataset.sliderReady = 'true';

      /*
        Make sure secondary hover images start loading properly.
        This prevents an empty or partially loaded image on first hover.
      */
      const secondaryImages = section.querySelectorAll(
        '.product-card__image--secondary'
      );

      secondaryImages.forEach((image) => {
        image.loading = 'eager';
        image.decoding = 'async';

        if (image.dataset.src && !image.src) {
          image.src = image.dataset.src;
        }

        if (image.dataset.srcset && !image.srcset) {
          image.srcset = image.dataset.srcset;
        }
      });

      const getStep = () => {
        const firstCard = track.querySelector('.product-card');

        if (!firstCard) {
          return track.clientWidth;
        }

        const styles = window.getComputedStyle(track);
        const gap =
          parseFloat(styles.columnGap || styles.gap || '0') || 0;

        return firstCard.getBoundingClientRect().width + gap;
      };

      const updateButtons = () => {
        if (!prevButton || !nextButton) {
          return;
        }

        const maxScrollLeft = Math.max(
          0,
          track.scrollWidth - track.clientWidth
        );

        const canScroll = maxScrollLeft > 2;

        prevButton.hidden = !canScroll;
        nextButton.hidden = !canScroll;

        prevButton.disabled =
          !canScroll || track.scrollLeft <= 2;

        nextButton.disabled =
          !canScroll || track.scrollLeft >= maxScrollLeft - 2;
      };

      prevButton?.addEventListener('click', () => {
        track.scrollBy({
          left: -getStep(),
          behavior: 'smooth'
        });
      });

      nextButton?.addEventListener('click', () => {
        track.scrollBy({
          left: getStep(),
          behavior: 'smooth'
        });
      });

      track.addEventListener(
        'scroll',
        updateButtons,
        { passive: true }
      );

      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();

          track.scrollBy({
            left: -getStep(),
            behavior: 'smooth'
          });
        }

        if (event.key === 'ArrowRight') {
          event.preventDefault();

          track.scrollBy({
            left: getStep(),
            behavior: 'smooth'
          });
        }
      });

      if ('ResizeObserver' in window) {
        const resizeObserver = new ResizeObserver(updateButtons);
        resizeObserver.observe(track);
      } else {
        window.addEventListener(
          'resize',
          updateButtons,
          { passive: true }
        );
      }

      requestAnimationFrame(updateButtons);

      window.addEventListener(
        'load',
        updateButtons,
        { once: true }
      );
    }

    initCleoBestSellers();

    document.addEventListener(
      'shopify:section:load',
      (event) => {
        initCleoBestSellers(event.target);
      }
    );
  })();
</script>

{% schema %}
{
  "name": "Cleo best sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Tall portrait"
        },
        {
          "value": "16 / 9",
          "label": "Landscape"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Tablet columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
