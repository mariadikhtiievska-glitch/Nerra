<div id="ClsCoppercutopenHero-{{ section.id }}" class="cls-coppercutopen-hero">
  <div class="cls-coppercutopen-hero__inner">
    <div class="cls-coppercutopen-hero__text">
      {%- if section.settings.breadcrumb != blank -%}
        <p class="cls-coppercutopen-hero__breadcrumb">{{ section.settings.breadcrumb | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="cls-coppercutopen-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subhead != blank -%}
        <p class="cls-coppercutopen-hero__subhead">{{ section.settings.subhead | escape }}</p>
      {%- endif -%}

      {%- if section.settings.byline != blank -%}
        <p class="cls-coppercutopen-hero__byline">{{ section.settings.byline | escape }}</p>
      {%- endif -%}
    </div>

    <div class="cls-coppercutopen-hero__media">
      <div class="cls-coppercutopen-hero__photo">
        {%- if section.settings.photo != blank -%}
          <img
            src="{{ section.settings.photo | image_url: width: 1280 }}"
            srcset="
              {{ section.settings.photo | image_url: width: 450 }} 450w,
              {{ section.settings.photo | image_url: width: 900 }} 900w,
              {{ section.settings.photo | image_url: width: 1280 }} 1280w
            "
            sizes="100vw"
            alt="{{ section.settings.photo.alt | default: section.settings.heading | escape }}"
            loading="eager"
            width="{{ section.settings.photo.width }}"
            height="{{ section.settings.photo.height }}"
          >
        {%- elsif section.settings.photo_fallback != blank -%}
          <img
            src="{{ section.settings.photo_fallback | replace: '.jpg', '-900.jpg' | asset_url }}"
            srcset="
              {{ section.settings.photo_fallback | replace: '.jpg', '-450.jpg' | asset_url }} 450w,
              {{ section.settings.photo_fallback | replace: '.jpg', '-900.jpg' | asset_url }} 900w,
              {{ section.settings.photo_fallback | asset_url }} 1280w
            "
            sizes="100vw"
            alt="{{ section.settings.heading | escape }}"
            loading="eager"
          >
        {%- endif -%}
      </div>

      {%- if section.settings.caption != blank -%}
        <div class="cls-coppercutopen-hero__caption-wrap">
          <p class="cls-coppercutopen-hero__caption">{{ section.settings.caption | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "breadcrumb",
      "label": "Breadcrumb",
      "default": "Home  >  Wellness  >  Drinkware  |  Advertorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We Cut Open 9 “Amazon” Copper Bottles. What’s Actually Inside a $29 “Copper” Bottle."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Seven of the nine had something other than copper inside them. The other two lied about how they were made. Not one listing was accurate."
    },
    {
      "type": "text",
      "id": "byline",
      "label": "Byline",
      "default": "By Ayan Decker ·  Lab analysis by CALIMP  ·  September 2026  ·  7 min read"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Hero photo"
    },
    {
      "type": "text",
      "id": "photo_fallback",
      "label": "Hero photo fallback filename",
      "info": "Used only if no photo is set above. Must be an asset filename already uploaded to this theme.",
      "default": "copper-bottles-cut-open-hero-photo.jpg"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Photo caption",
      "default": "All nine, bought online for $19–$39 from nine different sellers and sectioned on the same saw."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
