<div id="ClsCoppercutopenFourWays-{{ section.id }}" class="cls-coppercutopen-four-ways">
  <div class="cls-coppercutopen-four-ways__inner">
    <div class="cls-coppercutopen-four-ways__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="cls-coppercutopen-four-ways__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="cls-coppercutopen-four-ways__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <div class="cls-coppercutopen-four-ways__item" {{ block.shopify_attributes }}>
              <p class="cls-coppercutopen-four-ways__item-label">{{ block.settings.label | escape }}</p>
              <p class="cls-coppercutopen-four-ways__item-body">{{ block.settings.body | escape }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="cls-coppercutopen-four-ways__illustration">
      {%- if section.settings.illustration != blank -%}
        <img
          src="{{ section.settings.illustration | image_url: width: 1280 }}"
          srcset="
            {{ section.settings.illustration | image_url: width: 450 }} 450w,
            {{ section.settings.illustration | image_url: width: 900 }} 900w,
            {{ section.settings.illustration | image_url: width: 1280 }} 1280w
          "
          sizes="100vw"
          alt="{{ section.settings.illustration.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.illustration.width }}"
          height="{{ section.settings.illustration.height }}"
        >
      {%- elsif section.settings.illustration_fallback != blank -%}
        <img
          src="{{ section.settings.illustration_fallback | replace: '.png', '-900.png' | asset_url }}"
          srcset="
            {{ section.settings.illustration_fallback | replace: '.png', '-450.png' | asset_url }} 450w,
            {{ section.settings.illustration_fallback | replace: '.png', '-900.png' | asset_url }} 900w,
            {{ section.settings.illustration_fallback | asset_url }} 1280w
          "
          sizes="100vw"
          alt="Four wall cross-sections — plated, lined, alloy, solid copper"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Four ways",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four ways a bottle can look like copper and not be copper"
    },
    {
      "type": "image_picker",
      "id": "illustration",
      "label": "Illustration"
    },
    {
      "type": "text",
      "id": "illustration_fallback",
      "label": "Illustration fallback filename",
      "info": "Used only if no illustration is set above. Must be an asset filename already uploaded to this theme.",
      "default": "copper-bottles-cut-open-four-ways-illustration.png"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Four ways",
      "blocks": [
        { "type": "item", "settings": { "label": "Plating", "body": "A steel or aluminium body with a copper layer on the outside, sometimes only microns thick. It photographs beautifully and it fails a magnet in three seconds — if the core is steel. If the core is aluminium, the magnet says nothing at all." } },
        { "type": "item", "settings": { "label": "Lining", "body": "A lacquer or epoxy film sprayed on the inside wall so the bottle never tarnishes and the seller never has to explain patina to a customer. Six of my nine had one. It is the most common substitution in this category and the least visible, because from the outside a lined bottle looks better than an honest one — it stays bright forever." } },
        { "type": "item", "settings": { "label": "Alloys", "body": "Copper melted down with zinc or iron from scrap and sold as pure. Brass reads as copper to the eye once it is polished and hammered. It also brings whatever else was in the scrap, which is why lead shows up in test reports for this category at all." } },
        { "type": "item", "settings": { "label": "Machine pressing", "body": "Not a fake material — a fake story. A stamped dimple pattern repeats identically around the circumference because a die made it. Photograph the same point on the opposite side of the bottle. If the dimples match exactly, nobody hammered anything." } }
      ]
    }
  ]
}
{% endschema %}
