{%- assign country_code = country | upcase | strip -%}
{%- if country_code == 'UK' or country_code == 'GB' -%}
  <svg aria-hidden="true" viewBox="0 0 32 32" width="32" height="32">
    <defs><clipPath id="flag-uk-{{ unique_id }}"><rect x="1" y="4" width="30" height="24" rx="4"/></clipPath></defs>
    <g clip-path="url(#flag-uk-{{ unique_id }})">
      <rect x="1" y="4" width="30" height="24" fill="#071b65"/>
      <path d="M1 4l30 24M31 4 1 28" stroke="#fff" stroke-width="6"/>
      <path d="M1 4l30 24M31 4 1 28" stroke="#b92932" stroke-width="2"/>
      <path d="M16 4v24M1 16h30" stroke="#fff" stroke-width="7"/>
      <path d="M16 4v24M1 16h30" stroke="#b92932" stroke-width="4"/>
    </g>
    <rect x="1" y="4" width="30" height="24" rx="4" fill="none" stroke="#000" opacity=".15"/>
  </svg>
{%- elsif country_code == 'US' or country_code == 'USA' -%}
  <svg aria-hidden="true" viewBox="0 0 32 32" width="32" height="32">
    <defs><clipPath id="flag-us-{{ unique_id }}"><rect x="1" y="4" width="30" height="24" rx="4"/></clipPath></defs>
    <g clip-path="url(#flag-us-{{ unique_id }})">
      <rect x="1" y="4" width="30" height="24" fill="#fff"/>
      <path d="M1 5.85h30M1 9.54h30M1 13.23h30M1 16.92h30M1 20.62h30M1 24.31h30M1 28h30" stroke="#a62842" stroke-width="1.85"/>
      <rect x="1" y="4" width="15" height="12.92" fill="#102d5e"/>
      <g fill="#fff">
        <circle cx="4" cy="7" r=".7"/><circle cx="7" cy="7" r=".7"/><circle cx="10" cy="7" r=".7"/><circle cx="13" cy="7" r=".7"/>
        <circle cx="5.5" cy="9.8" r=".7"/><circle cx="8.5" cy="9.8" r=".7"/><circle cx="11.5" cy="9.8" r=".7"/>
        <circle cx="4" cy="12.6" r=".7"/><circle cx="7" cy="12.6" r=".7"/><circle cx="10" cy="12.6" r=".7"/><circle cx="13" cy="12.6" r=".7"/>
        <circle cx="5.5" cy="15.1" r=".7"/><circle cx="8.5" cy="15.1" r=".7"/><circle cx="11.5" cy="15.1" r=".7"/>
      </g>
    </g>
    <rect x="1" y="4" width="30" height="24" rx="4" fill="none" stroke="#000" opacity=".15"/>
  </svg>
{%- else -%}
  <span aria-hidden="true">{{ country_code }}</span>
{%- endif -%}
