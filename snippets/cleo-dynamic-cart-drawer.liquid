    display: grid !important;
    width: 32px !important;
    min-width: 32px !important;
    max-width: 32px !important;
    height: 32px !important;
    min-height: 32px !important;
    max-height: 32px !important;
    place-items: center !important;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 50% !important;
    padding: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #303030 !important;
    cursor: pointer;
    line-height: 1 !important;
    text-decoration: none !important;
  }

  .cleo-cart-item__remove::before,
  .cleo-cart-item__remove::after {
    display: none !important;
    content: none !important;
  }

  .cleo-cart-item__remove:hover,
  .cleo-cart-item__remove:focus-visible {
    background: #f1f2f3 !important;
    color: #111111 !important;
  }

  .cleo-cart-item__remove svg {
    display: block !important;
    width: 19px !important;
    height: 19px !important;
    pointer-events: none;
  }

  .cleo-cart-item__gift-label {
    margin-top: 8px;
    color: var(--cleo-accent);
    font-size: 11px;
    font-weight: 800;
  }

  /* ------------------------------
     UPSELL PRODUCTS
  ------------------------------ */

  .cleo-cart-upsells {
    padding: 14px 14px 18px;
  }

  .cleo-cart-upsells__heading {
    margin: 0 0 11px;
    color: #111111;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.25;
    text-align: center;
  }

  .cleo-cart-upsells__slider {
    position: relative;
    padding: 0 36px;
  }

  .cleo-cart-upsells__viewport {
    overflow: hidden;
    border-radius: 10px;
    background: var(--cleo-panel-color);
  }

  .cleo-cart-upsells__track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 12px 13px 14px;
  }

  .cleo-cart-upsells__track::-webkit-scrollbar {
    display: none;
  }

  .cleo-upsell-card {
    display: flex;
    min-width: calc((100% - 10px) / 2);
    flex: 0 0 calc((100% - 10px) / 2);
    flex-direction: column;
    align-items: center;
    scroll-snap-align: start;
    text-align: center;
  }

  .cleo-upsell-card__image {
    display: block;
    width: 62px;
    height: 62px;
    overflow: hidden;
    border-radius: 5px;
    background: #ffffff;
  }

  .cleo-upsell-card__image img,
  .cleo-upsell-card__image svg {
    display: block;
    width: 100%;
    height: 100%;
