<section
  id="CleoCartDrawerSection-{{ section.id }}"
  class="cleo-cart-drawer-section"
  data-cleo-drawer-section
  data-section-id="{{ section.id }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-count="{{ cart.item_count }}"
  data-cart-token="{{ cart.token | escape }}"
  data-reservation-minutes="{{ settings.cleo_cart_timer_minutes }}"
  data-gift-threshold="{{ gift_threshold_cents }}"
  data-gift-variant-id="{{ gift_variant_id }}"
  data-auto-add-gift="{{ settings.cleo_cart_auto_gift }}"
  data-remove-gift="{{ settings.cleo_cart_remove_gift }}"
  data-intercept-add="{{ settings.cleo_cart_intercept_forms }}"
  style="
    --cleo-drawer-width: {{ settings.cleo_cart_drawer_width }}px;
    --cleo-accent: {{ settings.cleo_cart_accent_color }};
    --cleo-accent-light: {{ settings.cleo_cart_accent_light }};
    --cleo-checkout: {{ settings.cleo_cart_checkout_color }};
    --cleo-checkout-text: {{ settings.cleo_cart_checkout_text_color }};
    --cleo-timer-background: {{ settings.cleo_cart_timer_background }};
    --cleo-timer-text: {{ settings.cleo_cart_timer_text_color }};
    --cleo-progress-fill: {{ settings.cleo_cart_progress_color }};
    --cleo-progress: {{ progress_percentage }}%;
  "
>
  <button
    type="button"
    class="cleo-cart-overlay"
    data-cleo-cart-close
    aria-label="Close cart"
    tabindex="-1"
  ></button>

  <aside
    id="cart-drawer"
    class="cleo-cart-drawer"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="CleoCartDrawerHeading-{{ section.id }}"
  >
    <header class="cleo-cart-drawer__header">
      <h2
        id="CleoCartDrawerHeading-{{ section.id }}"
        class="cleo-cart-drawer__heading"
      >
        {{ settings.cleo_cart_heading }}

        {%- if display_item_count > 0 -%}
          &nbsp;•&nbsp;{{ display_item_count }}
        {%- endif -%}
      </h2>

      <button
        type="button"
        class="cleo-cart-drawer__close"
        data-cleo-cart-close
        aria-label="Close cart"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4 4L16 16M16 4L4 16"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </header>

    {%- unless cart == empty -%}
      {%- if settings.cleo_cart_show_timer -%}
        <div class="cleo-cart-reservation">
          <span>{{ settings.cleo_cart_timer_text }}</span>

          <strong data-cleo-timer aria-live="polite">
            {%- if settings.cleo_cart_timer_minutes < 10 -%}0{%- endif -%}
            {{- settings.cleo_cart_timer_minutes -}}:00
          </strong>

          <span class="cleo-cart-reservation__icon" aria-hidden="true">
            ⏰
          </span>
        </div>
      {%- endif -%}
    {%- endunless -%}

    <div class="cleo-cart-drawer__scroll">
      <p class="cleo-cart-error" data-cleo-cart-error hidden></p>

      {%- if cart == empty -%}
        <div class="cleo-cart-empty">
          <svg
            class="cleo-cart-empty__icon"
            viewBox="0 0 48 48"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M14 17H34L32.5 39H15.5L14 17Z"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M19 18V13C19 10.2386 21.2386 8 24 8C26.7614 8 29 10.2386 29 13V18"
              stroke="currentColor"
              stroke-width="2"
            />
          </svg>

          <h3 class="cleo-cart-empty__title">
            {{ settings.cleo_cart_empty_heading }}
          </h3>

          <p class="cleo-cart-empty__text">
            {{ settings.cleo_cart_empty_text }}
          </p>

          <a
            href="{{ continue_shopping_url }}"
            class="cleo-cart-empty__button"
          >
            {{ settings.cleo_cart_empty_button }}
          </a>
        </div>
      {%- else -%}
        {%- if gift_threshold_cents > 0 or shipping_threshold_cents > 0 -%}
          <div class="cleo-cart-goals">
            <p class="cleo-cart-goals__message">
              {%- if gift_threshold_cents > 0 and qualifying_total < gift_threshold_cents -%}
                Add
                <strong>{{ gift_remaining | money }}</strong>
                to unlock
                <strong>{{ settings.cleo_cart_gift_label }}</strong>!
              {%- elsif shipping_threshold_cents > 0 and qualifying_total < shipping_threshold_cents -%}
                Add
                <strong>{{ shipping_remaining | money }}</strong>
                to unlock
                <strong>{{ settings.cleo_cart_shipping_label }}</strong>!
              {%- else -%}
                <strong>{{ settings.cleo_cart_all_unlocked }}</strong>
              {%- endif -%}
            </p>

            <div class="cleo-cart-goals__track-wrap">
              <div class="cleo-cart-goals__track">
                <span class="cleo-cart-goals__fill"></span>
              </div>

              {%- if gift_threshold_cents > 0 -%}
                <span
                  class="cleo-cart-goals__node {% if qualifying_total >= gift_threshold_cents %}is-unlocked{% endif %}"
                  style="left: {{ gift_position }}%;"
                  aria-hidden="true"
                ></span>
              {%- endif -%}

              {%- if shipping_threshold_cents > 0 -%}
                <span
                  class="cleo-cart-goals__node cleo-cart-goals__node--shipping {% if qualifying_total >= shipping_threshold_cents %}is-unlocked{% endif %}"
                  style="left: {{ shipping_position }}%;"
                  aria-hidden="true"
                ></span>
              {%- endif -%}
            </div>

            <div class="cleo-cart-goals__labels">
              {%- if gift_threshold_cents > 0 -%}
                <div
                  class="cleo-cart-goals__label cleo-cart-goals__label--gift {% if qualifying_total >= gift_threshold_cents %}is-unlocked{% endif %}"
                >
                  <span class="cleo-cart-goals__label-icon" aria-hidden="true">
                    🎁
                  </span>

                  <span class="cleo-cart-goals__label-text">
                    {%- if qualifying_total >= gift_threshold_cents -%}
                      ✅
                    {%- else -%}
                      🔒
                    {%- endif -%}

                    {{ settings.cleo_cart_gift_label }}
                  </span>
                </div>
              {%- endif -%}

              {%- if shipping_threshold_cents > 0 -%}
                <div
                  class="cleo-cart-goals__label cleo-cart-goals__label--shipping {% if qualifying_total >= shipping_threshold_cents %}is-unlocked{% endif %}"
                >
                  <span class="cleo-cart-goals__label-icon" aria-hidden="true">
                    🚚
                  </span>

                  <span class="cleo-cart-goals__label-text">
                    {%- if qualifying_total >= shipping_threshold_cents -%}
                      ✅
                    {%- else -%}
                      🔒
                    {%- endif -%}

                    {{ settings.cleo_cart_shipping_label }}
                  </span>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="cleo-cart-items" data-cleo-cart-items>
          {%- for item in cart.items -%}
            {%- liquid
              assign is_free_gift = false

              if item.properties['_cleo_free_gift'] == 'true'
                assign is_free_gift = true
              endif

              assign compare_line_price = item.variant.compare_at_price | times: item.quantity
              assign reference_line_price = item.original_line_price

              if compare_line_price > reference_line_price
                assign reference_line_price = compare_line_price
              endif

              assign item_saving = reference_line_price | minus: item.final_line_price

              if item_saving < 0
                assign item_saving = 0
              endif

              assign item_badge = item.properties['_bundle_label']

              if item_badge == blank
                for discount_allocation in item.line_level_discount_allocations
                  assign item_badge = discount_allocation.discount_application.title
                  break
                endfor
              endif

              if item_badge == blank and item.quantity >= 2
                assign item_badge = settings.cleo_cart_bundle_badge
              endif

              assign quantity_target = settings.cleo_cart_quantity_target
              assign quantity_remaining = quantity_target | minus: item.quantity
              assign quantity_offer_saving = settings.cleo_cart_quantity_saving | times: 100
            -%}

            <article
              class="cleo-cart-item"
              data-line-key="{{ item.key | escape }}"
            >
              <a
                href="{{ item.url }}"
                class="cleo-cart-item__image"
                aria-label="{{ item.product.title | escape }}"
              >
                {%- if item.image != blank -%}
                  {{
                    item.image
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      widths: '90, 120, 160, 200',
                      sizes: '86px',
                      alt: item.product.title
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </a>

              <div class="cleo-cart-item__content">
                <a href="{{ item.url }}" class="cleo-cart-item__title">
                  {{ item.product.title }}
                </a>

                {%- unless item.product.has_only_default_variant -%}
                  <p class="cleo-cart-item__variant">
                    {{ item.variant.title }}
                  </p>
                {%- endunless -%}

                {%- if is_free_gift -%}
                  <div class="cleo-cart-item__gift-label">
                    🎁 {{ settings.cleo_cart_free_gift_badge }}
                  </div>
                {%- else -%}
                  <div class="cleo-cart-item__actions">
                    {%- if item_badge != blank -%}
                      <div class="cleo-cart-item__badge">
                        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path
                            d="M8.5 1.5H4L1.5 4V8.5L7.5 14.5L14.5 7.5L8.5 1.5Z"
                            fill="currentColor"
                          />
                          <circle cx="5" cy="5" r="1.2" fill="#ffffff" />
                        </svg>

                        <span>{{ item_badge }}</span>
                      </div>
                    {%- endif -%}

                    <div
                      class="cleo-cart-quantity"
                      aria-label="Quantity for {{ item.product.title | escape }}"
                    >
                      <button
                        type="button"
                        class="cleo-cart-quantity__button"
                        data-cleo-cart-change
                        data-line-key="{{ item.key | escape }}"
                        data-quantity="{{ item.quantity | minus: 1 }}"
                        aria-label="Decrease quantity"
                      >
                        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path
                            d="M2 6H10"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                          />
                        </svg>
                      </button>

                      <span
                        class="cleo-cart-quantity__value"
                        aria-live="polite"
                      >
                        {{ item.quantity }}
                      </span>

                      <button
                        type="button"
                        class="cleo-cart-quantity__button"
                        data-cleo-cart-change
                        data-line-key="{{ item.key | escape }}"
                        data-quantity="{{ item.quantity | plus: 1 }}"
                        aria-label="Increase quantity"
                      >
                        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path
                            d="M6 2V10M2 6H10"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                          />
                        </svg>
                      </button>
                    </div>
                  </div>

                  {%- if settings.cleo_cart_show_quantity_offer and quantity_remaining > 0 -%}
                    <button
                      type="button"
                      class="cleo-cart-item__tier-button"
                      data-cleo-cart-change
                      data-line-key="{{ item.key | escape }}"
                      data-quantity="{{ quantity_target }}"
                    >
                      Add {{ quantity_remaining }} more

                      {%- if quantity_offer_saving > 0 -%}
                        &nbsp;to get {{ quantity_offer_saving | money }} off
                      {%- else -%}
                        &nbsp;to unlock extra savings
                      {%- endif -%}
                    </button>
                  {%- endif -%}
                {%- endif -%}
              </div>

              <div class="cleo-cart-item__side {% if is_free_gift %}cleo-cart-item__side--gift{% endif %}">
                {%- if reference_line_price > item.final_line_price -%}
                  <span class="cleo-cart-item__compare-price">
                    {{ reference_line_price | money }}
                  </span>
                {%- endif -%}

                <strong class="cleo-cart-item__price">
                  {{ item.final_line_price | money }}
                </strong>

                {%- if item_saving > 0 -%}
                  <span class="cleo-cart-item__saving">
                    You save<br>
                    {{ item_saving | money }}
                  </span>
                {%- endif -%}

                {%- unless is_free_gift -%}
                  <button
                    type="button"
                    class="cleo-cart-item__remove"
                    data-cleo-cart-change
                    data-line-key="{{ item.key | escape }}"
                    data-quantity="0"
                    aria-label="Remove {{ item.product.title | escape }}"
                  >
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path
                        d="M4.5 6H15.5"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                      />
                      <path
                        d="M8 3.5H12"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                      />
                      <path
                        d="M6.5 6L7.2 16.5H12.8L13.5 6"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M8.7 9V13.5M11.3 9V13.5"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                      />
                    </svg>
                  </button>
                {%- endunless -%}
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if visible_upsells > 0 -%}
          <div class="cleo-cart-upsells">
            <h3 class="cleo-cart-upsells__heading">
              {{ settings.cleo_cart_upsell_heading }}
            </h3>

            <div class="cleo-cart-upsells__slider">
              <button
                type="button"
                class="cleo-cart-upsells__arrow cleo-cart-upsells__arrow--previous"
                data-cleo-upsell-previous
                aria-label="Previous recommendations"
              >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M15 5L8 12L15 19"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>

              <div class="cleo-cart-upsells__viewport">
                <div
                  class="cleo-cart-upsells__track"
                  data-cleo-upsell-track
                >
                  {%- assign rendered_upsells = 0 -%}

                  {%- for upsell_product in upsell_source -%}
                    {%- liquid
                      assign upsell_in_cart = false

                      for drawer_item in cart.items
                        if drawer_item.product_id == upsell_product.id
                          assign upsell_in_cart = true
                          break
                        endif
                      endfor

                      if gift_product != blank and upsell_product.id == gift_product.id
                        assign upsell_in_cart = true
                      endif

                      assign upsell_variant = upsell_product.selected_or_first_available_variant
                    -%}

                    {%- if upsell_in_cart == false and upsell_product.available and rendered_upsells < settings.cleo_cart_max_upsells -%}
                      {%- liquid
                        assign rendered_upsells = rendered_upsells | plus: 1
                        assign upsell_saving_percent = 0

                        if upsell_variant.compare_at_price > upsell_variant.price
                          assign upsell_saving_amount = upsell_variant.compare_at_price | minus: upsell_variant.price
                          assign upsell_saving_percent = upsell_saving_amount | times: 100.0 | divided_by: upsell_variant.compare_at_price | round
                        endif
                      -%}

                      <article class="cleo-upsell-card">
                        <a
                          href="{{ upsell_product.url }}"
                          class="cleo-upsell-card__image"
                          aria-label="{{ upsell_product.title | escape }}"
                        >
                          {%- if upsell_product.featured_image != blank -%}
                            {{
                              upsell_product.featured_image
                              | image_url: width: 160
                              | image_tag:
                                loading: 'lazy',
                                widths: '80, 120, 160',
                                sizes: '62px',
                                alt: upsell_product.title
                            }}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag }}
                          {%- endif -%}
                        </a>

                        <a
                          href="{{ upsell_product.url }}"
                          class="cleo-upsell-card__title"
                        >
                          {{ upsell_product.title }}
                        </a>

                        <div class="cleo-upsell-card__prices">
                          <strong class="cleo-upsell-card__price">
                            {{ upsell_variant.price | money }}
                          </strong>

                          {%- if upsell_variant.compare_at_price > upsell_variant.price -%}
                            <span class="cleo-upsell-card__compare">
                              {{ upsell_variant.compare_at_price | money }}
                            </span>
                          {%- endif -%}
                        </div>

                        {%- if upsell_saving_percent > 0 -%}
                          <span class="cleo-upsell-card__saving">
                            You save {{ upsell_saving_percent }}%
                          </span>
                        {%- endif -%}

                        <button
                          type="button"
                          class="cleo-upsell-card__add"
                          data-cleo-add-upsell
                          data-variant-id="{{ upsell_variant.id }}"
                        >
                          {{ settings.cleo_cart_upsell_button }}
                        </button>
                      </article>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

              <button
                type="button"
                class="cleo-cart-upsells__arrow cleo-cart-upsells__arrow--next"
                data-cleo-upsell-next
                aria-label="Next recommendations"
              >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M9 5L16 12L9 19"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          </div>
        {%- endif -%}

        <div class="cleo-cart-benefit-strip">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7.5L12 3L20 7.5V16.5L12 21L4 16.5V7.5Z" fill="currentColor"/>
            <path d="M4.5 7.8L12 12L19.5 7.8M12 12V20.5" stroke="#ffffff" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M8 5.3L15.8 9.7" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round"/>
          </svg>

          <span>
            {{ settings.cleo_cart_benefit_text | default: 'Wellness Sale Special · Limited Batch' }}
          </span>
        </div>
      {%- endif -%}
    </div>

    {%- unless cart == empty -%}
      <footer class="cleo-cart-drawer__footer">
        {%- if cart.total_discount > 0 -%}
          <div class="cleo-cart-discount">
            <div class="cleo-cart-discount__left">
              <span>Discounts</span>

              <span class="cleo-cart-discount__tag">
                <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path
                    d="M9.5 2H4L2 4V9.5L8.5 16L16 8.5L9.5 2Z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  />
                  <circle cx="5.5" cy="5.5" r="1.1" fill="currentColor" />
                </svg>

                <span>{{ discount_label }}</span>
              </span>
            </div>

            <span class="cleo-cart-discount__amount">
              -{{ cart.total_discount | money }}
            </span>
          </div>
        {%- endif -%}

        <div class="cleo-cart-subtotal">
          <span>{{ settings.cleo_cart_subtotal_text }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>

        <form
          action="{{ routes.cart_url }}"
          method="post"
          class="cleo-cart-checkout-form"
        >
          <button
            type="submit"
            name="checkout"
            class="cleo-cart-checkout"
          >
            <span aria-hidden="true">🔐</span>

            <span>
              {{ settings.cleo_cart_checkout_text }}
              •
              {{ cart.total_price | money }}
            </span>
          </button>
        </form>

        {%- if settings.cleo_cart_show_payments -%}
          <div
            class="cleo-cart-payment-icons"
            aria-label="Accepted payment methods"
          >
            {%- assign displayed_payment_icons = 0 -%}

            {%- for payment_type in shop.enabled_payment_types -%}
              {%- if displayed_payment_icons < 7 -%}
                {{ payment_type | payment_type_svg_tag }}
                {%- assign displayed_payment_icons = displayed_payment_icons | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <a
          href="{{ continue_shopping_url }}"
          class="cleo-cart-continue"
        >
          {{ settings.cleo_cart_continue_text }}
        </a>
      </footer>
    {%- endunless -%}
  </aside>
</section>

