{%- liquid
  assign gift_product = settings.cleo_cart_gift_product
  assign gift_variant = gift_product.selected_or_first_available_variant
  assign gift_variant_id = 0

  if gift_variant != blank
    assign gift_variant_id = gift_variant.id
  endif

  assign gift_threshold_cents = settings.cleo_cart_gift_threshold | times: 100
  assign shipping_threshold_cents = settings.cleo_cart_shipping_threshold | times: 100

  assign qualifying_total = 0
  assign display_item_count = 0

  for drawer_item in cart.items
    assign drawer_item_is_gift = false

    if drawer_item.properties['_cleo_free_gift'] == 'true'
      assign drawer_item_is_gift = true
    endif

    unless drawer_item_is_gift
      assign qualifying_total = qualifying_total | plus: drawer_item.final_line_price
      assign display_item_count = display_item_count | plus: drawer_item.quantity
    endunless
  endfor

  assign progress_percentage = 0
  assign gift_position = 0
  assign shipping_position = 0

  if gift_threshold_cents > 0 and shipping_threshold_cents > gift_threshold_cents
    comment
      Two-stage progress, matching the reference layout:
      gift is the middle milestone and shipping is the final milestone.
    endcomment
    assign gift_position = 50
    assign shipping_position = 100

    if qualifying_total < gift_threshold_cents
      assign progress_percentage = qualifying_total | times: 50.0 | divided_by: gift_threshold_cents
    elsif qualifying_total < shipping_threshold_cents
      assign second_stage_total = shipping_threshold_cents | minus: gift_threshold_cents
      assign second_stage_spend = qualifying_total | minus: gift_threshold_cents
      assign second_stage_progress = second_stage_spend | times: 50.0 | divided_by: second_stage_total
      assign progress_percentage = 50 | plus: second_stage_progress
    else
      assign progress_percentage = 100
    endif
  elsif gift_threshold_cents > 0 and shipping_threshold_cents > 0
    assign maximum_goal = shipping_threshold_cents

    if gift_threshold_cents > maximum_goal
      assign maximum_goal = gift_threshold_cents
    endif

    assign gift_position = gift_threshold_cents | times: 100.0 | divided_by: maximum_goal
    assign shipping_position = shipping_threshold_cents | times: 100.0 | divided_by: maximum_goal
    assign progress_percentage = qualifying_total | times: 100.0 | divided_by: maximum_goal
  elsif gift_threshold_cents > 0
    assign gift_position = 100
    assign progress_percentage = qualifying_total | times: 100.0 | divided_by: gift_threshold_cents
  elsif shipping_threshold_cents > 0
    assign shipping_position = 100
    assign progress_percentage = qualifying_total | times: 100.0 | divided_by: shipping_threshold_cents
  endif

  if progress_percentage > 100
    assign progress_percentage = 100
  endif

  if progress_percentage < 0
    assign progress_percentage = 0
  endif

  assign gift_remaining = gift_threshold_cents | minus: qualifying_total
  assign shipping_remaining = shipping_threshold_cents | minus: qualifying_total

  if gift_remaining < 0
    assign gift_remaining = 0
  endif

  if shipping_remaining < 0
    assign shipping_remaining = 0
  endif

  assign discount_label = settings.cleo_cart_discount_fallback
  assign discount_label_found = false

  for discount_application in cart.cart_level_discount_applications
    assign discount_label = discount_application.title
    assign discount_label_found = true
    break
  endfor

  unless discount_label_found
    for drawer_item in cart.items
      for discount_allocation in drawer_item.line_level_discount_allocations
        assign discount_label = discount_allocation.discount_application.title
        assign discount_label_found = true
        break
      endfor

      if discount_label_found
        break
      endif
    endfor
  endunless

  assign visible_upsells = 0
  assign upsell_source = settings.cleo_cart_upsell_products

  if settings.cleo_cart_show_upsells
    for upsell_product in upsell_source
      assign upsell_in_cart = false

      for drawer_item in cart.items
        if drawer_item.product_id == upsell_product.id
          assign upsell_in_cart = true
          break
        endif
      endfor

      if gift_product != blank and upsell_product.id == gift_product.id
        assign upsell_in_cart = true
      endif

      if upsell_in_cart == false and upsell_product.available
        assign visible_upsells = visible_upsells | plus: 1
      endif

      if visible_upsells >= settings.cleo_cart_max_upsells
        break
      endif
    endfor

    comment
      When no useful manually selected recommendations are available,
      use the store's All products collection as a safe dynamic fallback.
    endcomment

    if visible_upsells < 2
      assign upsell_source = collections.all.products
      assign visible_upsells = 0

      for upsell_product in upsell_source
        assign upsell_in_cart = false

        for drawer_item in cart.items
          if drawer_item.product_id == upsell_product.id
            assign upsell_in_cart = true
            break
          endif
        endfor

        if gift_product != blank and upsell_product.id == gift_product.id
          assign upsell_in_cart = true
        endif

        if upsell_in_cart == false and upsell_product.available
          assign visible_upsells = visible_upsells | plus: 1
        endif

        if visible_upsells >= settings.cleo_cart_max_upsells
          break
        endif
      endfor
    endif
  endif

  assign continue_shopping_url = settings.cleo_cart_continue_link

  if continue_shopping_url == blank
    assign continue_shopping_url = routes.all_products_collection_url
  endif
-%}

<style data-cleo-component-css="cart-drawer">
  html.cleo-cart-drawer-open,
  html.cleo-cart-drawer-open body {
    overflow: hidden !important;
  }

  .cleo-cart-drawer-section,
  .cleo-cart-drawer-section *,
  .cleo-cart-drawer-section *::before,
  .cleo-cart-drawer-section *::after {
    box-sizing: border-box;
  }

  .cleo-cart-drawer-section {
    --cleo-drawer-width: 425px;
    --cleo-accent: #009860;
    --cleo-accent-light: #dff8eb;
    --cleo-checkout: #765951;
    --cleo-checkout-text: #ffffff;
    --cleo-timer-background: #705650;
    --cleo-timer-text: #ffffff;
    --cleo-title-color: #111111;
    --cleo-text-color: #222222;
    --cleo-muted-color: #8b95a5;
    --cleo-border-color: #e5e7eb;
    --cleo-panel-color: #f3f4f6;
    --cleo-progress-background: #e8eaee;
    --cleo-progress-fill: #172235;

    position: relative;
    z-index: 9998;
    color: var(--cleo-text-color);
    font-family: inherit;
  }

  .cleo-cart-drawer-section button,
  .cleo-cart-drawer-section input,
  .cleo-cart-drawer-section select {
    font-family: inherit;
  }

  .cleo-cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: block;
    visibility: hidden;
    width: 100%;
    height: 100%;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    background: rgba(25, 20, 18, 0.45) !important;
    box-shadow: none !important;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .cleo-cart-drawer-section.is-open .cleo-cart-overlay {
    visibility: visible;
    opacity: 1;
  }

  .cleo-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 9999;
    display: flex;
    width: min(var(--cleo-drawer-width), 100vw);
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    flex-direction: column;
    overflow: hidden;
    background: #ffffff;
    box-shadow: -18px 0 50px rgba(32, 24, 20, 0.18);
    transform: translateX(102%);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cleo-cart-drawer-section.is-open .cleo-cart-drawer {
    transform: translateX(0);
  }

  .cleo-cart-drawer__header {
    position: relative;
    display: grid;
    min-height: 57px;
    flex: 0 0 auto;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    padding: 0 8px;
    border-bottom: 1px solid var(--cleo-border-color);
    background: #ffffff;
  }

  .cleo-cart-drawer__heading {
    grid-column: 2;
    margin: 0;
    color: var(--cleo-title-color);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.1;
    text-align: center;
  }

  .cleo-cart-drawer__close {
    -webkit-appearance: none !important;
    appearance: none !important;
    display: grid !important;
    width: 40px !important;
    min-width: 40px !important;
    max-width: 40px !important;
    height: 40px !important;
    min-height: 40px !important;
    max-height: 40px !important;
    grid-column: 3;
    place-items: center !important;
    justify-self: end;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 50% !important;
    padding: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #111111 !important;
    cursor: pointer;
  }

  .cleo-cart-drawer__close:hover,
  .cleo-cart-drawer__close:focus-visible {
    background: #f3f4f6 !important;
  }

  .cleo-cart-drawer__close svg {
    display: block;
    width: 17px;
    height: 17px;
    pointer-events: none;
  }

  .cleo-cart-reservation {
    display: flex;
    min-height: 37px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--cleo-timer-background);
    color: var(--cleo-timer-text);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .cleo-cart-reservation strong {
