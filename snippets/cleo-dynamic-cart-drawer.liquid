    line-height: 1;
  }

  .cleo-cart-drawer__scroll {
    min-height: 0;
    flex: 1 1 auto;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .cleo-cart-drawer__scroll::-webkit-scrollbar {
    width: 5px;
  }

  .cleo-cart-drawer__scroll::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: #c9cdd4;
  }

  .cleo-cart-error {
    margin: 10px 14px 0;
    border: 1px solid #f1b9b4;
    border-radius: 5px;
    padding: 9px 10px;
    background: #fff1f0;
    color: #a32820;
    font-size: 12px;
    line-height: 1.35;
  }

  .cleo-cart-error[hidden] {
    display: none !important;
  }

  /* ------------------------------
     CART GOALS
  ------------------------------ */

  .cleo-cart-goals {
    position: relative;
    padding: 13px 18px 19px;
    border-bottom: 1px solid #eceef1;
    background: #ffffff;
  }

  .cleo-cart-goals__message {
    min-height: 18px;
    margin: 0 0 15px;
    color: #273244;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
  }

  .cleo-cart-goals__message strong {
    color: #111827;
    font-weight: 800;
  }

  .cleo-cart-goals__track-wrap {
    position: relative;
    width: 100%;
    height: 15px;
  }

  .cleo-cart-goals__track {
    position: absolute;
    top: 4px;
    right: 0;
    left: 0;
    height: 11px;
    overflow: hidden;
    border-radius: 0;
    background: var(--cleo-progress-background);
  }

  .cleo-cart-goals__fill {
    display: block;
    width: var(--cleo-progress);
    height: 100%;
    background: var(--cleo-progress-fill);
    transition: width 350ms ease;
  }

  .cleo-cart-goals__node {
    position: absolute;
    top: 0;
    z-index: 2;
    display: grid;
    width: 15px;
    min-width: 15px;
    height: 15px;
    place-items: center;
    border: 2px solid #8e9aad;
    background: #ffffff;
    color: #8e9aad;
    transform: translateX(-50%);
  }

  .cleo-cart-goals__node::after {
    content: "";
    display: block;
    width: 5px;
    height: 5px;
    background: currentColor;
  }

  .cleo-cart-goals__node.is-unlocked {
    border-color: var(--cleo-accent);
    color: var(--cleo-accent);
  }

  .cleo-cart-goals__node--shipping {
    transform: translateX(-100%);
  }

  .cleo-cart-goals__labels {
    display: grid;
    min-height: 52px;
    grid-template-columns: minmax(118px, 1fr) 100px;
    column-gap: 13px;
    align-items: start;
    margin-top: 8px;
    padding-left: 108px;
  }

  .cleo-cart-goals__label {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 2px;
    color: #929cab;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.12;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .cleo-cart-goals__label--gift {
    grid-column: 1;
    justify-self: center;
    width: 100%;
    max-width: 150px;
  }

  .cleo-cart-goals__label--shipping {
    grid-column: 2;
    justify-self: end;
    width: 100%;
    max-width: 100px;
    align-items: flex-end;
    text-align: right;
  }

  .cleo-cart-goals__label.is-unlocked {
    color: var(--cleo-accent);
  }

  .cleo-cart-goals__label-icon {
    display: block;
    height: 16px;
    font-size: 15px;
    line-height: 16px;
  }

  .cleo-cart-goals__label-text {
    display: block;
    width: 100%;
  }

  /* ------------------------------
     CART ITEMS
  ------------------------------ */

  .cleo-cart-items {
    padding: 8px 18px 2px;
  }

  .cleo-cart-item {
    position: relative;
    display: grid;
    min-height: 126px;
    grid-template-columns: 86px minmax(0, 1fr) 78px;
    gap: 10px;
    align-items: stretch;
    padding: 14px 0 17px;
    border-bottom: 1px solid rgba(20, 25, 32, 0.08);
  }

  .cleo-cart-item:last-child {
    border-bottom: 0;
  }

  .cleo-cart-item__image {
    position: relative;
    display: block;
    width: 86px;
    height: 86px;
    overflow: hidden;
    align-self: start;
    border: 1px solid #e2dfe0;
    border-radius: 8px;
    background: #f8f2f1;
  }

  .cleo-cart-item__image img,
  .cleo-cart-item__image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cleo-cart-item__content {
    min-width: 0;
    align-self: start;
  }

  .cleo-cart-item__title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: #111111;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.17;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .cleo-cart-item__title:hover {
    color: #111111;
    text-decoration: none;
  }

  .cleo-cart-item__variant {
    margin: 4px 0 0;
    color: #6f7784;
    font-size: 11px;
    line-height: 1.25;
  }

  .cleo-cart-item__badge {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 4px;
    margin-top: 7px;
    border-radius: 2px;
    padding: 4px 7px;
    background: var(--cleo-accent-light);
    color: var(--cleo-accent);
    font-size: 11px;
    line-height: 1.1;
  }

  .cleo-cart-item__badge svg {
    display: block;
    width: 11px;
    height: 11px;
    flex: 0 0 auto;
  }

  /* Quantity selector protected from theme button CSS */

  .cleo-cart-quantity {
    display: inline-grid !important;
    width: 104px !important;
    min-width: 104px !important;
    max-width: 104px !important;
    height: 37px !important;
    min-height: 37px !important;
    max-height: 37px !important;
    grid-template-columns: 34px 34px 34px !important;
    align-items: center !important;
    overflow: hidden !important;
    margin: 8px 0 0 !important;
    border: 1px solid #d5d9df !important;
    border-radius: 4px !important;
    padding: 0 !important;
    background: #ffffff !important;
    box-shadow: none !important;
  }

  .cleo-cart-quantity__button {
    -webkit-appearance: none !important;
    appearance: none !important;
    display: grid !important;
    width: 34px !important;
    min-width: 34px !important;
    max-width: 34px !important;
    height: 35px !important;
    min-height: 35px !important;
    max-height: 35px !important;
    place-items: center !important;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #141414 !important;
    cursor: pointer;
    line-height: 1 !important;
    text-decoration: none !important;
  }

  .cleo-cart-quantity__button::before,
  .cleo-cart-quantity__button::after {
    display: none !important;
    content: none !important;
  }

  .cleo-cart-quantity__button:hover,
  .cleo-cart-quantity__button:focus-visible {
    background: #f3f4f6 !important;
    color: #111111 !important;
  }

  .cleo-cart-quantity__button:disabled {
    cursor: wait;
    opacity: 0.45;
  }

  .cleo-cart-quantity__button svg {
    display: block !important;
    width: 12px !important;
    height: 12px !important;
    pointer-events: none;
  }

  .cleo-cart-quantity__value {
    display: grid !important;
    width: 34px !important;
    min-width: 34px !important;
    max-width: 34px !important;
    height: 35px !important;
    min-height: 35px !important;
    max-height: 35px !important;
    place-items: center !important;
    margin: 0 !important;
    border: 0 !important;
    padding: 0 !important;
    background: #ffffff !important;
    color: #181818 !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    line-height: 1 !important;
    text-align: center !important;
  }

  .cleo-cart-item__tier-button {
    -webkit-appearance: none !important;
    appearance: none !important;
    display: inline-flex !important;
    min-width: 0 !important;
    min-height: 24px !important;
    max-width: 100% !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 8px 0 0 !important;
    border: 0 !important;
    border-radius: 3px !important;
    padding: 5px 8px !important;
    background: var(--cleo-accent) !important;
    box-shadow: none !important;
    color: #ffffff !important;
    cursor: pointer;
    font-size: 11px !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    text-align: center !important;
    text-decoration: none !important;
  }

  .cleo-cart-item__tier-button:hover,
  .cleo-cart-item__tier-button:focus-visible {
    filter: brightness(0.93);
  }

  .cleo-cart-item__side {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    align-items: flex-end;
    align-self: stretch;
    padding-bottom: 34px;
  }

  .cleo-cart-item__side--gift {
    padding-bottom: 0;
  }

  .cleo-cart-item__compare-price {
    color: #9ca5b4;
    font-size: 12px;
    line-height: 1.2;
    text-align: right;
    text-decoration: line-through;
  }

  .cleo-cart-item__price {
    margin-top: 3px;
    color: #101010;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
    text-align: right;
  }

  .cleo-cart-item__saving {
    display: block;
    max-width: 76px;
    margin-top: 6px;
    border-radius: 2px;
    padding: 6px 7px;
    background: var(--cleo-accent-light);
    color: var(--cleo-accent);
    font-size: 11px;
    line-height: 1.18;
    text-align: right;
  }

  /* Remove icon protected from theme CSS */

  .cleo-cart-item__remove {
    -webkit-appearance: none !important;
    appearance: none !important;
    position: absolute !important;
    right: -4px !important;
