{%- liquid
  assign source_collection = collections['bestseller']
  if source_collection == blank or source_collection.products_count == 0
    assign source_collection = collections.all
  endif
  assign slider_id = 'featured-collections-product-list-carousel-collection-1'
-%}

<section id="shopify-section-template--21732444799116__featured-collections-1" class="shopify-section shopify-section--featured-collections">
  <style>
    #shopify-section-template--21732444799116__featured-collections-1 {
      --product-list-items-per-row: 2;
      --product-list-horizontal-spacing-factor: 1.6;
      --product-list-vertical-spacing-factor: 1;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-template--21732444799116__featured-collections-1 {
        --product-list-items-per-row: 3;
      }
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-template--21732444799116__featured-collections-1 {
        --product-list-items-per-row: 4;
      }
    }
  </style>

  <div class="section-spacings custom-fc color-scheme color-scheme--scheme-da62a118-22e7-49ef-8ce6-b3d06255bd44 color-scheme--bg-f733170f8e26ef0af87b024124e087d4 ">
    <div class="container">
      <div class="section-stack">
        <div class="v-stack justify-self-start gap-4 text-center sm:gap-5">
          <h2 class="h2 c-fc-heading">Best Sellers</h2>
        </div>

        <featured-collections-carousel id="featured-collections-carousel-template--21732444799116__featured-collections-1" class="featured-collections-carousel" style="background: #ffffff;">
          <div class="featured-collections-carousel__item is-selected">
            <product-list class="floating-controls-container floating-controls-container--inside floating-controls-container--on-hover">
              <carousel-prev-button class="floating-controls-container__control" aria-controls="{{ slider_id }}">
                <button
                  type="button"
                  class="prev-next-button prev-next-button--prev circle-button hover:animate-icon-inline"
                  data-cleo-slider="#{{ slider_id }}"
                  data-direction="prev"
                >
                  <span class="sr-only">Previous</span>
                  <svg aria-hidden="true" focusable="false" fill="none" width="16" class="icon icon-arrow-left icon--direction-aware" viewBox="0 0 16 18">
                    <path d="M11 1 3 9l8 8" stroke="currentColor" stroke-linecap="square"/>
                  </svg>
                </button>
              </carousel-prev-button>

              <scroll-carousel
                id="{{ slider_id }}"
                group-cells
                allow-drag
                class="product-list product-list--carousel scroll-area c-p bleed md:unbleed"
              >
                {%- for product in source_collection.products limit: 12 -%}
                  {%- render 'cleo-dynamic-product-card',
                    product: product,
                    section_id: 'template--21732444799116__featured-collections-1'
                  -%}
                {%- endfor -%}
              </scroll-carousel>

              <carousel-next-button class="floating-controls-container__control" aria-controls="{{ slider_id }}">
                <button
                  type="button"
                  class="prev-next-button prev-next-button--next circle-button hover:animate-icon-inline"
                  data-cleo-slider="#{{ slider_id }}"
                  data-direction="next"
                >
                  <span class="sr-only">Next</span>
                  <svg aria-hidden="true" focusable="false" fill="none" width="16" class="icon icon-arrow-right icon--direction-aware" viewBox="0 0 16 18">
                    <path d="m5 17 8-8-8-8" stroke="currentColor" stroke-linecap="square"/>
                  </svg>
                </button>
              </carousel-next-button>
            </product-list>
          </div>
        </featured-collections-carousel>
      </div>
    </div>
  </div>
</section>
