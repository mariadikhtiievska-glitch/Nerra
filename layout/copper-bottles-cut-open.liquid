<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code | default: 'en' }}"
  dir="ltr"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {%- render 'theme-favicon', favicon_set: 'neera-living' -%}

    <title>{{ page_title | escape }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;600&family=Newsreader:wght@600&display=swap"
      rel="stylesheet"
    >

    {%- render 'theme-styles-variables' -%}
    {{ 'copper-bottles-cut-open.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="cls-coppercutopen-body">
    <main id="MainContent" class="cls-coppercutopen-main">
      {{ content_for_layout }}
    </main>

    {% section 'copper-bottles-cut-open-sticky-bar' %}

    <script src="{{ 'copper-bottles-cut-open.js' | asset_url }}" defer></script>
  </body>
</html>
